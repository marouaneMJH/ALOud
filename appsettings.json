{
    "ConnectionStrings": {
        "DefaultConnection": ""
    },
    "AppSettings": {
        "BaseUrl": "https://localhost:5001"
    },
    "Redis": {
        "ConnectionString": "localhost:6379",
        "InstanceName": "ALOudStore:",
        "JobQueue": {
            "DefaultRetries": 3,
            "RetryDelayMinutes": 5,
            "MaxProcessingTimeMinutes": 30,
            "DeadLetterQueue": "jobs:failed",
            "HealthCheckIntervalSeconds": 60
        }
    },
    "Jobs": {
        "OrderProcessing": {
            "Enabled": false,
            "PollingIntervalSeconds": 30,
            "BatchSize": 10,
            "QueueName": "orders:processing"
        },
        "StatusSync": {
            "Enabled": false,
            "PollingIntervalSeconds": 60,
            "BatchSize": 5,
            "QueueName": "sync:status"
        },
        "StockMonitoring": {
            "Enabled": false,
            "PollingIntervalSeconds": 300,
            "BatchSize": 20,
            "QueueName": "stock:monitoring",
            "LowStockThreshold": 10
        },
        "Cleanup": {
            "Enabled": false,
            "Schedule": "0 2 * * *",
            "QueueName": "maintenance:cleanup",
            "RetentionDays": 180
        }
    },
    "MockServices": {
        "Enabled": true,
        "Payment": {
            "PaymentSuccessRate": 0.95,
            "RefundSuccessRate": 0.98,
            "MinDelayMs": 100,
            "MaxDelayMs": 1000
        },
        "Shipping": {
            "ShipmentSuccessRate": 0.95,
            "RatesSuccessRate": 0.98,
            "TrackingSuccessRate": 0.99,
            "MinDelayMs": 200,
            "MaxDelayMs": 1500
        }
    },
    "Images": {
        "FallbackUrl": "https://images.unsplash.com/photo-1585386959984-a4155224a1ad?w=500"
    },

    "Smtp": {
        "Host": "smtp.gmail.com",
        "Port": 587
    },
    "Logging": {
        "LogLevel": {
            "Microsoft": "Warning",
            "Microsoft.AspNetCore": "Warning",

            "Microsoft.AspNetCore.Mvc": "Warning",
            "Microsoft.AspNetCore.Routing": "Warning",
            "Microsoft.AspNetCore.Hosting": "Warning"
        }
    }
}
