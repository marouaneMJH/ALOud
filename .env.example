# ALOud Environment Variables Template
# Copy this file to .env and fill in the values

# LLM Configuration
LLM_PROVIDER=groq
GEMINI_MODEL=gemini-1.5-flash
# Get your API key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=YOUR_GEMINI_API_KEY_HERE

# GROQ_MODEL=llama-3.1-8b-instant
# GROQ_API_KEY=

# GROK_MODEL=grok-beta
# GROK_API_KEY=

# SMTP Configuration
SMTP_USER=YOUR_SMTP_USER_HERE
SMTP_PASSWORD=YOUR_SMTP_PASSWORD_HERE
SMTP_FROM=YOUR_SMTP_EMAIL_HERE

# Infrastructure Configuration
# Standard dev database connection string (SQL Server in Docker)
DB_CONNECTION_STRING=Server=localhost,1444;Database=VeloStoreDB;User Id=SA;Password=YOUR_STRONG_PASSWORD;TrustServerCertificate=True;MultipleActiveResultSets=true
# Standard dev redis connection string
REDIS_CONNECTION_STRING=localhost:6379
