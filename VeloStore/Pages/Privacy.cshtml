@page
@model PrivacyModel
@{
    ViewData["Title"] = "Politique de Confidentialité";
}

<div class="container py-5">
    <h1 style="font-family: 'Playfair Display', serif; color: var(--aloud-primary); font-weight: 700; text-align: center; margin-bottom: 2rem;">@ViewData["Title"]</h1>
    
    <div class="row justify-content-center">
        <div class="col-lg-8">
            <div class="p-4 rounded shadow-sm" style="background: linear-gradient(135deg, #fff 0%, #F5F5DC 100%); border: 1px solid var(--aloud-accent);">
                <h3 style="color: var(--aloud-primary); font-weight: 600; margin-bottom: 1.5rem;">Notre Engagement pour l'Authenticité</h3>
                
                <p style="color: var(--aloud-dark); line-height: 1.7; font-size: 1.05rem;">Chez <strong>ALOud</strong>, nous valorisons votre confiance et respectons votre vie privée. Notre approche authentique s'étend à la protection de vos données personnelles.</p>
                
                <h4 style="color: var(--aloud-secondary); font-weight: 600; margin-top: 2rem; margin-bottom: 1rem;">Protection des Données</h4>
                <p style="color: var(--aloud-dark); line-height: 1.7;">Nous nous engageons à protéger vos informations personnelles avec le même soin que nous apportons à la sélection de nos produits authentiques.</p>
                
                <div class="mt-4 p-3 rounded" style="background-color: var(--aloud-light); border-left: 4px solid var(--aloud-accent);">
                    <p style="color: var(--aloud-dark); margin: 0; font-style: italic;">"L'authenticité et la transparence sont au cœur de nos valeurs."</p>
                </div>
            </div>
        </div>
    </div>
</div>
