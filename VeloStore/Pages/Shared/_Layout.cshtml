<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - ALOud</title>
    
    <!-- Bootstrap CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
    
    <!-- Custom CSS -->
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <!-- Navigation -->
    <nav class="navbar">
        <div class="container">
            <div class="d-flex justify-content-between align-items-center w-100">
                <!-- Brand -->
                <a class="navbar-brand" asp-page="/Index">ALOud</a>
                
                <!-- Navigation Links -->
                <div class="navbar-nav">
                    <a class="nav-link" asp-page="/Index">Collection</a>
                    <a class="nav-link" asp-page="/Cart/Index">
                        <span class="me-1">Panier</span>
                        <span class="position-relative">
                            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                                <path d="M3 3H5L5.4 5M7 13H17L21 5H5.4M7 13L5.4 5M7 13L4.7 15.3C4.3 15.7 4.6 16.4 5.1 16.4H17M17 13V17A2 2 0 0 1 15 19H9A2 2 0 0 1 7 17V13M17 13H7" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                            </svg>
                        </span>
                    </a>
                </div>
            </div>
        </div>
    </nav>

    <!-- Main Content -->
    <main>
        @RenderBody()
    </main>

    <!-- Footer -->
    <footer class="py-5 mt-6" style="background-color: var(--color-primary); color: var(--color-white);">
        <div class="container">
            <div class="row">
                <div class="col-md-6">
                    <h3 class="h5 mb-3" style="color: var(--color-white);">ALOud</h3>
                    <p class="small" style="color: rgba(255,255,255,0.8);">L'art de la parfumerie authentique</p>
                </div>
                <div class="col-md-6">
                    <div class="row">
                        <div class="col-6">
                            <h4 class="h6 mb-3" style="color: var(--color-white);">Liens</h4>
                            <ul class="list-unstyled small">
                                <li><a href="#" class="text-decoration-none" style="color: rgba(255,255,255,0.8);">À propos</a></li>
                                <li><a href="#" class="text-decoration-none" style="color: rgba(255,255,255,0.8);">Contact</a></li>
                                <li><a asp-page="/Privacy" class="text-decoration-none" style="color: rgba(255,255,255,0.8);">Confidentialité</a></li>
                            </ul>
                        </div>
                    </div>
                </div>
            </div>
            <hr class="my-4" style="border-color: rgba(255,255,255,0.2);">
            <div class="text-center">
                <p class="small mb-0" style="color: rgba(255,255,255,0.6);">&copy; @DateTime.Now.Year ALOud. Tous droits réservés.</p>
            </div>
        </div>
    </footer>

    <!-- Bootstrap JS -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
