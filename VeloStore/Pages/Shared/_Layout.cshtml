<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="utf-8" />
    <title>@ViewData["Title"] - ALOud</title>

    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <!-- Bootstrap -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@400;700&family=Lora:wght@400;500;600&display=swap" rel="stylesheet">
    <style>
        :root {
            --aloud-primary: #8B4513; /* Saddle Brown - Authenticity */
            --aloud-secondary: #D2691E; /* Chocolate - Warmth */
            --aloud-accent: #DAA520; /* Goldenrod - Classic luxury */
            --aloud-dark: #654321; /* Dark Brown - Heritage */
            --aloud-light: #F5F5DC; /* Beige - Classic elegance */
            --aloud-green: #556B2F; /* Dark Olive Green - Natural authenticity */
        }
        
        body {
            background-color: var(--aloud-light);
            font-family: 'Lora', serif;
            color: var(--aloud-dark);
        }

        .navbar-brand {
            font-family: 'Playfair Display', serif;
            font-weight: 700;
            font-size: 1.8rem;
            letter-spacing: 1px;
        }

        .product-card {
            border-radius: 12px;
            transition: all 0.3s ease;
            border: 2px solid var(--aloud-accent);
            background: #fff;
        }

            .product-card:hover {
                transform: translateY(-6px);
                box-shadow: 0 15px 35px rgba(139, 69, 19, 0.2);
                border-color: var(--aloud-primary);
            }

        .product-title {
            min-height: 40px;
            color: var(--aloud-dark);
            font-weight: 600;
        }

        .btn-primary {
            background-color: var(--aloud-primary);
            border-color: var(--aloud-primary);
            font-weight: 500;
        }
        
        .btn-primary:hover {
            background-color: var(--aloud-dark);
            border-color: var(--aloud-dark);
        }
        
        .text-warning {
            color: var(--aloud-accent) !important;
        }
        
        .bg-dark {
            background-color: var(--aloud-dark) !important;
        }
        
        .navbar-dark .navbar-brand {
            color: var(--aloud-accent) !important;
        }
        
        .navbar-dark .navbar-nav .nav-link {
            color: var(--aloud-light) !important;
        }
        
        .navbar-dark .navbar-nav .nav-link:hover {
            color: var(--aloud-accent) !important;
        }
    </style>



</head>
<body>

    <!-- NAVBAR -->
    <nav class="navbar navbar-expand-lg navbar-dark bg-dark">
        <div class="container-fluid">
            <a class="navbar-brand fw-bold" asp-page="/Index">ALOud</a>

            <button class="navbar-toggler" type="button" data-bs-toggle="collapse"
                    data-bs-target="#navbarNav">
                <span class="navbar-toggler-icon"></span>
            </button>

            <div class="collapse navbar-collapse" id="navbarNav">
                <ul class="navbar-nav me-auto">
                    <li class="nav-item">
                        <a class="nav-link" asp-page="/Index">Accueil</a>
                    </li>
                </ul>

                <ul class="navbar-nav">
                    <li class="nav-item">
                        <a class="nav-link" asp-page="/Cart/Index">
                            🛒 Panier
                        </a>
                    </li>
                </ul>
            </div>
        </div>
    </nav>

    <!-- CONTENU -->
    <div class="container mt-4">
        @RenderBody()
    </div>

    <!-- Bootstrap JS -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>

</body>
</html>
