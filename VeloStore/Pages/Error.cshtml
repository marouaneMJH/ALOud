@page
@model ErrorModel
@{
    ViewData["Title"] = "Erreur";
}

<div class="container py-5 text-center">
    <div class="row justify-content-center">
        <div class="col-lg-6">
            <div class="p-5 rounded shadow-sm" style="background: linear-gradient(135deg, #fff 0%, #F5F5DC 100%); border: 2px solid var(--aloud-accent);">
                <i class="fas fa-exclamation-triangle" style="font-size: 3rem; color: var(--aloud-secondary); margin-bottom: 1.5rem;"></i>
                
                <h1 style="font-family: 'Playfair Display', serif; color: var(--aloud-primary); font-weight: 700; margin-bottom: 1rem;">Oops !</h1>
                <h2 style="color: var(--aloud-dark); font-weight: 500; font-size: 1.3rem; margin-bottom: 1.5rem;">Une erreur s'est produite lors du traitement de votre demande.</h2>
                
                @if (Model.ShowRequestId)
                {
                    <div class="p-3 rounded mt-3" style="background-color: var(--aloud-light); border: 1px solid var(--aloud-secondary);">
                        <p style="color: var(--aloud-dark); margin: 0;">
                            <strong>ID de la requête :</strong> <code style="color: var(--aloud-secondary);">@Model.RequestId</code>
                        </p>
                    </div>
                }
                
                <div class="mt-4">
                    <a href="/" class="btn btn-primary" style="background-color: var(--aloud-accent); border-color: var(--aloud-accent); color: var(--aloud-dark); font-weight: 600; padding: 12px 30px;">
                        Retour à l'accueil ALOud
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>
<p>
    <strong>The Development environment shouldn't be enabled for deployed applications.</strong>
    It can result in displaying sensitive information from exceptions to end users.
    For local debugging, enable the <strong>Development</strong> environment by setting the <strong>ASPNETCORE_ENVIRONMENT</strong> environment variable to <strong>Development</strong>
    and restarting the app.
</p>
