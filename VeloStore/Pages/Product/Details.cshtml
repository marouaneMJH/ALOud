@page "{id:int}"
@model VeloStore.Pages.Product.DetailsModel
@{
    ViewData["Title"] = Model.Product.Name;
}

<div class="row p-4 rounded shadow-sm" style="background: linear-gradient(135deg, #fff 0%, #F5F5DC 100%); border: 2px solid var(--aloud-accent);">

    <!-- IMAGE -->
    <div class="col-md-5 text-center">
        <div style="background: #fff; border-radius: 12px; padding: 20px; border: 1px solid var(--aloud-secondary);">
            <img src="@Model.Product.ImageUrl"
                 class="img-fluid"
                 style="max-height:420px; object-fit:contain;" />
        </div>
    </div>

    <!-- INFOS -->
    <div class="col-md-7">
        <h2 style="font-family: 'Playfair Display', serif; color: var(--aloud-primary); font-weight: 700;">@Model.Product.Name</h2>

        <h4 class="fw-bold mt-3" style="color: var(--aloud-secondary); font-size: 1.5rem;">
            @Model.Product.Price MAD
        </h4>

        <p class="mt-3" style="color: var(--aloud-dark); line-height: 1.6; font-size: 1.05rem;">
            @Model.Product.Description
        </p>

        @if (Model.Product.InStock)
        {
            <span class="badge mb-3" style="background-color: var(--aloud-green); color: white; font-size: 0.9rem; padding: 8px 12px;">En stock</span>
        }
        else
        {
            <span class="badge mb-3" style="background-color: var(--aloud-secondary); color: white; font-size: 0.9rem; padding: 8px 12px;">Rupture de stock</span>
        }

        <form method="post" asp-page-handler="AddToCart">
            <input type="hidden" name="productId" value="@Model.Product.Id" />
            <button class="btn btn-lg mt-3"
                    style="background-color: var(--aloud-accent); border-color: var(--aloud-accent); color: var(--aloud-dark); font-weight: 600; padding: 12px 30px;"
                    @(Model.Product.InStock ? "" : "disabled")>
                Ajouter au panier
            </button>
        </form>
    </div>
</div>
