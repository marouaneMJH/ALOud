@page
@model VeloStore.Pages.Cart.IndexModel

<h2 class="mb-4" style="font-family: 'Playfair Display', serif; color: var(--aloud-primary); font-weight: 700;"> 🛍️ Votre panier ALOud</h2>

@if (!Model.Items.Any())
{
    <div class="alert" style="background-color: var(--aloud-light); border-color: var(--aloud-accent); color: var(--aloud-dark); text-align: center; padding: 30px;">
        <i class="fas fa-shopping-cart" style="font-size: 2rem; color: var(--aloud-secondary); margin-bottom: 15px;"></i>
        <p style="font-size: 1.1rem; margin: 0;">Votre panier ALOud est vide. Découvrez notre collection authentique !</p>
    </div>
}
else
{
    <table class="table align-middle" style="background: #fff; border-radius: 8px; overflow: hidden; box-shadow: 0 4px 6px rgba(139, 69, 19, 0.1);">
        <thead style="background-color: var(--aloud-primary); color: white;">
            <tr>
                <th style="font-weight: 600;">Produit</th>
                <th style="font-weight: 600;">Prix</th>
                <th style="font-weight: 600;">Qté</th>
                <th style="font-weight: 600;">Total</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model.Items)
            {
                <tr>
                    <td>
                        <img src="@item.ImageUrl" width="60" class="me-2" />
                        @item.ProductName
                    </td>
                    <td>@item.Price MAD</td>
                    <td>
                        <form method="post">
                            <input type="hidden" name="productId" value="@item.ProductId" />
                            <button asp-page-handler="Decrease" class="btn btn-outline-secondary btn-sm">−</button>
                            <span class="mx-2 fw-bold">@item.Quantity</span>
                            <button asp-page-handler="Increase" class="btn btn-outline-secondary btn-sm">+</button>
                        </form>
                    </td>
                    <td class="fw-bold" style="color: var(--aloud-secondary); font-size: 1.05rem;">@item.Total MAD</td>
                </tr>
            }
        </tbody>
    </table>

    <div class="text-end mt-4 p-3 rounded" style="background-color: var(--aloud-light); border: 1px solid var(--aloud-accent);">
        <h4 style="font-family: 'Playfair Display', serif; color: var(--aloud-primary);">
            Total : <span style="color: var(--aloud-secondary); font-weight: 700;">
                @Model.Items.Sum(i => i.Total) MAD
            </span>
        </h4>
    </div>
}
