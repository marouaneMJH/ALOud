@page
@model VeloStore.Pages.IndexModel
@{
    ViewData["Title"] = "Accueil";
}

<div class="text-center mb-5">
    <h1 class="display-4 mb-3" style="font-family: 'Playfair Display', serif; color: var(--aloud-primary); font-weight: 700;">
        Bienvenue chez <span style="color: var(--aloud-accent);">ALOud</span>
    </h1>
    <p class="lead" style="color: var(--aloud-dark); font-style: italic;">L'authenticité, la grandeur et le classique réunis</p>
</div>

<!-- 🔍 RECHERCHE & FILTRES -->
<form method="get" class="row g-2 mb-4 p-3 rounded shadow-sm" style="background: linear-gradient(135deg, #fff 0%, #F5F5DC 100%); border: 1px solid var(--aloud-accent);">

    <!-- Recherche -->
    <div class="col-md-4">
        <input type="text"
               name="query"
               value="@Model.Search.Query"
               class="form-control"
               placeholder="Rechercher un produit..."
               style="border-color: var(--aloud-secondary);" />
    </div>

    <!-- Prix min -->
    <div class="col-md-2">
        <input type="number"
               name="minPrice"
               value="@Model.Search.MinPrice"
               class="form-control"
               placeholder="Prix min"
               style="border-color: var(--aloud-secondary);" />
    </div>

    <!-- Prix max -->
    <div class="col-md-2">
        <input type="number"
               name="maxPrice"
               value="@Model.Search.MaxPrice"
               class="form-control"
               placeholder="Prix max"
               style="border-color: var(--aloud-secondary);" />
    </div>

    <!-- Tri -->
    <div class="col-md-2">
        <select name="sort" class="form-select" style="border-color: var(--aloud-secondary);">
            <option value="">Trier par</option>
            <option value="price_asc"
                    selected="@(Model.Search.Sort == "price_asc")">
                Prix ↑
            </option>
            <option value="price_desc"
                    selected="@(Model.Search.Sort == "price_desc")">
                Prix ↓
            </option>
        </select>
    </div>

    <!-- Bouton -->
    <div class="col-md-2">
        <button class="btn btn-primary w-100" style="font-weight: 600;">
            Filtrer
        </button>
    </div>
</form>

<!-- 🧾 PRODUITS -->
<div class="row">
    @foreach (var product in Model.Products)
    {
        <div class="col-md-3 mb-4">
            <div class="card h-100 shadow-sm product-card">

                <!-- Image + lien détails -->
                <a asp-page="/Product/Details" asp-route-id="@product.Id">
                    <img src="@product.ImageUrl"
                         class="card-img-top p-3"
                         style="height:200px; object-fit:contain;" />
                </a>

                <div class="card-body d-flex flex-column">

                    <!-- Nom -->
                    <a asp-page="/Product/Details"
                       asp-route-id="@product.Id"
                       class="text-decoration-none text-dark">
                        <h6 class="card-title product-title">
                            @product.Name
                        </h6>
                    </a>

                    <!-- Prix -->
                    <p class="fw-bold mb-2" style="color: var(--aloud-secondary); font-size: 1.1rem;">
                        @product.Price MAD
                    </p>

                    <!-- Panier -->
                    <form method="post"
                          asp-page-handler="AddToCart"
                          class="mt-auto">
                        <input type="hidden"
                               name="productId"
                               value="@product.Id" />
                        <button type="submit"
                                class="btn btn-primary w-100"
                                style="background-color: var(--aloud-accent); border-color: var(--aloud-accent); color: var(--aloud-dark); font-weight: 600;">
                            Ajouter au panier
                        </button>
                    </form>
                </div>
            </div>
        </div>
    }
</div>

@if (!Model.Products.Any())
{
    <div class="alert mt-4" style="background-color: var(--aloud-light); border-color: var(--aloud-accent); color: var(--aloud-dark);">
        <i class="fas fa-search" style="color: var(--aloud-secondary);"></i> Aucun produit trouvé dans notre collection authentique.
    </div>
}
