@page "{id:int}"
@model Pages.Product.DetailsModel
@inject Microsoft.Extensions.Configuration.IConfiguration Configuration
@{
    ViewData["Title"] = Model.Product.Name;
    var fallback = Configuration["Images:FallbackUrl"];
}

<section>
    <div class="container">
        <!-- Breadcrumb -->
        <nav class="py-3 mb-4">
            <a asp-page="/Index" class="text-decoration-none" style="color: var(--color-text-secondary); font-size: 0.9rem;">
                ← Retour à la collection
            </a>
        </nav>

        <!-- Product Detail Grid -->
        <div class="product-detail-grid">
            <!-- Product Image -->
            <div class="product-detail-image">
                 <img src="@Model.Product.ImageUrl" 
                     alt="@Model.Product.Name"
                     style="width: 100%; height: 100%; object-fit: cover;" onerror="this.onerror=null;this.src='@fallback';" />
            </div>

            <!-- Product Information -->
            <div class="product-detail-info">
                <!-- Title -->
                <h1 class="product-title">@Model.Product.Name</h1>

                <!-- Price -->
                <div class="product-price-large">@Model.Product.Price,00 MAD</div>

                <!-- Description -->
                @if (!string.IsNullOrWhiteSpace(Model.Product.Description))
                {
                    <div class="product-description">
                        @Model.Product.Description
                    </div>
                }

                <!-- Stock Status -->
                <div class="mb-4">
                    @if (Model.Product.InStock)
                    {
                        <span class="badge py-2 px-3" 
                              style="background-color: var(--color-accent); color: var(--color-primary); font-size: 0.875rem; text-transform: uppercase; letter-spacing: 0.05em;">
                            En stock
                        </span>
                    }
                    else
                    {
                        <span class="badge py-2 px-3" 
                              style="background-color: var(--color-text-secondary); color: var(--color-white); font-size: 0.875rem; text-transform: uppercase; letter-spacing: 0.05em;">
                            Rupture de stock
                        </span>
                    }
                </div>

                <!-- Add to Cart Form -->
                <form method="post" asp-page-handler="AddToCart">
                    <input type="hidden" name="productId" value="@Model.Product.Id" />
                    <button type="submit" 
                            class="btn btn-primary btn-lg py-3 px-5"
                            style="font-size: 1rem; min-width: 200px;"
                            @(Model.Product.InStock ? "" : "disabled")>
                        @if (Model.Product.InStock)
                        {
                            <text>Ajouter au panier</text>
                        }
                        else
                        {
                            <text>Indisponible</text>
                        }
                    </button>
                </form>

                <!-- Additional Product Info -->
                <div class="mt-5 pt-4" style="border-top: 1px solid var(--color-border);">
                    <h3 class="h6 mb-3" style="text-transform: uppercase; letter-spacing: 0.1em; color: var(--color-text-secondary);">
                        Informations
                    </h3>
                    <div class="row g-3">
                        <div class="col-6">
                            <div class="small" style="color: var(--color-text-secondary);">Référence</div>
                            <div style="font-weight: 500;">#@Model.Product.Id.ToString("D6")</div>
                        </div>
                        <div class="col-6">
                            <div class="small" style="color: var(--color-text-secondary);">Stock</div>
                            <div style="font-weight: 500;">@(Model.Product.InStock ? "En stock" : "Rupture")</div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        </div>
</section>
