@page
@model Pages.IndexModel
@inject Microsoft.Extensions.Configuration.IConfiguration Configuration
@{
    ViewData["Title"] = "Collection";
    var fallback = Configuration["Images:FallbackUrl"] ?? "/images/placeholder.jpg";
}

@if (TempData["Success"] != null)
{
    <div class="toast-notification success" id="toast-success">
        <span>✓ @TempData["Success"]</span>
        <button onclick="this.parentElement.remove()" style="background: none; border: none; color: inherit; cursor: pointer; margin-left: 1rem;">✕</button>
    </div>
}
@if (TempData["Error"] != null)
{
    <div class="toast-notification error" id="toast-error">
        <span>✗ @TempData["Error"]</span>
        <button onclick="this.parentElement.remove()" style="background: none; border: none; color: inherit; cursor: pointer; margin-left: 1rem;">✕</button>
    </div>
}

<!-- Search Section -->
<section style="margin-bottom: var(--spacing-lg); margin-top: var(--spacing-2xl);">
    <div class="container">
        <form method="get" class="premium-search-form">
            <div class="search-wrapper">
                <svg class="search-icon" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <circle cx="11" cy="11" r="8"></circle>
                    <path d="m21 21-4.35-4.35"></path>
                </svg>
                <input type="text"
                       id="query"
                       name="query"
                       value="@Model.Search.Query"
                       class="search-input"
                       placeholder="Rechercher un parfum ou une marque..."
                       onchange="this.form.submit()" />
            </div>
        </form>
    </div>
</section>

<!-- Filter Section -->
<section class="filter-section" style="margin-bottom: var(--spacing-3xl);">
    <div class="container">
        <div class="filter-row">
            <!-- Brand Filter -->
            <div class="filter-group">
                <label class="filter-label">Marque</label>
                <div class="filter-pills">
                    <a class="filter-pill @(Model.SelectedBrandId == null ? "active" : "")" 
                       asp-page="/Index"
                       asp-route-query="@Model.Search.Query"
                       asp-route-familyId="@Model.SelectedFamilyId"
                       asp-route-gender="@Model.SelectedGender">
                        Toutes
                    </a>
                    @foreach (var brand in Model.Brands.Take(10))
                    {
                        <a class="filter-pill @(Model.SelectedBrandId == brand.Id ? "active" : "")" 
                           asp-page="/Index" 
                           asp-route-brandId="@brand.Id"
                           asp-route-query="@Model.Search.Query"
                           asp-route-familyId="@Model.SelectedFamilyId"
                           asp-route-gender="@Model.SelectedGender">
                            @brand.Name
                        </a>
                    }
                </div>
            </div>

            <!-- Family Filter -->
            <div class="filter-group">
                <label class="filter-label">Famille Olfactive</label>
                <div class="filter-pills">
                    <a class="filter-pill @(Model.SelectedFamilyId == null ? "active" : "")" 
                       asp-page="/Index"
                       asp-route-query="@Model.Search.Query"
                       asp-route-brandId="@Model.SelectedBrandId"
                       asp-route-gender="@Model.SelectedGender">
                        Toutes
                    </a>
                    @foreach (var family in Model.Families.Take(10))
                    {
                        <a class="filter-pill @(Model.SelectedFamilyId == family.Id ? "active" : "")" 
                           asp-page="/Index" 
                           asp-route-familyId="@family.Id"
                           asp-route-query="@Model.Search.Query"
                           asp-route-brandId="@Model.SelectedBrandId"
                           asp-route-gender="@Model.SelectedGender">
                            @family.Name
                        </a>
                    }
                </div>
            </div>

            <!-- Gender Filter -->
            <div class="filter-group">
                <label class="filter-label">Genre</label>
                <div class="filter-pills">
                    <a class="filter-pill @(string.IsNullOrEmpty(Model.SelectedGender) ? "active" : "")" 
                       asp-page="/Index"
                       asp-route-query="@Model.Search.Query"
                       asp-route-brandId="@Model.SelectedBrandId"
                       asp-route-familyId="@Model.SelectedFamilyId">
                        Tous
                    </a>
                    <a class="filter-pill @(Model.SelectedGender == "Homme" ? "active" : "")" 
                       asp-page="/Index" 
                       asp-route-gender="Male"
                       asp-route-query="@Model.Search.Query"
                       asp-route-brandId="@Model.SelectedBrandId"
                       asp-route-familyId="@Model.SelectedFamilyId">
                        Homme
                    </a>
                    <a class="filter-pill @(Model.SelectedGender == "Femme" ? "active" : "")" 
                       asp-page="/Index" 
                       asp-route-gender="Female"
                       asp-route-query="@Model.Search.Query"
                       asp-route-brandId="@Model.SelectedBrandId"
                       asp-route-familyId="@Model.SelectedFamilyId">
                        Femme
                    </a>
                    <a class="filter-pill @(Model.SelectedGender == "Unisexe" ? "active" : "")" 
                       asp-page="/Index" 
                       asp-route-gender="Unisex"
                       asp-route-query="@Model.Search.Query"
                       asp-route-brandId="@Model.SelectedBrandId"
                       asp-route-familyId="@Model.SelectedFamilyId">
                        Unisexe
                    </a>
                </div>
            </div>
        </div>
    </div>
</section>

<style>
    /* Toast Notifications */
    .toast-notification {
        position: fixed;
        top: 100px;
        right: 20px;
        padding: var(--spacing-md) var(--spacing-lg);
        border-radius: 4px;
        font-size: 0.9rem;
        display: flex;
        align-items: center;
        z-index: 1000;
        animation: slideIn 0.3s ease;
        box-shadow: var(--shadow-elevated);
    }

    .toast-notification.success {
        background: #e8f5e9;
        color: #2e7d32;
        border: 1px solid #a5d6a7;
    }

    .toast-notification.error {
        background: #ffebee;
        color: #c62828;
        border: 1px solid #ef9a9a;
    }

    @@keyframes slideIn {
        from {
            transform: translateX(100%);
            opacity: 0;
        }
        to {
            transform: translateX(0);
            opacity: 1;
        }
    }

    .hero-section {
        text-align: center;
        padding: var(--spacing-3xl) 0 var(--spacing-xl);
    }

    .hero-title {
        font-family: var(--font-heading);
        font-size: 2.5rem;
        font-weight: 400;
        color: var(--color-primary);
        margin-bottom: var(--spacing-sm);
    }

    .hero-subtitle {
        font-size: 1.1rem;
        color: var(--color-text-secondary);
        font-weight: 300;
    }

    .premium-search-form {
        max-width: 900px;
        margin: 0 auto;
    }

    .search-wrapper {
        position: relative;
        display: flex;
        align-items: center;
        background: transparent;
        border: none;
        border-bottom: 2px solid var(--color-border);
        transition: all var(--transition-normal);
    }

    .search-wrapper:focus-within {
        border-bottom-color: var(--color-accent);
    }

    .search-icon {
        position: absolute;
        left: 0;
        color: var(--color-text-secondary);
        pointer-events: none;
    }

    .search-input {
        flex: 1;
        padding: var(--spacing-md) 0 var(--spacing-md) 2.5rem;
        border: none;
        font-family: var(--font-body);
        font-size: 1.1rem;
        color: var(--color-primary);
        background: transparent;
        outline: none;
    }

    .search-input::placeholder {
        color: var(--color-text-secondary);
        opacity: 0.5;
        font-weight: 300;
    }

    .filter-section {
        background: var(--color-background);
        border-top: 1px solid var(--color-border);
        border-bottom: 1px solid var(--color-border);
        padding: var(--spacing-lg) 0;
    }

    .filter-row {
        display: flex;
        flex-direction: column;
        gap: var(--spacing-lg);
    }

    .filter-group {
        display: flex;
        flex-direction: column;
        gap: var(--spacing-sm);
    }

    .filter-label {
        font-size: 0.75rem;
        text-transform: uppercase;
        letter-spacing: 0.1em;
        color: var(--color-text-secondary);
        font-weight: 600;
    }

    .filter-pills {
        display: flex;
        gap: var(--spacing-sm);
        flex-wrap: wrap;
    }

    .filter-pill {
        padding: var(--spacing-xs) var(--spacing-md);
        background: var(--color-white);
        color: var(--color-primary);
        border: 1px solid var(--color-border);
        font-family: var(--font-body);
        font-size: 0.85rem;
        font-weight: 500;
        text-decoration: none;
        transition: all var(--transition-normal);
    }

    .filter-pill:hover {
        border-color: var(--color-accent);
        color: var(--color-accent);
    }

    .filter-pill.active {
        background: var(--color-primary);
        color: var(--color-white);
        border-color: var(--color-primary);
    }

    /* Perfume Grid */
    .perfume-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
        gap: var(--spacing-xl);
    }

    .perfume-card {
        background: var(--color-white);
        border: 1px solid var(--color-border);
        transition: all var(--transition-normal);
        overflow: hidden;
    }

    .perfume-card:hover {
        border-color: var(--color-accent);
        box-shadow: var(--shadow-elevated);
        transform: translateY(-4px);
    }

    .perfume-image-container {
        position: relative;
        aspect-ratio: 1;
        overflow: hidden;
        background: var(--color-background);
    }

    .perfume-image {
        width: 100%;
        height: 100%;
        object-fit: cover;
        transition: transform var(--transition-slow);
    }

    .perfume-card:hover .perfume-image {
        transform: scale(1.05);
    }

    .perfume-badge {
        position: absolute;
        top: var(--spacing-md);
        left: var(--spacing-md);
        background: var(--color-primary);
        color: var(--color-white);
        padding: var(--spacing-xs) var(--spacing-sm);
        font-size: 0.7rem;
        text-transform: uppercase;
        letter-spacing: 0.1em;
    }

    .perfume-info {
        padding: var(--spacing-lg);
    }

    .perfume-brand {
        font-size: 0.75rem;
        text-transform: uppercase;
        letter-spacing: 0.1em;
        color: var(--color-accent);
        margin-bottom: var(--spacing-xs);
        font-weight: 600;
    }

    .perfume-name {
        font-family: var(--font-heading);
        font-size: 1.25rem;
        color: var(--color-primary);
        margin-bottom: var(--spacing-sm);
        font-weight: 400;
        line-height: 1.3;
    }

    .perfume-meta {
        display: flex;
        gap: var(--spacing-md);
        margin-bottom: var(--spacing-md);
        font-size: 0.8rem;
        color: var(--color-text-secondary);
    }

    .perfume-meta-item {
        display: flex;
        align-items: center;
        gap: 4px;
    }

    .perfume-price {
        font-size: 1.1rem;
        font-weight: 600;
        color: var(--color-primary);
    }

    .perfume-families {
        font-size: 0.8rem;
        color: var(--color-accent);
        margin-bottom: var(--spacing-xs);
        font-weight: 500;
    }

    .perfume-description {
        font-size: 0.85rem;
        color: var(--color-text-secondary);
        line-height: 1.5;
        margin-bottom: var(--spacing-md);
    }

    .perfume-footer {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding-top: var(--spacing-sm);
        border-top: 1px solid var(--color-border);
        margin-bottom: var(--spacing-sm);
    }

    .perfume-stock {
        font-size: 0.75rem;
        font-weight: 500;
    }

    .perfume-stock.in-stock {
        color: #2e7d32;
    }

    .perfume-stock.out-of-stock {
        color: #c62828;
    }

    .view-details-btn {
        display: block;
        width: 100%;
        padding: var(--spacing-sm) var(--spacing-md);
        background: transparent;
        color: var(--color-primary);
        border: 1px solid var(--color-primary);
        font-size: 0.85rem;
        text-transform: uppercase;
        letter-spacing: 0.1em;
        text-align: center;
        text-decoration: none;
        margin-top: var(--spacing-md);
        transition: all var(--transition-normal);
    }

    .view-details-btn:hover {
        background: var(--color-primary);
        color: var(--color-white);
    }

    .add-to-cart-btn {
        display: block;
        width: 100%;
        padding: var(--spacing-sm) var(--spacing-md);
        background: var(--color-accent);
        color: var(--color-primary);
        border: 1px solid var(--color-accent);
        font-size: 0.85rem;
        font-weight: 600;
        text-transform: uppercase;
        letter-spacing: 0.1em;
        text-align: center;
        cursor: pointer;
        margin-top: var(--spacing-sm);
        transition: all var(--transition-normal);
    }

    .add-to-cart-btn:hover {
        background: var(--color-primary);
        color: var(--color-white);
        border-color: var(--color-primary);
    }

    .add-to-cart-btn:disabled {
        background: var(--color-border);
        border-color: var(--color-border);
        color: var(--color-text-secondary);
        cursor: not-allowed;
    }

    /* Pagination */
    .pagination-container {
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: var(--spacing-md);
        padding: var(--spacing-3xl) 0;
    }

    .pagination-info {
        font-size: 0.9rem;
        color: var(--color-text-secondary);
    }

    .pagination-nav {
        display: flex;
        gap: var(--spacing-sm);
    }

    .pagination-link {
        padding: var(--spacing-sm) var(--spacing-md);
        background: var(--color-white);
        color: var(--color-primary);
        border: 1px solid var(--color-border);
        text-decoration: none;
        font-size: 0.9rem;
        transition: all var(--transition-normal);
    }

    .pagination-link:hover {
        border-color: var(--color-accent);
    }

    .pagination-link.active {
        background: var(--color-primary);
        color: var(--color-white);
        border-color: var(--color-primary);
    }

    /* Empty state */
    .empty-state {
        text-align: center;
        padding: var(--spacing-3xl) 0;
    }

    .empty-state-icon {
        font-size: 4rem;
        color: var(--color-border);
        margin-bottom: var(--spacing-lg);
    }

    @@media (max-width: 768px) {
        .hero-title {
            font-size: 2rem;
        }

        .search-input {
            font-size: 1rem;
            padding: var(--spacing-sm) 0 var(--spacing-sm) 2.5rem;
        }

        .perfume-grid {
            grid-template-columns: repeat(auto-fill, minmax(240px, 1fr));
            gap: var(--spacing-md);
        }
    }
</style>

<!-- Perfumes Grid -->
<section>
    <div class="container">
        @if (Model.Perfumes.Any())
        {
            <div class="perfume-grid">
                @foreach (var perfume in Model.Perfumes)
                {
                    <article class="perfume-card">
                        <!-- Perfume Image -->
                        <a asp-page="/Perfume/Details" asp-route-id="@perfume.Id" class="text-decoration-none">
                            <div class="perfume-image-container">
                                @if (!string.IsNullOrEmpty(perfume.GenderProfile))
                                {
                                    <span class="perfume-badge">@perfume.GenderProfile</span>
                                }
                                <img src="@(perfume.ImageUrl ?? fallback)" 
                                     alt="@perfume.Name"
                                     class="perfume-image" 
                                     onerror="this.onerror=null;this.src='@fallback';" />
                            </div>
                        </a>

                        <!-- Perfume Info -->
                        <div class="perfume-info">
                            <div class="perfume-brand">@perfume.BrandName</div>
                            <a asp-page="/Perfume/Details" asp-route-id="@perfume.Id" class="text-decoration-none">
                                <h3 class="perfume-name">@perfume.Name</h3>
                            </a>
                            
                            @if (perfume.Families.Any())
                            {
                                <div class="perfume-families">
                                    @string.Join(" • ", perfume.Families.Take(2))
                                </div>
                            }

                            @if (!string.IsNullOrEmpty(perfume.Description))
                            {
                                <p class="perfume-description">@(perfume.Description.Length > 80 ? perfume.Description.Substring(0, 80) + "..." : perfume.Description)</p>
                            }

                            <div class="perfume-footer">
                                <div class="perfume-price">@perfume.Price.ToString("N0") MAD</div>
                                <div class="perfume-stock @(perfume.StockQuantity > 0 ? "in-stock" : "out-of-stock")">
                                    @(perfume.StockQuantity > 0 ? $"En stock ({perfume.StockQuantity})" : "Rupture")
                                </div>
                            </div>

               
                            <form method="post" asp-page-handler="AddToCart" asp-route-id="@perfume.Id">
                                <button type="submit" 
                                        class="add-to-cart-btn" 
                                        @(perfume.StockQuantity <= 0 ? "disabled" : "")>
                                    @(perfume.StockQuantity > 0 ? "Ajouter au panier" : "Indisponible")
                                </button>
                            </form>
                        </div>
                    </article>
                }
            </div>
        }
        else
        {
            <div class="empty-state">
                <div class="empty-state-icon">🌸</div>
                <h3 class="h4 mb-3" style="color: var(--color-text-secondary);">Aucun parfum trouvé</h3>
                <p style="color: var(--color-text-secondary);">
                    Essayez de modifier vos critères de recherche ou explorez toute notre collection.
                </p>
                <a asp-page="/Index" class="btn btn-primary mt-3">
                    Voir toute la collection
                </a>
            </div>
        }

        @* Pagination *@
        @if (Model.TotalPages > 1)
        {
            <div class="pagination-container">
                <div class="pagination-info">
                    Page @Model.PageIndex sur @Model.TotalPages (@Model.TotalCount parfums)
                </div>
                <nav class="pagination-nav">
                    @if (Model.HasPreviousPage)
                    {
                        <a class="pagination-link" 
                           asp-page="/Index" 
                           asp-route-pageIndex="@(Model.PageIndex - 1)"
                           asp-route-pageSize="@Model.PageSize"
                           asp-route-query="@Model.Search.Query"
                           asp-route-brandId="@Model.SelectedBrandId"
                           asp-route-familyId="@Model.SelectedFamilyId"
                           asp-route-gender="@Model.SelectedGender">
                            ← Précédent
                        </a>
                    }

                    @for (int i = Math.Max(1, Model.PageIndex - 2); i <= Math.Min(Model.TotalPages, Model.PageIndex + 2); i++)
                    {
                        if (i == Model.PageIndex)
                        {
                            <span class="pagination-link active">@i</span>
                        }
                        else
                        {
                            <a class="pagination-link" 
                               asp-page="/Index" 
                               asp-route-pageIndex="@i"
                               asp-route-pageSize="@Model.PageSize"
                               asp-route-query="@Model.Search.Query"
                               asp-route-brandId="@Model.SelectedBrandId"
                               asp-route-familyId="@Model.SelectedFamilyId"
                               asp-route-gender="@Model.SelectedGender">
                                @i
                            </a>
                        }
                    }

                    @if (Model.HasNextPage)
                    {
                        <a class="pagination-link" 
                           asp-page="/Index" 
                           asp-route-pageIndex="@(Model.PageIndex + 1)"
                           asp-route-pageSize="@Model.PageSize"
                           asp-route-query="@Model.Search.Query"
                           asp-route-brandId="@Model.SelectedBrandId"
                           asp-route-familyId="@Model.SelectedFamilyId"
                           asp-route-gender="@Model.SelectedGender">
                            Suivant →
                        </a>
                    }
                </nav>
            </div>
        }
    </div>
</section>

<script>
    // Auto-dismiss toast notifications after 4 seconds
    setTimeout(() => {
        const toasts = document.querySelectorAll('.toast-notification');
        toasts.forEach(toast => {
            toast.style.animation = 'slideOut 0.3s ease forwards';
            setTimeout(() => toast.remove(), 300);
        });
    }, 4000);
</script>

<style>
    @@keyframes slideOut {
        from {
            transform: translateX(0);
            opacity: 1;
        }
        to {
            transform: translateX(100%);
            opacity: 0;
        }
    }
</style>
