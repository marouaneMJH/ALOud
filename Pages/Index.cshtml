@page
@model Pages.IndexModel
@inject Microsoft.Extensions.Configuration.IConfiguration Configuration
@{
    ViewData["Title"] = "Collection";
    var fallback = Configuration["Images:FallbackUrl"];
}

<!-- Hero Section -->
<section class="py-6 text-center">
    <div class="container">
        <h1 class="display-1 mb-4">ALOud</h1>
        <p class="lead mb-0" style="color: var(--color-text-secondary); max-width: 600px; margin: 0 auto;">
            Découvrez notre collection exclusive de parfums authentiques, 
            où chaque fragrance raconte une histoire d'élégance intemporelle.
        </p>
    </div>
</section>

<!-- Search & Filters -->
<section>
    <div class="container">
        <form method="get" class="search-form">
            <div class="row g-3 align-items-end">
                <!-- Search -->
                <div class="col-md-4">
                    <label for="query" class="form-label small text-uppercase" style="color: var(--color-text-secondary); font-weight: 600; letter-spacing: 0.05em;">Rechercher</label>
                    <input type="text"
                           id="query"
                           name="query"
                           value="@Model.Search.Query"
                           class="form-control"
                           placeholder="Nom du parfum..." />
                </div>

                <!-- Price Min -->
                <div class="col-md-2">
                    <label for="minPrice" class="form-label small text-uppercase" style="color: var(--color-text-secondary); font-weight: 600; letter-spacing: 0.05em;">Prix Min</label>
                    <input type="number"
                           id="minPrice"
                           name="minPrice"
                           value="@Model.Search.MinPrice"
                           class="form-control"
                           placeholder="0" />
                </div>

                <!-- Price Max -->
                <div class="col-md-2">
                    <label for="maxPrice" class="form-label small text-uppercase" style="color: var(--color-text-secondary); font-weight: 600; letter-spacing: 0.05em;">Prix Max</label>
                    <input type="number"
                           id="maxPrice"
                           name="maxPrice"
                           value="@Model.Search.MaxPrice"
                           class="form-control"
                           placeholder="1000" />
                </div>

                <!-- Sort -->
                <div class="col-md-2">
                    <label for="sort" class="form-label small text-uppercase" style="color: var(--color-text-secondary); font-weight: 600; letter-spacing: 0.05em;">Trier par</label>
                    <select name="sort" id="sort" class="form-control">
                        <option value="">Sélectionner</option>
                        <option value="price_asc" selected="@(Model.Search.Sort == "price_asc")">
                            Prix croissant
                        </option>
                        <option value="price_desc" selected="@(Model.Search.Sort == "price_desc")">
                            Prix décroissant
                        </option>
                    </select>
                </div>

                <!-- Button -->
                <div class="col-md-2">
                    <button class="btn btn-primary w-100">
                        Filtrer
                    </button>
                </div>
            </div>
        </form>
    </div>
</section>

<!-- Products Grid -->
<section>
    <div class="container">
        @if (Model.Products.Any())
        {
            <div class="product-grid">
                @foreach (var product in Model.Products)
                {
                    <article class="product-card">
                        <!-- Product Image -->
                        <a asp-page="/Product/Details" asp-route-id="@product.Id" class="text-decoration-none">
                            <div class="product-image-container">
                                  <img src="@product.ImageUrl" 
                                      alt="@product.Name"
                                      class="product-image" onerror="this.onerror=null;this.src='@fallback';" />
                            </div>
                        </a>

                        <!-- Product Info -->
                        <div class="product-info">
                            <a asp-page="/Product/Details" asp-route-id="@product.Id" class="text-decoration-none">
                                <h3 class="product-name">@product.Name</h3>
                            </a>
                            
                            <p class="product-price">@product.Price,00 MAD</p>

                            <!-- Add to Cart -->
                            <form method="post" asp-page-handler="AddToCart" class="mb-4">
                                <input type="hidden" name="productId" value="@product.Id" />
                                <button type="submit" class="btn btn-secondary w-100">
                                    Ajouter au panier
                                </button>
                            </form>
                        </div>
                    </article>
                }
            </div>
        }
        else
        {
            <div class="text-center py-6">
                <h3 class="h4 mb-3" style="color: var(--color-text-secondary);">Aucun parfum trouvé</h3>
                <p style="color: var(--color-text-secondary);">
                    Essayez de modifier vos critères de recherche ou explorez toute notre collection.
                </p>
                <a asp-page="/Index" class="btn btn-primary mt-3">
                    Voir toute la collection
                </a>
            </div>
        }

        @* Pagination *@
        @if (Model.TotalPages > 1)
        {
            <div class="pagination-container">
                <div class="pagination-info">
                    Page @Model.PageIndex sur @Model.TotalPages (@Model.TotalCount produits)
                </div>
                <nav class="pagination-nav">
                    @if (Model.HasPreviousPage)
                    {
                        <a class="pagination-link" 
                           asp-page="/Index" 
                           asp-route-pageIndex="@(Model.PageIndex - 1)"
                           asp-route-pageSize="@Model.PageSize"
                           asp-route-query="@Model.Search.Query"
                           asp-route-minPrice="@Model.Search.MinPrice"
                           asp-route-maxPrice="@Model.Search.MaxPrice"
                           asp-route-sort="@Model.Search.Sort">
                            Précédent
                        </a>
                    }

                    @for (int i = Math.Max(1, Model.PageIndex - 2); i <= Math.Min(Model.TotalPages, Model.PageIndex + 2); i++)
                    {
                        if (i == Model.PageIndex)
                        {
                            <span class="pagination-link active">@i</span>
                        }
                        else
                        {
                            <a class="pagination-link" 
                               asp-page="/Index" 
                               asp-route-pageIndex="@i"
                               asp-route-pageSize="@Model.PageSize"
                               asp-route-query="@Model.Search.Query"
                               asp-route-minPrice="@Model.Search.MinPrice"
                               asp-route-maxPrice="@Model.Search.MaxPrice"
                               asp-route-sort="@Model.Search.Sort">
                                @i
                            </a>
                        }
                    }

                    @if (Model.HasNextPage)
                    {
                        <a class="pagination-link" 
                           asp-page="/Index" 
                           asp-route-pageIndex="@(Model.PageIndex + 1)"
                           asp-route-pageSize="@Model.PageSize"
                           asp-route-query="@Model.Search.Query"
                           asp-route-minPrice="@Model.Search.MinPrice"
                           asp-route-maxPrice="@Model.Search.MaxPrice"
                           asp-route-sort="@Model.Search.Sort">
                            Suivant
                        </a>
                    }
                </nav>
            </div>
        }
    </div>
</section>
