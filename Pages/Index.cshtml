@page
@model Pages.IndexModel
@inject Microsoft.Extensions.Configuration.IConfiguration Configuration
@{
    ViewData["Title"] = "Collection";
    var fallback = Configuration["Images:FallbackUrl"];
}

<!-- Search Section -->
<section style="margin-bottom: var(--spacing-lg); margin-top: var(--spacing-2xl);">
    <div class="container">
        <form method="get" class="premium-search-form">
            <div class="search-wrapper">
                <svg class="search-icon" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <circle cx="11" cy="11" r="8"></circle>
                    <path d="m21 21-4.35-4.35"></path>
                </svg>
                <input type="text"
                       id="query"
                       name="query"
                       value="@Model.Search.Query"
                       class="search-input"
                       placeholder="Rechercher un parfum..."
                       onchange="this.form.submit()" />
            </div>
        </form>
    </div>
</section>

<!-- Category Filter Band -->
<section class="category-section" style="margin-bottom: var(--spacing-3xl);">
    <div class="category-band">
        <div class="container">
            <div class="category-scroll">
                <a class="category-pill @(Model.SelectedCategoryId == null ? "active" : "")" 
                   asp-page="/Index">
                    Tous
                </a>
                @foreach (var category in Model.Categories)
                {
                    <a class="category-pill @(Model.SelectedCategoryId == category.Id ? "active" : "")" 
                       asp-page="/Index" 
                       asp-route-categoryId="@category.Id"
                       asp-route-query="@Model.Search.Query">
                        @category.Name
                    </a>
                }
            </div>
        </div>
    </div>
</section>

<style>
    .premium-search-form {
        max-width: 900px;
        margin: 0 auto;
    }

    .search-wrapper {
        position: relative;
        display: flex;
        align-items: center;
        background: transparent;
        border: none;
        border-bottom: 2px solid var(--color-border);
        transition: all var(--transition-normal);
    }

    .search-wrapper:focus-within {
        border-bottom-color: var(--color-accent);
    }

    .search-icon {
        position: absolute;
        left: 0;
        color: var(--color-text-secondary);
        pointer-events: none;
    }

    .search-input {
        flex: 1;
        padding: var(--spacing-md) 0 var(--spacing-md) 2.5rem;
        border: none;
        font-family: var(--font-body);
        font-size: 1.1rem;
        color: var(--color-primary);
        background: transparent;
        outline: none;
    }

    .search-input::placeholder {
        color: var(--color-text-secondary);
        opacity: 0.5;
        font-weight: 300;
    }

    .category-section {
        background: var(--color-background);
        border-top: 1px solid var(--color-border);
        border-bottom: 1px solid var(--color-border);
        padding: var(--spacing-md) 0;
    }

    .category-band {
        width: 100%;
    }

    .category-scroll {
        display: flex;
        gap: var(--spacing-md);
        overflow-x: auto;
        padding: var(--spacing-xs) 0;
        scrollbar-width: none;
    }

    .category-scroll::-webkit-scrollbar {
        display: none;
    }

    .category-pill {
        padding: var(--spacing-sm) var(--spacing-xl);
        background: var(--color-white);
        color: var(--color-primary);
        border: 2px solid var(--color-border);
        font-family: var(--font-body);
        font-size: 0.9rem;
        font-weight: 500;
        text-decoration: none;
        text-transform: uppercase;
        letter-spacing: 0.5px;
        white-space: nowrap;
        transition: all var(--transition-normal);
        display: inline-block;
    }

    .category-pill:hover {
        border-color: var(--color-accent);
        transform: translateY(-2px);
        box-shadow: var(--shadow-card);
    }

    .category-pill.active {
        background: var(--color-accent);
        color: var(--color-white);
        border-color: var(--color-accent);
    }

    @@media (max-width: 768px) {
        .search-input {
            font-size: 1rem;
            padding: var(--spacing-sm) 0 var(--spacing-sm) 2.5rem;
        }

        .category-scroll {
            gap: var(--spacing-sm);
        }
    }
</style>

<!-- Products Grid -->
<section>
    <div class="container">
        @if (Model.Products.Any())
        {
            <div class="product-grid">
                @foreach (var product in Model.Products)
                {
                    <article class="product-card">
                        <!-- Product Image -->
                        <a asp-page="/Product/Details" asp-route-id="@product.Id" class="text-decoration-none">
                            <div class="product-image-container">
                                  <img src="@product.ImageUrl" 
                                      alt="@product.Name"
                                      class="product-image" onerror="this.onerror=null;this.src='@fallback';" />
                            </div>
                        </a>

                        <!-- Product Info -->
                        <div class="product-info">
                            <a asp-page="/Product/Details" asp-route-id="@product.Id" class="text-decoration-none">
                                <h3 class="product-name">@product.Name</h3>
                            </a>
                            
                            <p class="product-price">@product.Price,00 MAD</p>

                            <!-- Add to Cart -->
                            <form method="post" asp-page-handler="AddToCart" class="mb-4">
                                <input type="hidden" name="productId" value="@product.Id" />
                                <button type="submit" class="btn btn-secondary w-100">
                                    Ajouter au panier
                                </button>
                            </form>
                        </div>
                    </article>
                }
            </div>
        }
        else
        {
            <div class="text-center py-6">
                <h3 class="h4 mb-3" style="color: var(--color-text-secondary);">Aucun parfum trouvé</h3>
                <p style="color: var(--color-text-secondary);">
                    Essayez de modifier vos critères de recherche ou explorez toute notre collection.
                </p>
                <a asp-page="/Index" class="btn btn-primary mt-3">
                    Voir toute la collection
                </a>
            </div>
        }

        @* Pagination *@
        @if (Model.TotalPages > 1)
        {
            <div class="pagination-container">
                <div class="pagination-info">
                    Page @Model.PageIndex sur @Model.TotalPages (@Model.TotalCount produits)
                </div>
                <nav class="pagination-nav">
                    @if (Model.HasPreviousPage)
                    {
                        <a class="pagination-link" 
                           asp-page="/Index" 
                           asp-route-pageIndex="@(Model.PageIndex - 1)"
                           asp-route-pageSize="@Model.PageSize"
                           asp-route-query="@Model.Search.Query"
                           asp-route-categoryId="@Model.SelectedCategoryId">
                            Précédent
                        </a>
                    }

                    @for (int i = Math.Max(1, Model.PageIndex - 2); i <= Math.Min(Model.TotalPages, Model.PageIndex + 2); i++)
                    {
                        if (i == Model.PageIndex)
                        {
                            <span class="pagination-link active">@i</span>
                        }
                        else
                        {
                            <a class="pagination-link" 
                               asp-page="/Index" 
                               asp-route-pageIndex="@i"
                               asp-route-pageSize="@Model.PageSize"
                               asp-route-query="@Model.Search.Query"
                               asp-route-categoryId="@Model.SelectedCategoryId">
                                @i
                            </a>
                        }
                    }

                    @if (Model.HasNextPage)
                    {
                        <a class="pagination-link" 
                           asp-page="/Index" 
                           asp-route-pageIndex="@(Model.PageIndex + 1)"
                           asp-route-pageSize="@Model.PageSize"
                           asp-route-query="@Model.Search.Query"
                           asp-route-categoryId="@Model.SelectedCategoryId">
                            Suivant
                        </a>
                    }
                </nav>
            </div>
        }
    </div>
</section>
