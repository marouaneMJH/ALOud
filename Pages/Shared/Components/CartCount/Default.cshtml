@model int


@if (Model > 0)
{

    <script>
        console.log("Items in cart: @Model");
    </script>
    <span class="position-absolute top-0 start-100 translate-middle badge rounded-pill sca" 
          style="background-color: var(--color-accent); color: var(--color-primary); font-size: 0.75rem; min-width: 18px; height: 18px; display: flex; align-items: center; justify-content: center; margin-top: -2px; margin-left: -8px;">
        @Model
    </span>
}
