<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - ALOud</title>
    
    <!-- Bootstrap CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
    
    <!-- Custom CSS -->
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <partial name="_Header" />

    <!-- Main Content -->
    <main>
        @RenderBody()
    </main>

    <!-- Footer -->
    <footer class="py-5 mt-6" style="background-color: var(--color-primary); color: var(--color-white);">
        <div class="container">
            <div class="row">
                <div class="col-md-6">
                    <h3 class="h5 mb-3" style="color: var(--color-white);">ALOud</h3>
                    <p class="small" style="color: rgba(255,255,255,0.8);">L'art de la parfumerie authentique</p>
                </div>
                <div class="col-md-6">
                    <div class="row">
                        <div class="col-6">
                            <h4 class="h6 mb-3" style="color: var(--color-white);">Liens</h4>
                            <ul class="list-unstyled small">
                                <li><a href="#" class="text-decoration-none" style="color: rgba(255,255,255,0.8);">À propos</a></li>
                                <li><a href="#" class="text-decoration-none" style="color: rgba(255,255,255,0.8);">Contact</a></li>
                                <li><a asp-page="/Privacy" class="text-decoration-none" style="color: rgba(255,255,255,0.8);">Confidentialité</a></li>
                            </ul>
                        </div>
                    </div>
                </div>
            </div>
            <hr class="my-4" style="border-color: rgba(255,255,255,0.2);">
            <div class="text-center">
                <p class="small mb-0" style="color: rgba(255,255,255,0.6);">&copy; @DateTime.Now.Year ALOud. Tous droits réservés.</p>
            </div>
        </div>
    </footer>

    <!-- Bootstrap JS -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
