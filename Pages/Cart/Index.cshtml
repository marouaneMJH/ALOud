

@page
@model Pages.Cart.IndexModel
@inject Microsoft.Extensions.Configuration.IConfiguration Configuration
@{
    ViewData["Title"] = "Panier";
    var fallback = Configuration["Images:FallbackUrl"];
}

<section class="py-5">
    <div class="container">
        <!-- Header -->
        <div class="text-center mb-5">
            <h1 class="display-2 mb-3">Votre Panier</h1>
            @if (Model.Items.Any())
            {
                <p style="color: var(--color-text-secondary);">
                    @Model.Items.Count @(Model.Items.Count > 1 ? "articles" : "article") dans votre sélection
                </p>
            }
        </div>

        @if (!Model.Items.Any())
        {
            <!-- Empty Cart -->
            <div class="text-center py-6">
                <div class="mb-4">
                    <svg width="80" height="80" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" style="color: var(--color-text-secondary); opacity: 0.5;">
                        <path d="M3 3H5L5.4 5M7 13H17L21 5H5.4M7 13L5.4 5M7 13L4.7 15.3C4.3 15.7 4.6 16.4 5.1 16.4H17M17 13V17A2 2 0 0 1 15 19H9A2 2 0 0 1 7 17V13M17 13H7" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                    </svg>
                </div>
                <h3 class="h4 mb-3" style="color: var(--color-text-secondary);">Votre panier est vide</h3>
                <p class="mb-4" style="color: var(--color-text-secondary);">
                    Découvrez notre collection de parfums authentiques et ajoutez vos favoris.
                </p>
                <a asp-page="/Index" class="btn btn-primary">
                    Découvrir la collection
                </a>
            </div>
        }
        else
        {
            <!-- Cart Items -->
            <div class="row">
                <div class="col-lg-8">
                    <!-- Cart Table -->
                    <div class="mb-5">
                        <table class="cart-table">
                            <thead>
                                <tr>
                                    <th>Produit</th>
                                    <th class="text-center">Quantité</th>
                                    <th class="text-end">Prix</th>
                                    <th class="text-end">Total</th>
                                    <th></th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var item in Model.Items)
                                {
                                    <tr>
                                        <td>
                                            <div class="d-flex align-items-center">
                                                <div class="me-3" style="width: 80px; height: 80px; background: var(--color-background); border-radius: 4px; overflow: hidden;">
                                                      <img src="@item.ImageUrl" 
                                                          alt="@item.ProductName"
                                                          style="width: 100%; height: 100%; object-fit: cover;" onerror="this.onerror=null;this.src='@fallback';" />
                                                </div>
                                                <div>
                                                    <p class="small mb-0" style="color: var(--color-accent); text-transform: uppercase; letter-spacing: 0.05em;">
                                                        @item.BrandName
                                                    </p>
                                                    <h4 class="h6 mb-0">@item.ProductName</h4>
                                                </div>
                                            </div>
                                        </td>
                                        <td class="text-center">
                                            <form method="post" class="d-inline-flex align-items-center">
                                                <input type="hidden" name="productId" value="@item.ProductId" />
                                                <button asp-page-handler="Decrease" 
                                                        class="btn btn-minimal p-2"
                                                        style="border: 1px solid var(--color-border); width: 32px; height: 32px; display: flex; align-items: center; justify-content: center;">
                                                    −
                                                </button>
                                                <span class="mx-3 fw-semibold">@item.Quantity</span>
                                                <button asp-page-handler="Increase" 
                                                        class="btn btn-minimal p-2"
                                                        style="border: 1px solid var(--color-border); width: 32px; height: 32px; display: flex; align-items: center; justify-content: center;">
                                                    +
                                                </button>
                                            </form>
                                        </td>
                                        <td class="text-end">
                                            <span style="color: var(--color-text-secondary);">@item.Price.ToString("N0") MAD</span>
                                        </td>
                                        <td class="text-end">
                                            <span class="fw-semibold" style="color: var(--color-accent);">@item.Total.ToString("N0") MAD</span>
                                        </td>
                                        <td class="text-end">
                                            <form method="post">
                                                <input type="hidden" name="productId" value="@item.ProductId" />
                                                <button asp-page-handler="Remove" 
                                                        class="btn btn-minimal p-2"
                                                        style="color: var(--color-text-secondary);"
                                                        title="Supprimer">
                                                    ✕
                                                </button>
                                            </form>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>

                <!-- Cart Summary -->
                <div class="col-lg-4">
                    <div class="p-4" style="background: var(--color-white); border: 1px solid var(--color-border);">
                        <h3 class="h5 mb-4">Résumé de commande</h3>
                        
                        <div class="d-flex justify-content-between mb-3">
                            <span>Sous-total</span>
                            <span style="color: var(--color-text-secondary);">@Model.Items.Sum(i => i.Total).ToString("N0") MAD</span>
                        </div>
                        
                        <div class="d-flex justify-content-between mb-3">
                            <span>Livraison</span>
                            <span style="color: var(--color-text-secondary);">Gratuite</span>
                        </div>
                        
                        <hr class="my-3" style="border-color: var(--color-border);">
                        
                        <div class="d-flex justify-content-between mb-4">
                            <span class="fw-semibold">Total</span>
                            <span class="fw-semibold" style="color: var(--color-accent); font-size: 1.25rem;">
                                @Model.Items.Sum(i => i.Total).ToString("N0") MAD
                            </span>
                        </div>
                        
                        <button class="btn btn-primary w-100 py-3">
                            Procéder au paiement
                        </button>
                        
                        <div class="text-center mt-3">
                            <a asp-page="/Index" class="btn btn-minimal">
                                Continuer mes achats
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
</section>
