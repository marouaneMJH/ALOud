@model ALOud.DTOs.Admin.DashboardStatsDto
@{
    ViewData["Title"] = "Admin Dashboard";
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - ALOud Admin</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css" rel="stylesheet" />
    <style>
        :root {
            --sidebar-width: 260px;
            --sidebar-bg: #1a1a2e;
            --sidebar-hover: #16213e;
            --accent-color: #e94560;
            --accent-light: #ff6b6b;
            --text-muted: #a0aec0;
            --card-bg: #ffffff;
            --body-bg: #f4f6f9;
        }

        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            font-family: 'Segoe UI', system-ui, -apple-system, sans-serif;
            background: var(--body-bg);
            min-height: 100vh;
        }

        /* Sidebar Styles */
        .sidebar {
            position: fixed;
            left: 0;
            top: 0;
            width: var(--sidebar-width);
            height: 100vh;
            background: var(--sidebar-bg);
            padding: 1.5rem 0;
            overflow-y: auto;
            z-index: 1000;
            transition: transform 0.3s ease;
        }

        .sidebar-brand {
            padding: 0 1.5rem 1.5rem;
            border-bottom: 1px solid rgba(255,255,255,0.1);
            margin-bottom: 1rem;
        }

        .sidebar-brand h2 {
            color: #fff;
            font-size: 1.5rem;
            font-weight: 700;
            display: flex;
            align-items: center;
            gap: 0.5rem;
        }

        .sidebar-brand h2 i {
            color: var(--accent-color);
        }

        .sidebar-brand span {
            font-size: 0.75rem;
            color: var(--text-muted);
            display: block;
            margin-top: 0.25rem;
        }

        .nav-section {
            padding: 0.5rem 1.5rem;
            margin-bottom: 0.5rem;
        }

        .nav-section-title {
            font-size: 0.7rem;
            text-transform: uppercase;
            letter-spacing: 1px;
            color: var(--text-muted);
            margin-bottom: 0.75rem;
            font-weight: 600;
        }

        .nav-link {
            display: flex;
            align-items: center;
            gap: 0.75rem;
            padding: 0.75rem 1rem;
            color: rgba(255,255,255,0.7);
            text-decoration: none;
            border-radius: 8px;
            margin-bottom: 0.25rem;
            transition: all 0.2s ease;
            font-size: 0.9rem;
        }

        .nav-link:hover {
            background: var(--sidebar-hover);
            color: #fff;
        }

        .nav-link.active {
            background: var(--accent-color);
            color: #fff;
        }

        .nav-link i {
            font-size: 1.1rem;
            width: 24px;
            text-align: center;
        }

        .nav-link .badge {
            margin-left: auto;
            background: rgba(255,255,255,0.2);
            font-size: 0.7rem;
            padding: 0.25rem 0.5rem;
        }

        /* Main Content */
        .main-content {
            margin-left: var(--sidebar-width);
            padding: 2rem;
            min-height: 100vh;
        }

        .page-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 2rem;
        }

        .page-header h1 {
            font-size: 1.75rem;
            font-weight: 700;
            color: #1a1a2e;
        }

        .page-header .breadcrumb {
            font-size: 0.85rem;
            color: var(--text-muted);
        }

        /* Stats Cards */
        .stats-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
            gap: 1.5rem;
            margin-bottom: 2rem;
        }

        .stat-card {
            background: var(--card-bg);
            border-radius: 16px;
            padding: 1.5rem;
            box-shadow: 0 4px 6px -1px rgba(0,0,0,0.1);
            transition: transform 0.2s ease, box-shadow 0.2s ease;
        }

        .stat-card:hover {
            transform: translateY(-4px);
            box-shadow: 0 10px 25px -5px rgba(0,0,0,0.1);
        }

        .stat-card .icon {
            width: 48px;
            height: 48px;
            border-radius: 12px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 1.5rem;
            margin-bottom: 1rem;
        }

        .stat-card .icon.purple { background: linear-gradient(135deg, #667eea, #764ba2); color: #fff; }
        .stat-card .icon.blue { background: linear-gradient(135deg, #4facfe, #00f2fe); color: #fff; }
        .stat-card .icon.pink { background: linear-gradient(135deg, #f093fb, #f5576c); color: #fff; }
        .stat-card .icon.orange { background: linear-gradient(135deg, #fa709a, #fee140); color: #fff; }
        .stat-card .icon.green { background: linear-gradient(135deg, #11998e, #38ef7d); color: #fff; }
        .stat-card .icon.red { background: linear-gradient(135deg, #eb3349, #f45c43); color: #fff; }
        .stat-card .icon.teal { background: linear-gradient(135deg, #0ed2f7, #00d9ff); color: #fff; }
        .stat-card .icon.indigo { background: linear-gradient(135deg, #5c6bc0, #3949ab); color: #fff; }

        .stat-card .value {
            font-size: 2rem;
            font-weight: 700;
            color: #1a1a2e;
            line-height: 1;
        }

        .stat-card .label {
            font-size: 0.875rem;
            color: var(--text-muted);
            margin-top: 0.25rem;
        }

        /* Content Cards */
        .content-card {
            background: var(--card-bg);
            border-radius: 16px;
            box-shadow: 0 4px 6px -1px rgba(0,0,0,0.1);
            margin-bottom: 1.5rem;
        }

        .content-card .card-header {
            padding: 1.25rem 1.5rem;
            border-bottom: 1px solid #eee;
            display: flex;
            justify-content: space-between;
            align-items: center;
        }

        .content-card .card-header h3 {
            font-size: 1rem;
            font-weight: 600;
            color: #1a1a2e;
            margin: 0;
        }

        .content-card .card-body {
            padding: 1.5rem;
        }

        /* Data Table */
        .data-table {
            width: 100%;
            border-collapse: collapse;
        }

        .data-table th {
            text-align: left;
            padding: 0.75rem 1rem;
            font-size: 0.75rem;
            text-transform: uppercase;
            letter-spacing: 0.5px;
            color: var(--text-muted);
            border-bottom: 2px solid #eee;
            font-weight: 600;
        }

        .data-table td {
            padding: 1rem;
            border-bottom: 1px solid #f0f0f0;
            font-size: 0.9rem;
        }

        .data-table tr:last-child td {
            border-bottom: none;
        }

        .data-table tr:hover {
            background: #f9fafb;
        }

        /* List Items */
        .list-item {
            display: flex;
            align-items: center;
            padding: 0.75rem 0;
            border-bottom: 1px solid #f0f0f0;
        }

        .list-item:last-child {
            border-bottom: none;
        }

        .list-item .avatar {
            width: 40px;
            height: 40px;
            border-radius: 10px;
            background: linear-gradient(135deg, #667eea, #764ba2);
            display: flex;
            align-items: center;
            justify-content: center;
            color: #fff;
            font-weight: 600;
            margin-right: 1rem;
            font-size: 0.875rem;
        }

        .list-item .info {
            flex: 1;
        }

        .list-item .info .name {
            font-weight: 600;
            color: #1a1a2e;
            font-size: 0.9rem;
        }

        .list-item .info .meta {
            font-size: 0.8rem;
            color: var(--text-muted);
        }

        .list-item .count {
            background: #f0f0f0;
            padding: 0.35rem 0.75rem;
            border-radius: 20px;
            font-size: 0.8rem;
            font-weight: 600;
            color: #666;
        }

        /* Quick Actions */
        .quick-actions {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(140px, 1fr));
            gap: 1rem;
        }

        .quick-action {
            display: flex;
            flex-direction: column;
            align-items: center;
            padding: 1.25rem;
            background: #f9fafb;
            border-radius: 12px;
            text-decoration: none;
            color: #1a1a2e;
            transition: all 0.2s ease;
            border: 2px solid transparent;
        }

        .quick-action:hover {
            background: #fff;
            border-color: var(--accent-color);
            transform: translateY(-2px);
        }

        .quick-action i {
            font-size: 1.5rem;
            margin-bottom: 0.5rem;
            color: var(--accent-color);
        }

        .quick-action span {
            font-size: 0.85rem;
            font-weight: 500;
            text-align: center;
        }

        /* Mobile Toggle */
        .mobile-toggle {
            display: none;
            position: fixed;
            top: 1rem;
            left: 1rem;
            z-index: 1001;
            background: var(--sidebar-bg);
            color: #fff;
            border: none;
            padding: 0.75rem;
            border-radius: 8px;
            cursor: pointer;
        }

        @@media (max-width: 992px) {
            .sidebar {
                transform: translateX(-100%);
            }

            .sidebar.active {
                transform: translateX(0);
            }

            .main-content {
                margin-left: 0;
            }

            .mobile-toggle {
                display: block;
            }
        }

        /* Perfume Image Placeholder */
        .perfume-img {
            width: 50px;
            height: 50px;
            border-radius: 8px;
            object-fit: cover;
            background: linear-gradient(135deg, #f093fb, #f5576c);
        }
    </style>
</head>
<body>
    <!-- Mobile Toggle Button -->
    <button class="mobile-toggle" onclick="toggleSidebar()">
        <i class="bi bi-list"></i>
    </button>

    <!-- Sidebar -->
    <aside class="sidebar" id="sidebar">
        <div class="sidebar-brand">
            <h2><i class="bi bi-droplet-fill"></i> ALOud</h2>
            <span>Perfume Admin Panel</span>
        </div>

        <nav>
            <!-- Overview -->
            <div class="nav-section">
                <div class="nav-section-title">Overview</div>
                <a href="@Url.Action("Index", "Admin")" class="nav-link active">
                    <i class="bi bi-grid-1x2-fill"></i>
                    Dashboard
                </a>
            </div>

            <!-- Catalog -->
            <div class="nav-section">
                <div class="nav-section-title">Catalog</div>
                <a href="@Url.Action("Perfumes", "PerfumeAdmin")" class="nav-link">
                    <i class="bi bi-droplet"></i>
                    Perfumes
                    <span class="badge">@Model.TotalPerfumes</span>
                </a>
                <a href="@Url.Action("Brands", "PerfumeAdmin")" class="nav-link">
                    <i class="bi bi-building"></i>
                    Brands
                    <span class="badge">@Model.TotalBrands</span>
                </a>
            </div>

            <!-- Classifications -->
            <div class="nav-section">
                <div class="nav-section-title">Classifications</div>
                <a href="@Url.Action("Families", "PerfumeAdmin")" class="nav-link">
                    <i class="bi bi-diagram-3"></i>
                    Families
                    <span class="badge">@Model.TotalFamilies</span>
                </a>
                <a href="@Url.Action("Notes", "PerfumeAdmin")" class="nav-link">
                    <i class="bi bi-music-note-beamed"></i>
                    Notes
                    <span class="badge">@Model.TotalNotes</span>
                </a>
                <a href="@Url.Action("Accords", "PerfumeAdmin")" class="nav-link">
                    <i class="bi bi-palette"></i>
                    Accords
                    <span class="badge">@Model.TotalAccords</span>
                </a>
            </div>

            <!-- Attributes -->
            <div class="nav-section">
                <div class="nav-section-title">Attributes</div>
                <a href="@Url.Action("Tags", "PerfumeAdmin")" class="nav-link">
                    <i class="bi bi-tags"></i>
                    Tags
                    <span class="badge">@Model.TotalTags</span>
                </a>
                <a href="@Url.Action("Seasons", "PerfumeAdmin")" class="nav-link">
                    <i class="bi bi-sun"></i>
                    Seasons
                    <span class="badge">@Model.TotalSeasons</span>
                </a>
                <a href="@Url.Action("Occasions", "PerfumeAdmin")" class="nav-link">
                    <i class="bi bi-calendar-event"></i>
                    Occasions
                    <span class="badge">@Model.TotalOccasions</span>
                </a>
            </div>

            <!-- Settings -->
            <div class="nav-section">
                <div class="nav-section-title">Settings</div>
                <a href="@Url.Action("LLMConfig", "Admin")" class="nav-link">
                    <i class="bi bi-robot"></i>
                    LLM Configuration
                </a>
                <a href="@Url.Action("Index", "Home")" class="nav-link">
                    <i class="bi bi-box-arrow-left"></i>
                    Back to Store
                </a>
            </div>
        </nav>
    </aside>

    <!-- Main Content -->
    <main class="main-content">
        <div class="page-header">
            <div>
                <h1>Dashboard</h1>
                <span class="breadcrumb">Welcome back, Admin</span>
            </div>
            <div>
                <span class="text-muted">@DateTime.Now.ToString("dddd, MMMM d, yyyy")</span>
            </div>
        </div>

        <!-- Primary Stats -->
        <div class="stats-grid">
            <div class="stat-card">
                <div class="icon purple">
                    <i class="bi bi-droplet-fill"></i>
                </div>
                <div class="value">@Model.TotalPerfumes</div>
                <div class="label">Total Perfumes</div>
            </div>
            <div class="stat-card">
                <div class="icon blue">
                    <i class="bi bi-building"></i>
                </div>
                <div class="value">@Model.TotalBrands</div>
                <div class="label">Brands</div>
            </div>
            <div class="stat-card">
                <div class="icon pink">
                    <i class="bi bi-diagram-3"></i>
                </div>
                <div class="value">@Model.TotalFamilies</div>
                <div class="label">Fragrance Families</div>
            </div>
            <div class="stat-card">
                <div class="icon orange">
                    <i class="bi bi-music-note-beamed"></i>
                </div>
                <div class="value">@Model.TotalNotes</div>
                <div class="label">Scent Notes</div>
            </div>
        </div>

        <!-- Secondary Stats -->
        <div class="stats-grid" style="margin-bottom: 2rem;">
            <div class="stat-card">
                <div class="icon green">
                    <i class="bi bi-palette"></i>
                </div>
                <div class="value">@Model.TotalAccords</div>
                <div class="label">Accords</div>
            </div>
            <div class="stat-card">
                <div class="icon red">
                    <i class="bi bi-tags"></i>
                </div>
                <div class="value">@Model.TotalTags</div>
                <div class="label">Tags</div>
            </div>
            <div class="stat-card">
                <div class="icon teal">
                    <i class="bi bi-sun"></i>
                </div>
                <div class="value">@Model.TotalSeasons</div>
                <div class="label">Seasons</div>
            </div>
            <div class="stat-card">
                <div class="icon indigo">
                    <i class="bi bi-calendar-event"></i>
                </div>
                <div class="value">@Model.TotalOccasions</div>
                <div class="label">Occasions</div>
            </div>
        </div>

        <div class="row g-4">
            <!-- Top Brands -->
            <div class="col-lg-6">
                <div class="content-card">
                    <div class="card-header">
                        <h3><i class="bi bi-trophy me-2"></i>Top Brands</h3>
                        <a href="@Url.Action("Brands", "PerfumeAdmin")" class="btn btn-sm btn-outline-primary">View All</a>
                    </div>
                    <div class="card-body">
                        @if (Model.TopBrands != null && Model.TopBrands.Any())
                        {
                            @foreach (var brand in Model.TopBrands)
                            {
                                <div class="list-item">
                                    <div class="avatar">@brand.BrandName?.Substring(0, Math.Min(2, brand.BrandName.Length)).ToUpper()</div>
                                    <div class="info">
                                        <div class="name">@brand.BrandName</div>
                                        <div class="meta">@brand.PerfumeCount perfumes</div>
                                    </div>
                                    <div class="count">@brand.PerfumeCount</div>
                                </div>
                            }
                        }
                        else
                        {
                            <p class="text-muted text-center py-3">No brands found</p>
                        }
                    </div>
                </div>
            </div>

            <!-- Top Families -->
            <div class="col-lg-6">
                <div class="content-card">
                    <div class="card-header">
                        <h3><i class="bi bi-star me-2"></i>Top Families</h3>
                        <a href="@Url.Action("Families", "PerfumeAdmin")" class="btn btn-sm btn-outline-primary">View All</a>
                    </div>
                    <div class="card-body">
                        @if (Model.TopFamilies != null && Model.TopFamilies.Any())
                        {
                            @foreach (var family in Model.TopFamilies)
                            {
                                <div class="list-item">
                                    <div class="avatar" style="background: linear-gradient(135deg, #f093fb, #f5576c);">@family.FamilyName?.Substring(0, Math.Min(2, family.FamilyName.Length)).ToUpper()</div>
                                    <div class="info">
                                        <div class="name">@family.FamilyName</div>
                                        <div class="meta">@family.PerfumeCount perfumes</div>
                                    </div>
                                    <div class="count">@family.PerfumeCount</div>
                                </div>
                            }
                        }
                        else
                        {
                            <p class="text-muted text-center py-3">No families found</p>
                        }
                    </div>
                </div>
            </div>
        </div>

        <!-- Recent Perfumes -->
        <div class="content-card">
            <div class="card-header">
                <h3><i class="bi bi-clock-history me-2"></i>Recent Perfumes</h3>
                <a href="@Url.Action("Perfumes", "PerfumeAdmin")" class="btn btn-sm btn-outline-primary">View All</a>
            </div>
            <div class="card-body p-0">
                <table class="data-table">
                    <thead>
                        <tr>
                            <th>Perfume</th>
                            <th>Brand</th>
                            <th>Gender</th>
                            <th>Added</th>
                            <th>Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model.RecentPerfumes != null && Model.RecentPerfumes.Any())
                        {
                            @foreach (var perfume in Model.RecentPerfumes)
                            {
                                <tr>
                                    <td>
                                        <div class="d-flex align-items-center">
                                            @if (!string.IsNullOrEmpty(perfume.ImageUrl))
                                            {
                                                <img src="@perfume.ImageUrl" class="perfume-img me-3" alt="@perfume.PerfumeName">
                                            }
                                            else
                                            {
                                                <div class="perfume-img me-3 d-flex align-items-center justify-content-center text-white">
                                                    <i class="bi bi-droplet"></i>
                                                </div>
                                            }
                                            <strong>@perfume.PerfumeName</strong>
                                        </div>
                                    </td>
                                    <td>@perfume.BrandName</td>
                                    <td>
                                        <span class="badge bg-secondary">@(perfume.GenderProfile ?? "N/A")</span>
                                    </td>
                                    <td>@perfume.CreatedAt.ToString("MMM d, yyyy")</td>
                                    <td>
                                        <a href="@Url.Action("EditPerfume", "PerfumeAdmin", new { id = perfume.PerfumeId })" class="btn btn-sm btn-outline-primary">
                                            <i class="bi bi-pencil"></i>
                                        </a>
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="5" class="text-center text-muted py-4">No perfumes found</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>

        <!-- Quick Actions -->
        <div class="content-card">
            <div class="card-header">
                <h3><i class="bi bi-lightning me-2"></i>Quick Actions</h3>
            </div>
            <div class="card-body">
                <div class="quick-actions">
                    <a href="@Url.Action("CreatePerfume", "PerfumeAdmin")" class="quick-action">
                        <i class="bi bi-plus-circle"></i>
                        <span>Add Perfume</span>
                    </a>
                    <a href="@Url.Action("CreateBrand", "PerfumeAdmin")" class="quick-action">
                        <i class="bi bi-building-add"></i>
                        <span>Add Brand</span>
                    </a>
                    <a href="@Url.Action("CreateFamily", "PerfumeAdmin")" class="quick-action">
                        <i class="bi bi-diagram-3"></i>
                        <span>Add Family</span>
                    </a>
                    <a href="@Url.Action("CreateNote", "PerfumeAdmin")" class="quick-action">
                        <i class="bi bi-music-note-beamed"></i>
                        <span>Add Note</span>
                    </a>
                    <a href="@Url.Action("CreateAccord", "PerfumeAdmin")" class="quick-action">
                        <i class="bi bi-palette"></i>
                        <span>Add Accord</span>
                    </a>
                    <a href="@Url.Action("CreateTag", "PerfumeAdmin")" class="quick-action">
                        <i class="bi bi-tag"></i>
                        <span>Add Tag</span>
                    </a>
                </div>
            </div>
        </div>
    </main>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
    <script>
        function toggleSidebar() {
            document.getElementById('sidebar').classList.toggle('active');
        }

        // Close sidebar when clicking outside on mobile
        document.addEventListener('click', function(e) {
            const sidebar = document.getElementById('sidebar');
            const toggle = document.querySelector('.mobile-toggle');
            if (window.innerWidth <= 992) {
                if (!sidebar.contains(e.target) && !toggle.contains(e.target)) {
                    sidebar.classList.remove('active');
                }
            }
        });
    </script>
</body>
</html>
