@model ViewModels.PaginatedList<ViewModels.ProductDetailsVM>
@inject Microsoft.Extensions.Configuration.IConfiguration Configuration

@{
    ViewData["Title"] = "Admin - Products";
    var fallback = Configuration["Images:FallbackUrl"];
}

<style>
    .admin-header {
        padding: var(--spacing-2xl) 0 var(--spacing-xl);
        border-bottom: 1px solid var(--color-border);
        margin-bottom: var(--spacing-2xl);
    }

    .admin-title {
        font-family: var(--font-heading);
        font-size: 2.25rem;
        font-weight: 400;
        letter-spacing: -0.02em;
        color: var(--color-primary);
        margin: 0;
    }

    .admin-actions {
        display: flex;
        gap: var(--spacing-md);
    }

    .btn-primary-custom,
    .btn-secondary-custom {
        padding: var(--spacing-sm) var(--spacing-xl);
        font-family: var(--font-body);
        font-size: 0.875rem;
        font-weight: 500;
        text-decoration: none;
        text-transform: uppercase;
        letter-spacing: 1px;
        transition: all var(--transition-normal);
        display: inline-block;
        cursor: pointer;
    }

    .btn-primary-custom {
        background: var(--color-primary);
        color: var(--color-white);
        border: 2px solid var(--color-primary);
    }

    .btn-primary-custom:hover {
        background: transparent;
        color: var(--color-primary);
        transform: translateY(-2px);
    }

    .btn-secondary-custom {
        background: transparent;
        color: var(--color-primary);
        border: 2px solid var(--color-border);
    }

    .btn-secondary-custom:hover {
        background: var(--color-primary);
        color: var(--color-white);
        border-color: var(--color-primary);
        transform: translateY(-2px);
    }

    .products-table-wrapper {
        background: var(--color-white);
        border: 1px solid var(--color-border);
    }

    .products-table {
        width: 100%;
        border-collapse: collapse;
    }

    .products-table thead th {
        font-size: 0.75rem;
        text-transform: uppercase;
        letter-spacing: 0.1em;
        color: var(--color-text-secondary);
        font-weight: 600;
        padding: var(--spacing-lg);
        text-align: left;
        border-bottom: 1px solid var(--color-border);
        background: var(--color-background);
    }

    .products-table tbody td {
        padding: var(--spacing-lg);
        border-bottom: 1px solid rgba(0,0,0,0.03);
        color: var(--color-primary);
        vertical-align: middle;
    }

    .products-table tbody tr {
        transition: background var(--transition-fast);
    }

    .products-table tbody tr:hover {
        background: var(--color-hover);
    }

    .product-thumb {
        width: 56px;
        height: 56px;
        object-fit: cover;
        transition: transform var(--transition-normal);
    }

    .products-table tbody tr:hover .product-thumb {
        transform: scale(1.05);
    }

    .product-name-cell {
        font-weight: 500;
        color: var(--color-primary);
    }

    .product-price-cell {
        font-weight: 600;
        color: var(--color-accent);
    }

    .actions-cell {
        display: flex;
        gap: var(--spacing-sm);
        align-items: center;
    }

    .btn-table-action {
        padding: var(--spacing-xs) var(--spacing-md);
        font-size: 0.875rem;
        border: 1px solid var(--color-border);
        background: var(--color-white);
        color: var(--color-primary);
        text-decoration: none;
        transition: all var(--transition-fast);
        display: inline-block;
    }

    .btn-table-action:hover {
        background: var(--color-primary);
        color: var(--color-white);
        border-color: var(--color-primary);
    }

    .btn-table-delete {
        background: transparent;
        border: 1px solid #8b5a3c;
        color: #8b5a3c;
        padding: var(--spacing-xs) var(--spacing-md);
        font-size: 0.875rem;
        cursor: pointer;
        transition: all var(--transition-fast);
    }

    .btn-table-delete:hover {
        background: #8b5a3c;
        color: var(--color-white);
    }

    .pagination-wrapper {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: var(--spacing-xl);
        background: var(--color-white);
        border: 1px solid var(--color-border);
        border-top: none;
        font-family: var(--font-body);
    }

    .pagination-info {
        color: var(--color-text-secondary);
        font-size: 0.9rem;
    }

    .pagination-controls {
        display: flex;
        gap: var(--spacing-sm);
        align-items: center;
    }

    .pagination-btn,
    .pagination-page {
        padding: var(--spacing-xs) var(--spacing-md);
        border: 2px solid var(--color-border);
        background: var(--color-white);
        color: var(--color-primary);
        text-decoration: none;
        transition: all var(--transition-fast);
        font-size: 0.875rem;
        font-weight: 500;
        display: inline-block;
        min-width: 40px;
        text-align: center;
    }

    .pagination-btn:hover:not(.disabled) {
        background: var(--color-primary);
        color: var(--color-white);
        border-color: var(--color-primary);
    }

    .pagination-page.active {
        background: var(--color-accent);
        color: var(--color-white);
        border-color: var(--color-accent);
    }

    .pagination-btn.disabled {
        opacity: 0.4;
        cursor: not-allowed;
    }
</style>

<div class="container">
    <div class="admin-header">
        <h1 class="admin-title">Products</h1>
        <div class="admin-actions">
            <a class="btn-secondary-custom" asp-action="Index">
                Dashboard
            </a>
            <a class="btn-primary-custom" asp-action="CreateProduct">Create New Product</a>
        </div>
    </div>

    <div class="products-table-wrapper">
        <table class="products-table">
        <thead>
            <tr>
                <th></th>
                <th>Name</th>
                <th>Price</th>
                <th>Stock</th>
                <th>Actions</th>
            </tr>
        </thead>
    <tbody>
        @foreach (var p in Model.Items)
        {
            <tr>
                    
                    <td>
                        @if (!string.IsNullOrEmpty(p.ImageUrl))
                        {
                            <img src="@p.ImageUrl" alt="@p.Name" class="product-thumb" onerror="this.onerror=null;this.src='@fallback';" />
                        }
                    </td>
                <td class="product-name-cell">@p.Name</td>
                <td class="product-price-cell">@p.Price MAD</td>
                <td>@p.Stock</td>
                <td>
                    <div class="actions-cell">
                        <a class="btn-table-action" asp-controller="Admin" asp-action="EditProduct" asp-route-id="@p.Id">Edit</a>
                        <form asp-controller="Admin" asp-action="DeleteProduct" asp-route-id="@p.Id" method="post" style="display:inline; margin:0;">
                            @Html.AntiForgeryToken()
                            <button class="btn-table-delete" type="submit" onclick="return confirm('Delete this product?')">Delete</button>
                        </form>
                    </div>
                </td>
            </tr>
        }
    </tbody>
</table>
</div>

    @if (Model.TotalPages > 1)
    {
        <div class="pagination-wrapper">
            <div class="pagination-info">
                Showing @((Model.PageIndex - 1) * Model.PageSize + 1) - @(Math.Min(Model.PageIndex * Model.PageSize, Model.TotalCount)) of @Model.TotalCount products
            </div>
            <div class="pagination-controls">
                @if (Model.HasPreviousPage)
                {
                    <a class="pagination-btn" asp-action="Products" asp-route-pageIndex="@(Model.PageIndex - 1)" asp-route-pageSize="@Model.PageSize">Previous</a>
                }
                else
                {
                    <span class="pagination-btn disabled">Previous</span>
                }

                @for (int i = Math.Max(1, Model.PageIndex - 2); i <= Math.Min(Model.TotalPages, Model.PageIndex + 2); i++)
                {
                    if (i == Model.PageIndex)
                    {
                        <span class="pagination-page active">@i</span>
                    }
                    else
                    {
                        <a class="pagination-page" asp-action="Products" asp-route-pageIndex="@i" asp-route-pageSize="@Model.PageSize">@i</a>
                    }
                }

                @if (Model.HasNextPage)
                {
                    <a class="pagination-btn" asp-action="Products" asp-route-pageIndex="@(Model.PageIndex + 1)" asp-route-pageSize="@Model.PageSize">Next</a>
                }
                else
                {
                    <span class="pagination-btn disabled">Next</span>
                }
            </div>
        </div>
    }
</div>