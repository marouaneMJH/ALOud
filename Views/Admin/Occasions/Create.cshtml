@model ALOud.DTOs.Occasions.CreateOccasionDto
@{
    ViewData["Title"] = "Create Occasion";
}

<div class="admin-page">
    <div class="admin-header">
        <div class="header-content">
            <a href="@Url.Action("Occasions")" class="back-link">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <polyline points="15 18 9 12 15 6"></polyline>
                </svg>
                Back to Occasions
            </a>
            <h1 class="admin-title">Create Occasion</h1>
        </div>
    </div>

    <div class="admin-form-container">
        <form asp-action="CreateOccasion" method="post">
            @Html.AntiForgeryToken()
            
            <div class="form-group">
                <label asp-for="Name" class="form-label required">Occasion Name</label>
                <input asp-for="Name" class="form-input" placeholder="e.g., Business, Casual, Evening, Romantic" />
                <span asp-validation-for="Name" class="form-error"></span>
            </div>
            
            <div class="form-actions">
                <a href="@Url.Action("Occasions")" class="btn btn-cancel">Cancel</a>
                <button type="submit" class="btn btn-primary">Create Occasion</button>
            </div>
        </form>
    </div>
</div>

@section Styles {
    <link rel="stylesheet" href="~/css/admin.css" />
}

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
