@model List<ALOud.DTOs.Categories.CategoryDetailsDto>

@{
    ViewData["Title"] = "Admin - Categories";
}

<style>
    .admin-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: var(--spacing-2xl) 0 var(--spacing-xl);
        border-bottom: 2px solid var(--color-accent);
        margin-bottom: var(--spacing-2xl);
    }

    .admin-title {
        font-family: var(--font-heading);
        font-size: 2.5rem;
        color: var(--color-primary);
        margin: 0;
        font-weight: 400;
        letter-spacing: -0.5px;
    }

    .admin-actions {
        display: flex;
        gap: var(--spacing-md);
    }

    .btn-primary-custom,
    .btn-secondary-custom {
        padding: var(--spacing-sm) var(--spacing-xl);
        font-family: var(--font-body);
        font-size: 0.875rem;
        font-weight: 500;
        text-decoration: none;
        text-transform: uppercase;
        letter-spacing: 1px;
        transition: all var(--transition-normal);
        display: inline-block;
        cursor: pointer;
    }

    .btn-primary-custom {
        background: var(--color-primary);
        color: var(--color-white);
        border: 2px solid var(--color-primary);
    }

    .btn-primary-custom:hover {
        background: transparent;
        color: var(--color-primary);
        transform: translateY(-2px);
    }

    .btn-secondary-custom {
        background: transparent;
        color: var(--color-primary);
        border: 2px solid var(--color-border);
    }

    .btn-secondary-custom:hover {
        background: var(--color-primary);
        color: var(--color-white);
        border-color: var(--color-primary);
        transform: translateY(-2px);
    }

    .alert-custom {
        background: #fee;
        border: 1px solid #c66;
        border-left: 4px solid #c66;
        color: #811;
        padding: var(--spacing-md) var(--spacing-lg);
        margin-bottom: var(--spacing-xl);
        font-family: var(--font-body);
    }

    .categories-table-wrapper {
        background: var(--color-white);
        border: 1px solid var(--color-border);
    }

    .categories-table {
        width: 100%;
        border-collapse: collapse;
    }

    .categories-table thead th {
        background: var(--color-background);
        padding: var(--spacing-md) var(--spacing-lg);
        text-align: left;
        font-family: var(--font-heading);
        font-size: 0.95rem;
        font-weight: 400;
        color: var(--color-text-secondary);
        text-transform: uppercase;
        letter-spacing: 1px;
        border-bottom: 2px solid var(--color-accent);
    }

    .categories-table tbody td {
        padding: var(--spacing-lg);
        border-bottom: 1px solid var(--color-border);
        vertical-align: middle;
    }

    .categories-table tbody tr {
        transition: background var(--transition-fast);
    }

    .categories-table tbody tr:hover {
        background: var(--color-background);
    }

    .category-name-cell {
        font-weight: 600;
        color: var(--color-primary);
        font-size: 1.05rem;
    }

    .badge-count {
        display: inline-block;
        background: var(--color-accent);
        color: var(--color-white);
        padding: var(--spacing-xs) var(--spacing-md);
        border-radius: 20px;
        font-size: 0.875rem;
        font-weight: 600;
    }

    .actions-cell {
        display: flex;
        gap: var(--spacing-sm);
        align-items: center;
        justify-content: flex-end;
    }

    .btn-table-action {
        padding: var(--spacing-xs) var(--spacing-md);
        font-size: 0.875rem;
        border: 1px solid var(--color-border);
        background: var(--color-white);
        color: var(--color-primary);
        text-decoration: none;
        transition: all var(--transition-fast);
        display: inline-block;
    }

    .btn-table-action:hover {
        background: var(--color-primary);
        color: var(--color-white);
        border-color: var(--color-primary);
    }

    .btn-table-delete {
        background: transparent;
        border: 1px solid #8b5a3c;
        color: #8b5a3c;
        padding: var(--spacing-xs) var(--spacing-md);
        font-size: 0.875rem;
        cursor: pointer;
        transition: all var(--transition-fast);
    }

    .btn-table-delete:hover {
        background: #8b5a3c;
        color: var(--color-white);
    }

    .btn-table-delete:disabled {
        opacity: 0.5;
        cursor: not-allowed;
        border-color: #ccc;
        color: #999;
    }

    .btn-table-delete:disabled:hover {
        background: transparent;
        color: #999;
    }
</style>

<div class="container">
    <div class="admin-header">
        <h1 class="admin-title">Categories</h1>
        <div class="admin-actions">
            <a class="btn-secondary-custom" asp-action="Index">Dashboard</a>
            <a class="btn-primary-custom" asp-action="CreateCategory">Create New Category</a>
        </div>
    </div>

    @if (TempData["Error"] != null)
    {
        <div class="alert-custom">
            @TempData["Error"]
        </div>
    }

    <div class="categories-table-wrapper">
        <table class="categories-table">
            <thead>
                <tr>
                    <th>Category Name</th>
                    <th style="text-align: center;">Product Count</th>
                    <th style="text-align: right;">Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var category in Model)
                {
                    <tr>
                        <td class="category-name-cell">@category.Name</td>
                        <td style="text-align: center;">
                            <span class="badge-count">@category.ProductCount</span>
                        </td>
                        <td>
                            <div class="actions-cell">
                                <a class="btn-table-action" asp-action="EditCategory" asp-route-id="@category.Id">Edit</a>
                                @if (category.ProductCount == 0)
                                {
                                    <form asp-action="DeleteCategory" asp-route-id="@category.Id" method="post" style="display:inline; margin:0;">
                                        @Html.AntiForgeryToken()
                                        <button class="btn-table-delete" type="submit" 
                                                onclick="return confirm('Are you sure you want to delete this category?')">Delete</button>
                                    </form>
                                }
                                else
                                {
                                    <button class="btn-table-delete" disabled title="Cannot delete category with products">Delete</button>
                                }
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
