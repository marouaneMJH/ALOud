@{
    ViewData["Title"] = "Stock Management";
    ViewData["ActiveNav"] = "Stock";
}

@section Styles {
<style>
    .page-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 2rem;
    }

    .page-header h1 {
        font-size: 1.75rem;
        font-weight: 700;
        font-family: var(--font-heading, 'Playfair Display', serif);
        color: var(--color-primary, #0b0b0b);
    }

    .page-header .breadcrumb-trail {
        font-size: 0.85rem;
        color: var(--text-muted, #6b7280);
    }

    /* ── Stats Grid ── */
    .stats-row {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
        gap: 1.25rem;
        margin-bottom: 2rem;
    }

    .stat-card {
        background: var(--card-bg, #fff);
        border: 1px solid var(--color-border, #e5e7eb);
        border-radius: 12px;
        padding: 1.25rem 1.5rem;
        box-shadow: 0 2px 8px rgba(0,0,0,0.06);
        transition: transform 0.2s ease, box-shadow 0.2s ease;
    }

    .stat-card:hover {
        transform: translateY(-3px);
        box-shadow: 0 6px 20px rgba(0,0,0,0.1);
    }

    .stat-card .icon {
        width: 42px;
        height: 42px;
        border-radius: 9px;
        display: flex;
        align-items: center;
        justify-content: center;
        margin-bottom: 0.75rem;
        font-size: 1.2rem;
    }

    .icon-gold   { background: var(--color-accent, #c9a24d); color: var(--color-primary, #0b0b0b); }
    .icon-dark   { background: var(--color-primary, #0b0b0b); color: #fff; }
    .icon-green  { background: rgba(34, 197, 94, 0.15); color: #16a34a; }
    .icon-red    { background: rgba(239, 68, 68, 0.12); color: #dc2626; }

    .stat-value {
        font-size: 2rem;
        font-weight: 700;
        font-family: var(--font-heading, 'Playfair Display', serif);
        color: var(--color-primary, #0b0b0b);
        line-height: 1;
    }

    .stat-label {
        font-size: 0.82rem;
        color: var(--text-muted, #6b7280);
        margin-top: 0.25rem;
    }

    /* ── Content Card ── */
    .content-card {
        background: var(--card-bg, #fff);
        border: 1px solid var(--color-border, #e5e7eb);
        border-radius: 12px;
        box-shadow: 0 2px 8px rgba(0,0,0,0.06);
        margin-bottom: 1.5rem;
        overflow: hidden;
    }

    .content-card .card-head {
        padding: 1.1rem 1.5rem;
        border-bottom: 1px solid var(--color-border, #e5e7eb);
        display: flex;
        justify-content: space-between;
        align-items: center;
    }

    .content-card .card-head h3 {
        font-size: 0.95rem;
        font-weight: 600;
        font-family: var(--font-heading, serif);
        color: var(--color-primary, #0b0b0b);
        margin: 0;
        display: flex;
        align-items: center;
        gap: 0.5rem;
    }

    .content-card .card-body {
        padding: 1.5rem;
    }

    /* ── Table ── */
    .stock-table {
        width: 100%;
        border-collapse: collapse;
        font-size: 0.88rem;
    }

    .stock-table th {
        text-align: left;
        padding: 0.7rem 1rem;
        font-size: 0.72rem;
        text-transform: uppercase;
        letter-spacing: 0.05em;
        color: var(--text-muted, #6b7280);
        border-bottom: 2px solid var(--color-border, #e5e7eb);
        font-weight: 600;
        white-space: nowrap;
    }

    .stock-table td {
        padding: 0.9rem 1rem;
        border-bottom: 1px solid var(--color-border, #e5e7eb);
        vertical-align: middle;
    }

    .stock-table tr:last-child td { border-bottom: none; }

    .stock-table tbody tr:hover { background: rgba(201, 162, 77, 0.04); }

    /* ── Badges ── */
    .badge-available {
        display: inline-flex;
        align-items: center;
        gap: 0.3rem;
        background: rgba(34, 197, 94, 0.1);
        color: #16a34a;
        border: 1px solid rgba(34, 197, 94, 0.25);
        border-radius: 20px;
        padding: 0.2rem 0.65rem;
        font-size: 0.76rem;
        font-weight: 600;
    }

    .badge-reserved {
        display: inline-flex;
        align-items: center;
        gap: 0.3rem;
        background: rgba(234, 179, 8, 0.1);
        color: #b45309;
        border: 1px solid rgba(234, 179, 8, 0.25);
        border-radius: 20px;
        padding: 0.2rem 0.65rem;
        font-size: 0.76rem;
        font-weight: 600;
    }

    .badge-low {
        background: rgba(239, 68, 68, 0.1);
        color: #dc2626;
        border-color: rgba(239, 68, 68, 0.25);
    }

    /* ── Product lookup ── */
    .lookup-form {
        display: flex;
        gap: 0.75rem;
        align-items: center;
        flex-wrap: wrap;
        margin-bottom: 1rem;
    }

    .lookup-input {
        flex: 1;
        min-width: 240px;
        padding: 0.65rem 1rem;
        border: 2px solid rgba(11, 11, 11, 0.1);
        border-radius: 8px;
        font-size: 0.88rem;
        transition: border-color 0.2s ease;
    }

    .lookup-input:focus {
        outline: none;
        border-color: var(--color-accent, #c9a24d);
        box-shadow: 0 0 0 3px rgba(201, 162, 77, 0.12);
    }

    .btn-lookup {
        padding: 0.65rem 1.25rem;
        background: var(--color-primary, #0b0b0b);
        color: white;
        border: none;
        border-radius: 8px;
        font-size: 0.88rem;
        font-weight: 600;
        cursor: pointer;
        transition: all 0.2s ease;
    }

    .btn-lookup:hover {
        background: var(--color-accent, #c9a24d);
        color: var(--color-primary, #0b0b0b);
    }

    .btn-danger-sm {
        padding: 0.4rem 0.85rem;
        background: transparent;
        color: #dc2626;
        border: 1px solid rgba(239, 68, 68, 0.35);
        border-radius: 6px;
        font-size: 0.78rem;
        font-weight: 600;
        cursor: pointer;
        transition: all 0.2s ease;
    }

    .btn-danger-sm:hover {
        background: rgba(239, 68, 68, 0.08);
        border-color: #dc2626;
    }

    /* Loading / empty */
    .loading-row, .empty-row {
        text-align: center;
        color: var(--text-muted, #6b7280);
        font-style: italic;
        font-size: 0.88rem;
        padding: 2rem;
    }

    /* ── Cleanup Banner ── */
    .cleanup-banner {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 1rem;
        background: linear-gradient(135deg, rgba(201, 162, 77, 0.07), transparent);
        border: 1px solid rgba(201, 162, 77, 0.2);
        border-radius: 10px;
        padding: 1rem 1.5rem;
        flex-wrap: wrap;
    }

    .cleanup-banner p {
        margin: 0;
        font-size: 0.88rem;
        color: var(--color-primary, #0b0b0b);
    }

    .cleanup-banner small {
        color: var(--text-muted, #6b7280);
    }

    .btn-cleanup {
        padding: 0.6rem 1.25rem;
        background: var(--color-accent, #c9a24d);
        color: var(--color-primary, #0b0b0b);
        border: none;
        border-radius: 8px;
        font-size: 0.85rem;
        font-weight: 600;
        cursor: pointer;
        transition: all 0.2s ease;
        white-space: nowrap;
    }

    .btn-cleanup:hover {
        background: #d4a350;
        transform: translateY(-1px);
        box-shadow: 0 4px 10px rgba(201, 162, 77, 0.3);
    }

    #cleanupResult {
        font-size: 0.82rem;
        font-weight: 600;
        margin-top: 0.4rem;
    }
</style>
}

<div class="page-header">
    <div>
        <h1><i class="bi bi-boxes me-2"></i>Stock Management</h1>
        <span class="breadcrumb-trail">Admin › Stock</span>
    </div>
    <div>
        <a href="@Url.RouteUrl("MvcAdminIndex")" class="btn btn-sm btn-outline-secondary">
            <i class="bi bi-arrow-left me-1"></i>Dashboard
        </a>
    </div>
</div>

<!-- Overview Stats -->
<div class="stats-row" id="statsRow">
    <div class="stat-card">
        <div class="icon icon-gold"><i class="bi bi-box-seam"></i></div>
        <div class="stat-value" id="statProducts">–</div>
        <div class="stat-label">Products Tracked</div>
    </div>
    <div class="stat-card">
        <div class="icon icon-green"><i class="bi bi-check-circle"></i></div>
        <div class="stat-value" id="statAvailable">–</div>
        <div class="stat-label">Total Available Units</div>
    </div>
    <div class="stat-card">
        <div class="icon icon-dark"><i class="bi bi-lock"></i></div>
        <div class="stat-value" id="statReserved">–</div>
        <div class="stat-label">Total Reserved Units</div>
    </div>
    <div class="stat-card">
        <div class="icon icon-red"><i class="bi bi-exclamation-triangle"></i></div>
        <div class="stat-value" id="statLow">–</div>
        <div class="stat-label">Low Stock Products</div>
    </div>
</div>

<!-- Product Stock Lookup -->
<div class="content-card">
    <div class="card-head">
        <h3><i class="bi bi-search"></i> Product Stock Lookup</h3>
    </div>
    <div class="card-body">
        <div class="lookup-form">
            <input type="text"
                   id="productIdInput"
                   class="lookup-input"
                   placeholder="Enter Product ID (GUID) to inspect stock details..." />
            <button class="btn-lookup" onclick="lookupProduct()">
                <i class="bi bi-search me-1"></i>Lookup
            </button>
        </div>
        <div id="lookupResult"></div>
    </div>
</div>

<!-- Active Reservations by Product -->
<div class="content-card">
    <div class="card-head">
        <h3><i class="bi bi-clock-history"></i> Active Reservations</h3>
        <button class="btn-lookup" style="font-size:0.8rem; padding: 0.4rem 0.9rem;" onclick="loadReservations()">
            <i class="bi bi-arrow-clockwise me-1"></i>Refresh
        </button>
    </div>
    <div class="card-body p-0">
        <table class="stock-table">
            <thead>
                <tr>
                    <th>Reservation ID</th>
                    <th>Checkout ID</th>
                    <th>Qty</th>
                    <th>Unit Price</th>
                    <th>Status</th>
                    <th>Reserved At</th>
                    <th>Expires At</th>
                </tr>
            </thead>
            <tbody id="reservationsBody">
                <tr><td colspan="7" class="loading-row"><i class="bi bi-hourglass-split me-2"></i>Enter a Product ID above and click "Lookup" to see reservations</td></tr>
            </tbody>
        </table>
    </div>
</div>

<!-- Maintenance -->
<div class="content-card">
    <div class="card-head">
        <h3><i class="bi bi-gear"></i> Maintenance</h3>
    </div>
    <div class="card-body">
        <div class="cleanup-banner">
            <div>
                <p><strong>Clean Up Expired Reservations</strong></p>
                <small>Releases stock held by abandoned or timed-out checkout sessions, freeing inventory for new orders.</small>
                <div id="cleanupResult"></div>
            </div>
            <button class="btn-cleanup" id="cleanupBtn" onclick="cleanupExpired()">
                <i class="bi bi-trash3 me-2"></i>Run Cleanup
            </button>
        </div>
    </div>
</div>

@section Scripts {
<script>
    // ── Product Lookup ─────────────────────────────────────
    async function lookupProduct() {
        const productId = document.getElementById('productIdInput').value.trim();
        const resultEl = document.getElementById('lookupResult');
        const reservationsBody = document.getElementById('reservationsBody');

        if (!productId) {
            resultEl.innerHTML = '<p class="text-danger small mt-1">Please enter a valid Product ID.</p>';
            return;
        }

        resultEl.innerHTML = '<p class="text-muted small mt-1"><i class="bi bi-hourglass-split"></i> Loading…</p>';

        try {
            const [stockRes, reservRes] = await Promise.all([
                fetch(`/api/v1/stock/${productId}/availability`),
                fetch(`/api/v1/stock/${productId}/reservations`)
            ]);

            if (!stockRes.ok) {
                resultEl.innerHTML = `<p class="text-danger small mt-1">Product not found or error fetching stock (HTTP ${stockRes.status}).</p>`;
                return;
            }

            const stockData = await stockRes.json();
            const stock = stockData.data || stockData;

            const lowThreshold = 5;
            const availQty = stock.availableQuantity ?? 0;
            const isLow = availQty <= lowThreshold;
            const badgeClass = availQty === 0 ? 'badge-low' : isLow ? 'badge-reserved' : 'badge-available';

            resultEl.innerHTML = `
                <div style="margin-top:1rem; padding:1rem; background:#f9f9f9; border-radius:10px; border:1px solid rgba(0,0,0,0.07)">
                    <div style="display:flex; gap:1.5rem; flex-wrap:wrap; margin-bottom:0.75rem;">
                        <div><strong>Available:</strong> <span class="${badgeClass}" style="margin-left:0.25rem">${availQty} units</span></div>
                        <div><strong>Reserved:</strong> ${stock.totalReserved ?? 0} units</div>
                        <div><strong>Active Reservations:</strong> ${stock.activeReservations ?? 0}</div>
                    </div>
                </div>`;

            // Load reservations
            if (reservRes.ok) {
                const resData = await reservRes.json();
                const reservations = resData.data || resData || [];
                renderReservations(reservations);
            }

        } catch (err) {
            resultEl.innerHTML = '<p class="text-danger small mt-1">Failed to fetch stock data. Check console for details.</p>';
            console.error('Stock lookup error:', err);
        }
    }

    function renderReservations(reservations) {
        const body = document.getElementById('reservationsBody');

        if (!reservations || reservations.length === 0) {
            body.innerHTML = '<tr><td colspan="7" class="empty-row">No active reservations for this product.</td></tr>';
            return;
        }

        body.innerHTML = reservations.map(r => `
            <tr>
                <td><code style="font-size:0.72rem">${r.id?.substring(0, 8) ?? '–'}…</code></td>
                <td><code style="font-size:0.72rem">${r.checkoutId?.substring(0, 8) ?? '–'}…</code></td>
                <td><strong>${r.quantity ?? 0}</strong></td>
                <td>${r.unitPrice != null ? '$' + parseFloat(r.unitPrice).toFixed(2) : '–'}</td>
                <td><span class="badge-reserved">${r.status ?? 'unknown'}</span></td>
                <td>${r.reservedAt ? new Date(r.reservedAt).toLocaleString() : '–'}</td>
                <td>${r.expiresAt ? new Date(r.expiresAt).toLocaleString() : '–'}</td>
            </tr>`
        ).join('');
    }

    function loadReservations() {
        const productId = document.getElementById('productIdInput').value.trim();
        if (productId) lookupProduct();
    }

    // ── Expired Cleanup ────────────────────────────────────
    async function cleanupExpired() {
        const btn = document.getElementById('cleanupBtn');
        const resultEl = document.getElementById('cleanupResult');
        btn.disabled = true;
        btn.innerHTML = '<i class="bi bi-hourglass-split me-2"></i>Running…';

        try {
            const res = await fetch('/api/v1/stock/cleanup-expired', { method: 'POST' });
            const data = await res.json();
            const cleaned = (data.data || data).reservationsCleaned ?? 0;

            resultEl.innerHTML = `<span style="color:#16a34a"><i class="bi bi-check-circle me-1"></i>Done — ${cleaned} expired reservation${cleaned !== 1 ? 's' : ''} removed.</span>`;
        } catch (err) {
            resultEl.innerHTML = `<span style="color:#dc2626"><i class="bi bi-x-circle me-1"></i>Cleanup failed. Check console.</span>`;
            console.error('Cleanup error:', err);
        } finally {
            btn.disabled = false;
            btn.innerHTML = '<i class="bi bi-trash3 me-2"></i>Run Cleanup';
        }
    }

    // ── Initial stat placeholders ──────────────────────────
    // Stats would require a dedicated aggregation endpoint — show friendly fallback
    document.getElementById('statProducts').textContent = 'Use →';
    document.getElementById('statAvailable').textContent = 'Lookup';
    document.getElementById('statReserved').textContent = 'Above';
    document.getElementById('statLow').textContent = '↑';
</script>
}
