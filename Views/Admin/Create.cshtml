@model ALOud.DTOs.Products.CreateProductDto

@{
    ViewData["Title"] = "Create Product";
}

<div class="container mt-4" style="max-width:800px;">
    <h2>Create Product</h2>

    <form asp-controller="Admin" asp-action="Create" method="post">
    @Html.AntiForgeryToken()
    <div class="mb-3">
        <label class="form-label">Name</label>
        <input asp-for="Name" class="form-control" />
    </div>
    <div class="mb-3">
        <label class="form-label">Description</label>
        <textarea asp-for="Description" class="form-control"></textarea>
    </div>
    <div class="mb-3">
        <label class="form-label">Price</label>
        <input asp-for="Price" class="form-control" />
    </div>
    <div class="mb-3">
        <label class="form-label">Stock</label>
        <input asp-for="Stock" class="form-control" />
    </div>
    <div class="mb-3">
        <label class="form-label">ImageUrl</label>
        <input asp-for="ImageUrl" class="form-control" />
    </div>
    <div class="mb-3">
        <label class="form-label">Category</label>
        <select asp-for="CategoryId" class="form-control">
            <option value="">-- Select Category --</option>
            @foreach (var category in ViewBag.Categories)
            {
                <option value="@category.Id">@category.Name</option>
            }
        </select>
    </div>

    <button class="btn btn-primary">Save</button>
    <a class="btn btn-secondary" asp-controller="Admin" asp-action="Index">Cancel</a>
</form>
</div>