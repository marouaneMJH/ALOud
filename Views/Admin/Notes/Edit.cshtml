@model ALOud.DTOs.Notes.UpdateNoteDto
@{
    ViewData["Title"] = "Edit Note";
}

<div class="admin-page">
    <div class="admin-header">
        <div class="header-content">
            <a href="@Url.Action("Notes")" class="back-link">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <polyline points="15 18 9 12 15 6"></polyline>
                </svg>
                Back to Notes
            </a>
            <h1 class="admin-title">Edit Note</h1>
        </div>
    </div>

    <div class="admin-form-container">
        <form asp-action="EditNote" asp-route-id="@Model.Id" method="post">
            @Html.AntiForgeryToken()
            <input type="hidden" asp-for="Id" />
            
            <div class="form-group">
                <label asp-for="Name" class="form-label required">Note Name</label>
                <input asp-for="Name" class="form-input" placeholder="e.g., Bergamot, Rose, Sandalwood" />
                <span asp-validation-for="Name" class="form-error"></span>
            </div>
            
            <div class="form-group">
                <label asp-for="Category" class="form-label">Category</label>
                <select asp-for="Category" class="form-select">
                    <option value="">Select category</option>
                    <option value="Top">Top Note</option>
                    <option value="Heart">Heart Note</option>
                    <option value="Base">Base Note</option>
                </select>
                <span asp-validation-for="Category" class="form-error"></span>
            </div>
            
            <div class="form-group">
                <label asp-for="Description" class="form-label">Description</label>
                <textarea asp-for="Description" class="form-textarea" rows="4" placeholder="Describe this note..."></textarea>
                <span asp-validation-for="Description" class="form-error"></span>
            </div>
            
            <div class="form-actions">
                <a href="@Url.Action("Notes")" class="btn btn-cancel">Cancel</a>
                <button type="submit" class="btn btn-primary">Update Note</button>
            </div>
        </form>
    </div>
</div>


@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
