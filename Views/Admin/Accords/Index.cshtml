@model ViewModels.PaginatedList<ALOud.DTOs.Accords.AccordDto>
@{
    ViewData["Title"] = "Manage Accords";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";

}

<div class="admin-page">
    <div class="admin-header">
        <div class="header-content">
            <h1 class="admin-title">Accords</h1>
            <p class="admin-subtitle">Manage fragrance accords and combinations</p>
        </div>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success">@TempData["Success"]</div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="alert alert-error">@TempData["Error"]</div>
    }

    <div class="admin-filter-bar">
        <form method="get" class="filter-form">
            <div class="search-input-wrapper">
                <svg class="search-icon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <circle cx="11" cy="11" r="8"></circle>
                    <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
                </svg>
                <input type="text" name="searchTerm" value="@ViewBag.SearchTerm" placeholder="Search accords..." class="search-input" />
            </div>
            <button type="submit" class="btn btn-filter">Search</button>
        </form>
        <a href="@Url.Action("CreateAccord")" class="btn btn-primary">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <line x1="12" y1="5" x2="12" y2="19"></line>
                <line x1="5" y1="12" x2="19" y2="12"></line>
            </svg>
            Add Accord
        </a>
    </div>

    <div class="admin-table-container">
        <table class="admin-table">
            <thead>
                <tr>
                    <th>Name</th>
                    <th>Description</th>
                    <th style="width: 120px; text-align: center;">Actions</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.Items.Any())
                {
                    @foreach (var accord in Model.Items)
                    {
                        <tr>
                            <td><strong>@accord.Name</strong></td>
                            <td class="text-truncate">@(accord.Description ?? "-")</td>
                            <td>
                                <div class="action-buttons">
                                    <a href="@Url.Action("EditAccord", new { id = accord.Id })" class="btn-action btn-edit" title="Edit">
                                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                            <path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"></path>
                                            <path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"></path>
                                        </svg>
                                    </a>
                                    <button type="button" class="btn-action btn-delete" title="Delete"
                                            onclick="openDeleteModal('@Url.Action("DeleteAccord", new { id = accord.Id })', '@accord.Name')">
                                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                            <polyline points="3 6 5 6 21 6"></polyline>
                                            <path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"></path>
                                        </svg>
                                    </button>
                                </div>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="3" class="empty-state">
                            <div class="empty-message">
                                <span class="empty-icon">🎵</span>
                                <p>No accords found</p>
                                <a href="@Url.Action("CreateAccord")" class="btn btn-primary">Add Accord</a>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    @if (Model.TotalPages > 1)
    {
        <div class="admin-pagination">
            <div class="pagination-info">Showing page @Model.PageIndex of @Model.TotalPages</div>
            <div class="pagination-controls">
                @if (Model.HasPreviousPage)
                {
                    <a href="@Url.Action("Accords", new { pageIndex = Model.PageIndex - 1, searchTerm = ViewBag.SearchTerm })" class="pagination-btn">← Prev</a>
                }
                @if (Model.HasNextPage)
                {
                    <a href="@Url.Action("Accords", new { pageIndex = Model.PageIndex + 1, searchTerm = ViewBag.SearchTerm })" class="pagination-btn">Next →</a>
                }
            </div>
        </div>
    }
</div>

@await Html.PartialAsync("Components/_AdminDeleteModal")

@section Styles {
    <link rel="stylesheet" href="~/css/admin.css" />
}
