@model ALOud.DTOs.Accords.UpdateAccordDto
@{
    ViewData["Title"] = "Edit Accord";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";

}

<div class="admin-page">
    <div class="admin-header">
        <div class="header-content">
            <a href="@Url.Action("Accords")" class="back-link">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <polyline points="15 18 9 12 15 6"></polyline>
                </svg>
                Back to Accords
            </a>
            <h1 class="admin-title">Edit Accord</h1>
        </div>
    </div>

    <div class="admin-form-container">
        <form asp-action="EditAccord" asp-route-id="@Model.Id" method="post">
            @Html.AntiForgeryToken()
            <input type="hidden" asp-for="Id" />
            
            <div class="form-group">
                <label asp-for="Name" class="form-label required">Accord Name</label>
                <input asp-for="Name" class="form-input" placeholder="e.g., Musky, Powdery, Citrus" />
                <span asp-validation-for="Name" class="form-error"></span>
            </div>
            
            <div class="form-group">
                <label asp-for="Description" class="form-label">Description</label>
                <textarea asp-for="Description" class="form-textarea" rows="4" placeholder="Describe this accord..."></textarea>
                <span asp-validation-for="Description" class="form-error"></span>
            </div>
            
            <div class="form-actions">
                <a href="@Url.Action("Accords")" class="btn btn-cancel">Cancel</a>
                <button type="submit" class="btn btn-primary">Update Accord</button>
            </div>
        </form>
    </div>
</div>

@section Styles {
    <link rel="stylesheet" href="~/css/admin.css" />
}

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
