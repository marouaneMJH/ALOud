@model ALOud.DTOs.Seasons.UpdateSeasonDto
@{
    ViewData["Title"] = "Edit Season";
}

<div class="admin-page">
    <div class="admin-header">
        <div class="header-content">
            <a href="@Url.Action("Seasons")" class="back-link">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <polyline points="15 18 9 12 15 6"></polyline>
                </svg>
                Back to Seasons
            </a>
            <h1 class="admin-title">Edit Season</h1>
        </div>
    </div>

    <div class="admin-form-container">
        <form asp-action="EditSeason" asp-route-id="@Model.Id" method="post">
            @Html.AntiForgeryToken()
            <input type="hidden" asp-for="Id" />
            
            <div class="form-group">
                <label asp-for="Name" class="form-label required">Season Name</label>
                <input asp-for="Name" class="form-input" placeholder="e.g., Spring, Summer, Fall, Winter" />
                <span asp-validation-for="Name" class="form-error"></span>
            </div>
            
            <div class="form-actions">
                <a href="@Url.Action("Seasons")" class="btn btn-cancel">Cancel</a>
                <button type="submit" class="btn btn-primary">Update Season</button>
            </div>
        </form>
    </div>
</div>

@section Styles {
    <link rel="stylesheet" href="~/css/admin.css" />
}

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
