@model ALOud.DTOs.Perfumes.CreatePerfumeDto
@{
    ViewData["Title"] = "Create Perfume";
    var brands = ViewBag.Brands as List<ALOud.DTOs.Brands.BrandSelectDto>;
    var families = ViewBag.Families as List<ALOud.DTOs.Families.FamilySelectDto>;
    var notes = ViewBag.Notes as List<ALOud.DTOs.Notes.NoteSelectDto>;
    var accords = ViewBag.Accords as List<ALOud.DTOs.Accords.AccordSelectDto>;
    var tags = ViewBag.Tags as List<ALOud.DTOs.Tags.TagSelectDto>;
    var seasons = ViewBag.Seasons as List<ALOud.DTOs.Seasons.SeasonSelectDto>;
    var occasions = ViewBag.Occasions as List<ALOud.DTOs.Occasions.OccasionSelectDto>;
}

<div class="admin-page">
    <div class="admin-header">
        <div class="header-content">
            <a href="@Url.Action("Perfumes")" class="back-link">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <polyline points="15 18 9 12 15 6"></polyline>
                </svg>
                Back to Perfumes
            </a>
            <h1 class="admin-title">Create Perfume</h1>
        </div>
    </div>

    <div class="admin-form-container wide">
        <form asp-action="CreatePerfume" method="post">
            @Html.AntiForgeryToken()
            
            <div class="form-section">
                <h3 class="section-title">Basic Information</h3>
                
                <div class="form-row">
                    <div class="form-group">
                        <label asp-for="Name" class="form-label required">Perfume Name</label>
                        <input asp-for="Name" class="form-input" placeholder="Enter perfume name" />
                        <span asp-validation-for="Name" class="form-error"></span>
                    </div>
                    
                    <div class="form-group">
                        <label asp-for="BrandId" class="form-label required">Brand</label>
                        <select asp-for="BrandId" class="form-select">
                            <option value="">Select a brand</option>
                            @if (brands != null)
                            {
                                @foreach (var brand in brands)
                                {
                                    <option value="@brand.Id">@brand.Name</option>
                                }
                            }
                        </select>
                        <span asp-validation-for="BrandId" class="form-error"></span>
                    </div>
                </div>

                <div class="form-row">
                    <div class="form-group">
                        <label asp-for="GenderProfile" class="form-label">Gender Profile</label>
                        <select asp-for="GenderProfile" class="form-select">
                            <option value="">Select gender profile</option>
                            <option value="Masculine">Masculine</option>
                            <option value="Feminine">Feminine</option>
                            <option value="Unisex">Unisex</option>
                        </select>
                    </div>

                    <div class="form-group">
                        <label asp-for="PriceRange" class="form-label">Price Range</label>
                        <select asp-for="PriceRange" class="form-select">
                            <option value="">Select price range</option>
                            <option value="Budget">Budget ($)</option>
                            <option value="Mid-range">Mid-range ($$)</option>
                            <option value="Premium">Premium ($$$)</option>
                            <option value="Luxury">Luxury ($$$$)</option>
                        </select>
                    </div>
                </div>

                <div class="form-row">
                    <div class="form-group">
                        <label asp-for="Price" class="form-label">Price</label>
                        <input asp-for="Price" type="number" step="0.01" min="0" class="form-input" placeholder="Enter price" />
                        <span asp-validation-for="Price" class="form-error"></span>
                    </div>

                    <div class="form-group">
                        <label asp-for="StockQuantity" class="form-label">Stock Quantity</label>
                        <input asp-for="StockQuantity" type="number" min="0" class="form-input" placeholder="Enter stock quantity" />
                        <span asp-validation-for="StockQuantity" class="form-error"></span>
                    </div>

                    <div class="form-group">
                        <label asp-for="ImageUrl" class="form-label">Image URL</label>
                        <input asp-for="ImageUrl" class="form-input" placeholder="Enter image URL" />
                        <span asp-validation-for="ImageUrl" class="form-error"></span>
                    </div>
                </div>

                <div class="form-group">
                    <label asp-for="Description" class="form-label">Description</label>
                    <textarea asp-for="Description" class="form-input" rows="4" placeholder="Enter perfume description"></textarea>
                    <span asp-validation-for="Description" class="form-error"></span>
                </div>
            </div>

            <div class="form-section">
                <h3 class="section-title">Characteristics</h3>
                
                <div class="form-row three-cols">
                    <div class="form-group">
                        <label asp-for="Intensity" class="form-label">Intensity</label>
                        <select asp-for="Intensity" class="form-select">
                            <option value="">Select intensity</option>
                            <option value="Light">Light</option>
                            <option value="Moderate">Moderate</option>
                            <option value="Strong">Strong</option>
                            <option value="Very Strong">Very Strong</option>
                        </select>
                    </div>

                    <div class="form-group">
                        <label asp-for="Longevity" class="form-label">Longevity</label>
                        <select asp-for="Longevity" class="form-select">
                            <option value="">Select longevity</option>
                            <option value="1-2 hours">1-2 hours</option>
                            <option value="3-4 hours">3-4 hours</option>
                            <option value="5-6 hours">5-6 hours</option>
                            <option value="7-8 hours">7-8 hours</option>
                            <option value="8+ hours">8+ hours</option>
                        </select>
                    </div>

                    <div class="form-group">
                        <label asp-for="Sillage" class="form-label">Sillage</label>
                        <select asp-for="Sillage" class="form-select">
                            <option value="">Select sillage</option>
                            <option value="Intimate">Intimate</option>
                            <option value="Moderate">Moderate</option>
                            <option value="Strong">Strong</option>
                            <option value="Enormous">Enormous</option>
                        </select>
                    </div>
                </div>
            </div>

            <div class="form-section">
                <h3 class="section-title">Classifications</h3>
                
                <div class="form-row">
                    <div class="form-group">
                        <label class="form-label">Families</label>
                        <div class="multi-select-container">
                            @if (families != null)
                            {
                                @foreach (var family in families)
                                {
                                    <label class="multi-select-option">
                                        <input type="checkbox" name="FamilyIds" value="@family.Id" />
                                        @family.Name
                                    </label>
                                }
                            }
                        </div>
                    </div>

                    <div class="form-group">
                        <label class="form-label">Tags</label>
                        <div class="multi-select-container">
                            @if (tags != null)
                            {
                                @foreach (var tag in tags)
                                {
                                    <label class="multi-select-option">
                                        <input type="checkbox" name="TagIds" value="@tag.Id" />
                                        @tag.Name
                                    </label>
                                }
                            }
                        </div>
                    </div>
                </div>

                <div class="form-row">
                    <div class="form-group">
                        <label class="form-label">Seasons</label>
                        <div class="multi-select-container horizontal">
                            @if (seasons != null)
                            {
                                @foreach (var season in seasons)
                                {
                                    <label class="multi-select-option">
                                        <input type="checkbox" name="SeasonIds" value="@season.Id" />
                                        @season.Name
                                    </label>
                                }
                            }
                        </div>
                    </div>

                    <div class="form-group">
                        <label class="form-label">Occasions</label>
                        <div class="multi-select-container">
                            @if (occasions != null)
                            {
                                @foreach (var occasion in occasions)
                                {
                                    <label class="multi-select-option">
                                        <input type="checkbox" name="OccasionIds" value="@occasion.Id" />
                                        @occasion.Name
                                    </label>
                                }
                            }
                        </div>
                    </div>
                </div>
            </div>

            <div class="form-actions">
                <a href="@Url.Action("Perfumes")" class="btn btn-cancel">Cancel</a>
                <button type="submit" class="btn btn-primary">Create Perfume</button>
            </div>
        </form>
    </div>
</div>

@section Styles {
    <link rel="stylesheet" href="~/css/admin.css" />
    <style>
        .admin-form-container.wide {
            max-width: 1000px;
        }
        .form-section {
            margin-bottom: var(--spacing-xl);
            padding-bottom: var(--spacing-xl);
            border-bottom: 1px solid var(--color-border);
        }
        .form-section:last-of-type {
            border-bottom: none;
        }
        .section-title {
            font-family: var(--font-heading);
            font-size: 1.125rem;
            font-weight: 500;
            color: var(--color-primary);
            margin-bottom: var(--spacing-lg);
        }
        .form-row.three-cols {
            grid-template-columns: repeat(3, 1fr);
        }
        .multi-select-container.horizontal {
            display: flex;
            flex-wrap: wrap;
            gap: var(--spacing-sm);
        }
        .multi-select-container.horizontal .multi-select-option {
            border: none;
            padding: var(--spacing-xs) var(--spacing-md);
            background: var(--color-bg);
        }
    </style>
}

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
