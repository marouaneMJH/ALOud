@model ViewModels.PaginatedList<ALOud.DTOs.Perfumes.PerfumeDto>
@inject Microsoft.Extensions.Configuration.IConfiguration Configuration

@{
    ViewData["Title"] = "Manage Perfumes";
    ViewData["ActiveNav"] = "Perfumes";


    var brands = ViewBag.Brands as List<ALOud.DTOs.Brands.BrandSelectDto>;
    var families = ViewBag.Families as List<ALOud.DTOs.Families.FamilySelectDto>;
        var fallback = Configuration["Images:FallbackUrl"];
}

<div class="admin-page">
    <div class="admin-header">
        <div class="header-content">
            <h1 class="admin-title">Perfumes</h1>
            <p class="admin-subtitle">Manage your perfume catalog</p>
        </div>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success">@TempData["Success"]</div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="alert alert-error">@TempData["Error"]</div>
    }

    <div class="admin-filter-bar">
        <form method="get" class="filter-form">
            <div class="search-input-wrapper">
                <svg class="search-icon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <circle cx="11" cy="11" r="8"></circle>
                    <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
                </svg>
                <input type="text" name="searchTerm" value="@ViewBag.SearchTerm" placeholder="Search perfumes..." class="search-input" />
            </div>
            
            <select name="brandId" class="filter-select">
                <option value="">All Brands</option>
                @if (brands != null)
                {
                    @foreach (var brand in brands)
                    {
                        <option value="@brand.Id" selected="@(ViewBag.BrandId?.ToString() == brand.Id.ToString())">@brand.Name</option>
                    }
                }
            </select>

            <select name="familyId" class="filter-select">
                <option value="">All Families</option>
                @if (families != null)
                {
                    @foreach (var family in families)
                    {
                        <option value="@family.Id" selected="@(ViewBag.FamilyId?.ToString() == family.Id.ToString())">@family.Name</option>
                    }
                }
            </select>

            <select name="genderProfile" class="filter-select">
                <option value="">All Genders</option>
                <option value="Masculine" selected="@(ViewBag.GenderProfile == "Masculine")">Masculine</option>
                <option value="Feminine" selected="@(ViewBag.GenderProfile == "Feminine")">Feminine</option>
                <option value="Unisex" selected="@(ViewBag.GenderProfile == "Unisex")">Unisex</option>
            </select>

            <button type="submit" class="btn btn-filter">Filter</button>
            <a href="@Url.Action("Perfumes")" class="btn btn-reset">Reset</a>
        </form>
        <a href="@Url.Action("CreatePerfume")" class="btn btn-primary">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <line x1="12" y1="5" x2="12" y2="19"></line>
                <line x1="5" y1="12" x2="19" y2="12"></line>
            </svg>
            Add Perfume
        </a>
    </div>

    <div class="admin-table-container">
        <table class="admin-table">
            <thead>
                <tr>
                    <th>Perfume</th>
                    <th>Brand</th>
                    <th>Gender</th>
                    <th>Price</th>
                    <th>Intensity</th>
                    <th style="width: 150px; text-align: center;">Actions</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.Items.Any())
                {
                    @foreach (var perfume in Model.Items)
                    {
                        <tr>
                            <td>
                                             <div class="d-flex align-items-center">
                                            @if (!string.IsNullOrEmpty(perfume.ImageUrl))
                                            {
                                                <img src="@perfume.ImageUrl" class="perfume-img me-3" alt="@perfume.Name"/>
                                            }
                                            else
                                            {
                                                <div class="perfume-img me-3 d-flex align-items-center justify-content-center text-white">
                                                    <i class="bi bi-droplet"></i>
                                                </div>
                                            }
                                            <strong>@perfume.Name</strong>
                                        </div>
                            </td>
                            <td>@perfume.BrandName</td>
                            <td>
                                @if (!string.IsNullOrEmpty(perfume.GenderProfile))
                                {
                                    <div class="badge badge-@perfume.GenderProfile.ToLower()">@perfume.GenderProfile</div>
                                }
                                else
                                {
                                    <span class="text-muted">-</span>
                                }
                            </td>
                            <td>@(perfume.Price > 0 ? $"{perfume.Price.ToString("F2")} MAD " : "-")</td>
                            <td>@(perfume.Intensity ?? "-")</td>
                            <td>
                                <div class="action-buttons">
                                    <a href="@Url.Action("PerfumeDetails", new { id = perfume.Id })" class="btn-action btn-view" title="View Details">
                                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                            <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"></path>
                                            <circle cx="12" cy="12" r="3"></circle>
                                        </svg>
                                    </a>
                                    <a href="@Url.Action("EditPerfume", new { id = perfume.Id })" class="btn-action btn-edit" title="Edit">
                                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                            <path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"></path>
                                            <path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"></path>
                                        </svg>
                                    </a>
                                    <button type="button" class="btn-action btn-delete" title="Delete"
                                            onclick="openDeleteModal('@Url.Action("DeletePerfume", new { id = perfume.Id })', '@perfume.Name')">
                                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                            <polyline points="3 6 5 6 21 6"></polyline>
                                            <path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"></path>
                                        </svg>
                                    </button>
                                </div>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="6" class="empty-state">
                            <div class="empty-message">
                                <span class="empty-icon">🌸</span>
                                <p>No perfumes found</p>
                                <a href="@Url.Action("CreatePerfume")" class="btn btn-primary">Add Your First Perfume</a>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    @if (Model.TotalPages > 1)
    {
        <div class="admin-pagination">
            <div class="pagination-info">
                Showing page @Model.PageIndex of @Model.TotalPages (@Model.TotalCount total)
            </div>
            <div class="pagination-controls">
                @if (Model.HasPreviousPage)
                {
                    <a href="@Url.Action("Perfumes", new { pageIndex = Model.PageIndex - 1, searchTerm = ViewBag.SearchTerm, brandId = ViewBag.BrandId, familyId = ViewBag.FamilyId, genderProfile = ViewBag.GenderProfile })" class="pagination-btn">← Prev</a>
                }
                @if (Model.HasNextPage)
                {
                    <a href="@Url.Action("Perfumes", new { pageIndex = Model.PageIndex + 1, searchTerm = ViewBag.SearchTerm, brandId = ViewBag.BrandId, familyId = ViewBag.FamilyId, genderProfile = ViewBag.GenderProfile })" class="pagination-btn">Next →</a>
                }
            </div>
        </div>
    }
</div>

@await Html.PartialAsync("Components/_AdminDeleteModal")

