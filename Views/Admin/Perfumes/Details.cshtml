@model ALOud.DTOs.Perfumes.PerfumeDetailsDto
@{
    ViewData["Title"] = Model.Name;
}

<div class="admin-page">
    <div class="admin-header">
        <div class="header-content">
            <a href="@Url.Action("Perfumes")" class="back-link">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <polyline points="15 18 9 12 15 6"></polyline>
                </svg>
                Back to Perfumes
            </a>
            <h1 class="admin-title">@Model.Name</h1>
            <p class="admin-subtitle">by @Model.BrandName</p>
        </div>
        <div class="header-actions">
            <a href="@Url.Action("EditPerfume", new { id = Model.Id })" class="btn btn-primary">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"></path>
                    <path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"></path>
                </svg>
                Edit
            </a>
        </div>
    </div>

    <div class="details-grid">
        <div class="details-card">
            <h3 class="card-title">Basic Information</h3>
            <div class="detail-row">
                <span class="detail-label">Brand</span>
                <span class="detail-value">@Model.BrandName</span>
            </div>
            <div class="detail-row">
                <span class="detail-label">Gender Profile</span>
                <span class="detail-value">
                    @if (!string.IsNullOrEmpty(Model.GenderProfile))
                    {
                        <span class="badge badge-@Model.GenderProfile.ToLower()">@Model.GenderProfile</span>
                    }
                    else
                    {
                        <span class="text-muted">Not specified</span>
                    }
                </span>
            </div>
            <div class="detail-row">
                <span class="detail-label">Price Range</span>
                <span class="detail-value">@(Model.PriceRange ?? "Not specified")</span>
            </div>
        </div>

        <div class="details-card">
            <h3 class="card-title">Characteristics</h3>
            <div class="detail-row">
                <span class="detail-label">Intensity</span>
                <span class="detail-value">@(Model.Intensity ?? "Not specified")</span>
            </div>
            <div class="detail-row">
                <span class="detail-label">Longevity</span>
                <span class="detail-value">@(Model.Longevity ?? "Not specified")</span>
            </div>
            <div class="detail-row">
                <span class="detail-label">Sillage</span>
                <span class="detail-value">@(Model.Sillage ?? "Not specified")</span>
            </div>
        </div>

        <div class="details-card">
            <h3 class="card-title">Families</h3>
            @if (Model.Families.Any())
            {
                <div class="tag-list">
                    @foreach (var family in Model.Families)
                    {
                        <span class="tag">@family</span>
                    }
                </div>
            }
            else
            {
                <p class="text-muted">No families assigned</p>
            }
        </div>

        <div class="details-card">
            <h3 class="card-title">Notes</h3>
            @if (Model.Notes.Any())
            {
                <div class="notes-list">
                    @foreach (var note in Model.Notes)
                    {
                        <div class="note-item">
                            <span class="note-name">@note.NoteName</span>
                            @if (!string.IsNullOrEmpty(note.NoteLevel))
                            {
                                <span class="note-level badge">@note.NoteLevel</span>
                            }
                        </div>
                    }
                </div>
            }
            else
            {
                <p class="text-muted">No notes assigned</p>
            }
        </div>

        <div class="details-card">
            <h3 class="card-title">Accords</h3>
            @if (Model.Accords.Any())
            {
                <div class="accords-list">
                    @foreach (var accord in Model.Accords)
                    {
                        <div class="accord-item">
                            <span class="accord-name">@accord.AccordName</span>
                            @if (!string.IsNullOrEmpty(accord.Intensity))
                            {
                                <span class="accord-intensity badge">@accord.Intensity</span>
                            }
                        </div>
                    }
                </div>
            }
            else
            {
                <p class="text-muted">No accords assigned</p>
            }
        </div>

        <div class="details-card">
            <h3 class="card-title">Tags</h3>
            @if (Model.Tags.Any())
            {
                <div class="tag-list">
                    @foreach (var tag in Model.Tags)
                    {
                        <span class="tag">@tag</span>
                    }
                </div>
            }
            else
            {
                <p class="text-muted">No tags assigned</p>
            }
        </div>

        <div class="details-card">
            <h3 class="card-title">Seasons</h3>
            @if (Model.Seasons.Any())
            {
                <div class="tag-list">
                    @foreach (var season in Model.Seasons)
                    {
                        <span class="tag tag-season">@season</span>
                    }
                </div>
            }
            else
            {
                <p class="text-muted">No seasons assigned</p>
            }
        </div>

        <div class="details-card">
            <h3 class="card-title">Occasions</h3>
            @if (Model.Occasions.Any())
            {
                <div class="tag-list">
                    @foreach (var occasion in Model.Occasions)
                    {
                        <span class="tag tag-occasion">@occasion</span>
                    }
                </div>
            }
            else
            {
                <p class="text-muted">No occasions assigned</p>
            }
        </div>
    </div>
</div>

@section Styles {
    <link rel="stylesheet" href="~/css/admin.css" />
    <style>
        .details-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
            gap: var(--spacing-lg);
        }
        .details-card {
            background: var(--color-white);
            border: 1px solid var(--color-border);
            padding: var(--spacing-lg);
        }
        .card-title {
            font-family: var(--font-heading);
            font-size: 1rem;
            font-weight: 500;
            color: var(--color-primary);
            margin-bottom: var(--spacing-md);
            padding-bottom: var(--spacing-sm);
            border-bottom: 1px solid var(--color-border);
        }
        .detail-row {
            display: flex;
            justify-content: space-between;
            padding: var(--spacing-sm) 0;
            border-bottom: 1px solid var(--color-border);
        }
        .detail-row:last-child {
            border-bottom: none;
        }
        .detail-label {
            color: var(--color-text-secondary);
            font-size: 0.875rem;
        }
        .detail-value {
            font-weight: 500;
        }
        .tag-list {
            display: flex;
            flex-wrap: wrap;
            gap: var(--spacing-xs);
        }
        .tag {
            display: inline-block;
            padding: var(--spacing-xs) var(--spacing-sm);
            background: var(--color-bg);
            border: 1px solid var(--color-border);
            font-size: 0.75rem;
        }
        .tag-season {
            background: #e0f2fe;
            border-color: #7dd3fc;
        }
        .tag-occasion {
            background: #fef3c7;
            border-color: #fcd34d;
        }
        .notes-list, .accords-list {
            display: flex;
            flex-direction: column;
            gap: var(--spacing-sm);
        }
        .note-item, .accord-item {
            display: flex;
            justify-content: space-between;
            align-items: center;
            padding: var(--spacing-xs) 0;
        }
        .header-actions {
            margin-left: auto;
        }
        .admin-header {
            display: flex;
            align-items: flex-start;
        }
    </style>
}
