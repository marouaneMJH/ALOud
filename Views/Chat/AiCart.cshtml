@{
    ViewData["Title"] = "AI Cart Assistant";
    // Uses the authenticated AI cart endpoint
    string aiCartApiUrl = "/api/v1/ai/cart/chat";
}

<div class="container py-5">
    <div class="ai-cart-header">
        <div class="ai-cart-badge">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M12 2L2 7l10 5 10-5-10-5z"></path>
                <path d="M2 17l10 5 10-5"></path>
                <path d="M2 12l10 5 10-5"></path>
            </svg>
            AI-Powered
        </div>
        <h1 class="ai-cart-title">Smart Cart Assistant</h1>
        <p class="ai-cart-subtitle">
            Your personal shopping AI that understands your preferences, manages your cart, and helps you find the perfect fragrance — all in natural conversation.
        </p>
    </div>

    <!-- Capability Pills -->
    <div class="capability-pills">
        <span class="pill">🛒 Add to Cart</span>
        <span class="pill">🔍 Find Perfumes</span>
        <span class="pill">✏️ Edit Quantities</span>
        <span class="pill">🗑️ Remove Items</span>
        <span class="pill">💡 Recommendations</span>
    </div>

    <!-- Chat Interface -->
    <div class="ai-chat-wrapper">
        <div id="chatMessages" class="chat-messages"></div>

        <div class="chat-footer">
            <form id="chatForm" class="chat-input-form" autocomplete="off">
                @Html.AntiForgeryToken()
                <div class="input-wrapper">
                    <input
                        type="text"
                        id="chatInput"
                        class="chat-input"
                        placeholder="Ask me to add a perfume, check your cart, or get recommendations..."
                        autocomplete="off"
                        required />
                    <button type="submit" class="send-btn" id="sendBtn" title="Send">
                        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                            <line x1="22" y1="2" x2="11" y2="13"></line>
                            <polygon points="22 2 15 22 11 13 2 9 22 2"></polygon>
                        </svg>
                    </button>
                </div>
            </form>
            <p class="chat-hint">Your cart is synced in real-time. Changes made here reflect immediately at checkout.</p>
        </div>
    </div>

    <!-- Cart Snapshot Panel -->
    <div id="cartPanel" class="cart-panel" style="display:none">
        <div class="cart-panel-header">
            <h3>
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <circle cx="9" cy="21" r="1"></circle>
                    <circle cx="20" cy="21" r="1"></circle>
                    <path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6"></path>
                </svg>
                Current Cart
            </h3>
            <span id="cartCount" class="cart-count-badge">0 items</span>
        </div>
        <div id="cartItems" class="cart-items-list"></div>
        <div class="cart-actions">
            <a href="/Checkout" class="btn-checkout">Proceed to Checkout →</a>
        </div>
    </div>
</div>

@section Scripts {
<script>
    const chatMessages = document.getElementById('chatMessages');
    const chatForm = document.getElementById('chatForm');
    const chatInput = document.getElementById('chatInput');
    const sendBtn = document.getElementById('sendBtn');
    const cartPanel = document.getElementById('cartPanel');
    const cartItemsEl = document.getElementById('cartItems');
    const cartCountEl = document.getElementById('cartCount');

    // Scroll chat to bottom
    function scrollToBottom() {
        chatMessages.scrollTop = chatMessages.scrollHeight;
    }

    // Escape HTML to prevent XSS
    function escapeHtml(str) {
        return String(str)
            .replace(/&/g, '&amp;')
            .replace(/</g, '&lt;')
            .replace(/>/g, '&gt;')
            .replace(/"/g, '&quot;')
            .replace(/'/g, '&#039;');
    }

    // Simple markdown formatter
    function formatMarkdown(text) {
        let html = escapeHtml(text);
        html = html.replace(/\*\*(.*?)\*\*/g, '<strong>$1</strong>');
        html = html.replace(/(?<!\*)\*(?!\*)([^*]+?)\*(?!\*)/g, '<em>$1</em>');
        html = html.replace(/\n/g, '<br>');
        return html;
    }

    // Add a message bubble to the chat
    function addMessage(text, isUser = false, isSystem = false) {
        const wrapper = document.createElement('div');
        wrapper.className = `msg-wrap ${isUser ? 'msg-user' : isSystem ? 'msg-system' : 'msg-bot'}`;

        if (!isUser && !isSystem) {
            const avatar = document.createElement('div');
            avatar.className = 'msg-avatar';
            avatar.innerHTML = `<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M12 2L2 7l10 5 10-5-10-5z"></path>
                <path d="M2 17l10 5 10-5"></path>
                <path d="M2 12l10 5 10-5"></path>
            </svg>`;
            wrapper.appendChild(avatar);
        }

        const bubble = document.createElement('div');
        bubble.className = 'msg-bubble';
        bubble.innerHTML = isSystem ? `<em>${escapeHtml(text)}</em>` : formatMarkdown(text);
        wrapper.appendChild(bubble);

        chatMessages.appendChild(wrapper);
        scrollToBottom();
    }

    // Typing indicator
    function showTyping() {
        const el = document.createElement('div');
        el.className = 'msg-wrap msg-bot';
        el.id = 'typingIndicator';
        el.innerHTML = `
            <div class="msg-avatar">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <path d="M12 2L2 7l10 5 10-5-10-5z"></path>
                    <path d="M2 17l10 5 10-5"></path>
                    <path d="M2 12l10 5 10-5"></path>
                </svg>
            </div>
            <div class="msg-bubble typing-dots">
                <span></span><span></span><span></span>
            </div>`;
        chatMessages.appendChild(el);
        scrollToBottom();
    }

    function hideTyping() {
        const el = document.getElementById('typingIndicator');
        if (el) el.remove();
    }

    // Render cart snapshot if provided
    function renderCartSnapshot(snapshot) {
        if (!snapshot || !snapshot.items || snapshot.items.length === 0) {
            cartPanel.style.display = 'none';
            return;
        }

        cartPanel.style.display = 'block';
        const count = snapshot.items.reduce((sum, i) => sum + (i.quantity || 1), 0);
        cartCountEl.textContent = `${count} item${count !== 1 ? 's' : ''}`;

        cartItemsEl.innerHTML = snapshot.items.map(item => `
            <div class="cart-item-row">
                <div class="cart-item-info">
                    <span class="cart-item-name">${escapeHtml(item.productName || item.name || 'Product')}</span>
                    <span class="cart-item-brand">${escapeHtml(item.brandName || '')}</span>
                </div>
                <div class="cart-item-meta">
                    <span class="cart-item-qty">×${item.quantity || 1}</span>
                    <span class="cart-item-price">${item.price ? '$' + parseFloat(item.price).toFixed(2) : ''}</span>
                </div>
            </div>
        `).join('');
    }

    // Submit message
    chatForm.addEventListener('submit', async (e) => {
        e.preventDefault();
        const message = chatInput.value.trim();
        if (!message) return;

        addMessage(message, true);
        chatInput.value = '';
        chatInput.disabled = true;
        sendBtn.disabled = true;
        showTyping();

        try {
            const response = await fetch('@aiCartApiUrl', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ message })
            });

            hideTyping();

            if (!response.ok) {
                if (response.status === 401) {
                    addMessage('Session expired. Please log in again.', false, true);
                } else if (response.status === 429) {
                    addMessage('Too many requests. Please wait a moment and try again.', false, true);
                } else {
                    addMessage('Sorry, something went wrong. Please try again.', false, true);
                }
                return;
            }

            const data = await response.json();

            // Handle API or orchestrator response shapes
            const answer = data.answer || data.data?.answer || data.message || 'Done!';
            addMessage(answer, false);

            // Update cart panel if snapshot provided
            const snapshot = data.cartSnapshot || data.data?.cartSnapshot;
            if (snapshot) renderCartSnapshot(snapshot);

        } catch (err) {
            hideTyping();
            addMessage('Connection error. Please check your internet and try again.', false, true);
            console.error('AI cart error:', err);
        } finally {
            chatInput.disabled = false;
            sendBtn.disabled = false;
            chatInput.focus();
        }
    });

    // Keyboard shortcut: Ctrl+Enter also sends
    chatInput.addEventListener('keydown', (e) => {
        if (e.key === 'Enter' && !e.shiftKey) {
            chatForm.dispatchEvent(new Event('submit'));
        }
    });

    // Welcome message
    addMessage(`Hello! I'm your personal AI cart assistant 🛒\n\nI can help you:\n- **Find** perfumes by scent, season, mood, or brand\n- **Add** items directly to your cart\n- **Update** quantities or **remove** items\n- **View** what's currently in your cart\n\nTry saying: *"Add 2 bottles of a woody, masculine perfume"* or *"What's in my cart?"*`, false);
    chatInput.focus();
</script>
}

<style>
    /* ── Page Header ── */
    .ai-cart-header {
        text-align: center;
        margin-bottom: 1.5rem;
    }

    .ai-cart-badge {
        display: inline-flex;
        align-items: center;
        gap: 0.4rem;
        background: linear-gradient(135deg, rgba(201, 162, 77, 0.15), rgba(201, 162, 77, 0.05));
        border: 1px solid rgba(201, 162, 77, 0.4);
        color: var(--color-accent, #c9a24d);
        padding: 0.35rem 0.9rem;
        border-radius: 20px;
        font-size: 0.78rem;
        font-weight: 600;
        letter-spacing: 0.03em;
        text-transform: uppercase;
        margin-bottom: 1rem;
    }

    .ai-cart-title {
        font-size: 2.25rem;
        font-weight: 700;
        font-family: var(--font-heading, 'Playfair Display', serif);
        color: var(--color-primary, #0b0b0b);
        margin-bottom: 0.75rem;
        letter-spacing: -0.02em;
    }

    .ai-cart-subtitle {
        font-size: 1rem;
        color: var(--text-muted, #6b7280);
        max-width: 560px;
        margin: 0 auto;
        line-height: 1.7;
    }

    /* ── Capability Pills ── */
    .capability-pills {
        display: flex;
        flex-wrap: wrap;
        justify-content: center;
        gap: 0.5rem;
        margin-bottom: 2rem;
    }

    .pill {
        background: rgba(11, 11, 11, 0.04);
        border: 1px solid rgba(11, 11, 11, 0.1);
        border-radius: 20px;
        padding: 0.3rem 0.9rem;
        font-size: 0.82rem;
        color: var(--color-primary, #0b0b0b);
        font-weight: 500;
        transition: all 0.2s ease;
    }

    .pill:hover {
        border-color: var(--color-accent, #c9a24d);
        color: var(--color-accent, #c9a24d);
    }

    /* ── Chat Wrapper ── */
    .ai-chat-wrapper {
        max-width: 860px;
        margin: 0 auto 2rem;
        background: white;
        border-radius: 16px;
        border: 1px solid rgba(11, 11, 11, 0.08);
        box-shadow: 0 8px 32px rgba(11, 11, 11, 0.07);
        overflow: hidden;
    }

    .chat-messages {
        height: 520px;
        overflow-y: auto;
        padding: 2rem;
        background: #fafafa;
        display: flex;
        flex-direction: column;
        gap: 1.25rem;
        scroll-behavior: smooth;
    }

    .chat-messages::-webkit-scrollbar { width: 5px; }
    .chat-messages::-webkit-scrollbar-track { background: transparent; }
    .chat-messages::-webkit-scrollbar-thumb { background: rgba(11,11,11,0.15); border-radius: 3px; }

    /* ── Message Bubbles ── */
    .msg-wrap {
        display: flex;
        gap: 0.75rem;
        align-items: flex-end;
        animation: slideUp 0.25s ease-out;
    }

    @@keyframes slideUp {
        from { opacity: 0; transform: translateY(8px); }
        to   { opacity: 1; transform: translateY(0); }
    }

    .msg-user {
        flex-direction: row-reverse;
    }

    .msg-system {
        justify-content: center;
    }

    .msg-avatar {
        width: 36px;
        height: 36px;
        border-radius: 50%;
        background: linear-gradient(135deg, var(--color-accent, #c9a24d), #d4a350);
        display: flex;
        align-items: center;
        justify-content: center;
        color: white;
        flex-shrink: 0;
    }

    .msg-bubble {
        max-width: 72%;
        padding: 0.875rem 1.125rem;
        border-radius: 14px;
        font-size: 0.92rem;
        line-height: 1.75;
        word-wrap: break-word;
    }

    .msg-bot .msg-bubble {
        background: white;
        color: var(--color-primary, #0b0b0b);
        border: 1px solid rgba(11, 11, 11, 0.08);
        border-bottom-left-radius: 4px;
    }

    .msg-user .msg-bubble {
        background: var(--color-primary, #0b0b0b);
        color: white;
        border-bottom-right-radius: 4px;
    }

    .msg-system .msg-bubble {
        background: rgba(201, 162, 77, 0.08);
        color: var(--color-accent, #c9a24d);
        border: 1px dashed rgba(201, 162, 77, 0.3);
        border-radius: 8px;
        font-size: 0.85rem;
        padding: 0.5rem 1rem;
        max-width: 90%;
    }

    /* Typing dots */
    .typing-dots {
        display: flex;
        gap: 4px;
        align-items: center;
        padding: 0.75rem 1rem;
    }

    .typing-dots span {
        width: 7px;
        height: 7px;
        border-radius: 50%;
        background: var(--color-accent, #c9a24d);
        animation: bounce 1.3s infinite;
    }

    .typing-dots span:nth-child(2) { animation-delay: 0.18s; }
    .typing-dots span:nth-child(3) { animation-delay: 0.36s; }

    @@keyframes bounce {
        0%, 60%, 100% { transform: translateY(0); opacity: 0.6; }
        30%            { transform: translateY(-8px); opacity: 1; }
    }

    /* ── Chat Footer ── */
    .chat-footer {
        padding: 1.25rem 1.5rem;
        background: white;
        border-top: 1px solid rgba(11, 11, 11, 0.07);
    }

    .input-wrapper {
        display: flex;
        gap: 0.75rem;
        align-items: center;
    }

    .chat-input {
        flex: 1;
        padding: 0.85rem 1.25rem;
        border: 2px solid rgba(11, 11, 11, 0.1);
        border-radius: 30px;
        font-size: 0.93rem;
        font-family: var(--font-body, sans-serif);
        transition: all 0.25s ease;
        background: #f9f9f9;
    }

    .chat-input:focus {
        outline: none;
        border-color: var(--color-accent, #c9a24d);
        background: white;
        box-shadow: 0 0 0 4px rgba(201, 162, 77, 0.1);
    }

    .chat-input:disabled {
        opacity: 0.6;
        cursor: not-allowed;
    }

    .send-btn {
        width: 46px;
        height: 46px;
        border-radius: 50%;
        border: none;
        background: linear-gradient(135deg, var(--color-primary, #0b0b0b), #2a2a2a);
        color: white;
        display: flex;
        align-items: center;
        justify-content: center;
        cursor: pointer;
        transition: all 0.25s ease;
        flex-shrink: 0;
    }

    .send-btn:hover:not(:disabled) {
        background: linear-gradient(135deg, var(--color-accent, #c9a24d), #d4a350);
        transform: scale(1.06);
        box-shadow: 0 4px 14px rgba(201, 162, 77, 0.4);
    }

    .send-btn:disabled {
        opacity: 0.45;
        cursor: not-allowed;
    }

    .chat-hint {
        margin: 0.5rem 0 0;
        font-size: 0.78rem;
        color: var(--text-muted, #9ca3af);
        text-align: center;
    }

    /* ── Cart Panel ── */
    .cart-panel {
        max-width: 860px;
        margin: 0 auto 2rem;
        background: white;
        border-radius: 14px;
        border: 1px solid rgba(201, 162, 77, 0.25);
        box-shadow: 0 4px 16px rgba(201, 162, 77, 0.08);
        overflow: hidden;
        animation: fadeIn 0.35s ease-out;
    }

    @@keyframes fadeIn {
        from { opacity: 0; transform: translateY(6px); }
        to   { opacity: 1; transform: translateY(0); }
    }

    .cart-panel-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: 1rem 1.5rem;
        border-bottom: 1px solid rgba(11, 11, 11, 0.07);
        background: linear-gradient(135deg, rgba(201, 162, 77, 0.06), transparent);
    }

    .cart-panel-header h3 {
        display: flex;
        align-items: center;
        gap: 0.5rem;
        font-size: 0.95rem;
        font-weight: 600;
        color: var(--color-primary, #0b0b0b);
        margin: 0;
    }

    .cart-count-badge {
        font-size: 0.78rem;
        font-weight: 600;
        background: var(--color-accent, #c9a24d);
        color: var(--color-primary, #0b0b0b);
        padding: 0.25rem 0.7rem;
        border-radius: 20px;
    }

    .cart-items-list {
        padding: 0.75rem 1.5rem;
    }

    .cart-item-row {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: 0.6rem 0;
        border-bottom: 1px solid rgba(11, 11, 11, 0.06);
        font-size: 0.88rem;
    }

    .cart-item-row:last-child { border-bottom: none; }

    .cart-item-info {
        display: flex;
        flex-direction: column;
        gap: 0.15rem;
    }

    .cart-item-name {
        font-weight: 600;
        color: var(--color-primary, #0b0b0b);
    }

    .cart-item-brand {
        font-size: 0.78rem;
        color: var(--text-muted, #9ca3af);
    }

    .cart-item-meta {
        display: flex;
        align-items: center;
        gap: 0.75rem;
    }

    .cart-item-qty {
        color: var(--text-muted, #6b7280);
        font-size: 0.85rem;
    }

    .cart-item-price {
        font-weight: 600;
        color: var(--color-primary, #0b0b0b);
    }

    .cart-actions {
        padding: 1rem 1.5rem;
        border-top: 1px solid rgba(11, 11, 11, 0.07);
        text-align: right;
    }

    .btn-checkout {
        display: inline-block;
        background: var(--color-primary, #0b0b0b);
        color: white;
        padding: 0.65rem 1.5rem;
        border-radius: 8px;
        text-decoration: none;
        font-size: 0.88rem;
        font-weight: 600;
        transition: all 0.25s ease;
    }

    .btn-checkout:hover {
        background: var(--color-accent, #c9a24d);
        color: var(--color-primary, #0b0b0b);
        text-decoration: none;
        transform: translateY(-1px);
        box-shadow: 0 4px 12px rgba(201, 162, 77, 0.3);
    }

    /* ── Responsive ── */
    @@media (max-width: 768px) {
        .chat-messages { height: 400px; padding: 1.25rem; }
        .msg-bubble { max-width: 85%; }
        .ai-cart-title { font-size: 1.75rem; }
        .chat-footer { padding: 1rem; }
    }
</style>
