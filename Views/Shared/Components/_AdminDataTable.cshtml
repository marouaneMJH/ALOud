@* Reusable Admin Data Table Component *@
@* Usage: @await Html.PartialAsync("Components/_AdminDataTable", Model) *@

@model dynamic

<div class="admin-table-container">
    <table class="admin-table">
        <thead>
            <tr>
                @foreach (var column in (IEnumerable<dynamic>)Model.Columns)
                {
                    <th class="@(column.Sortable ? "sortable" : "")" 
                        data-field="@column.Field"
                        style="width: @(column.Width ?? "auto")">
                        @column.Title
                        @if (column.Sortable)
                        {
                            <span class="sort-icon">↕</span>
                        }
                    </th>
                }
                <th class="actions-column">Actions</th>
            </tr>
        </thead>
        <tbody>
            @if (Model.Items != null && ((IEnumerable<object>)Model.Items).Any())
            {
                @foreach (var item in (IEnumerable<dynamic>)Model.Items)
                {
                    <tr data-id="@item.Id">
                        @foreach (var column in (IEnumerable<dynamic>)Model.Columns)
                        {
                            var value = item.GetType().GetProperty((string)column.Field)?.GetValue(item, null);
                            <td>@(value ?? "-")</td>
                        }
                        <td class="actions-cell">
                            @await Html.PartialAsync("Components/_AdminActionButtons", new { 
                                EditUrl = $"{Model.BaseUrl}/Edit/{item.Id}",
                                DeleteUrl = $"{Model.BaseUrl}/Delete/{item.Id}",
                                DetailsUrl = Model.ShowDetails ? $"{Model.BaseUrl}/Details/{item.Id}" : null,
                                ItemName = item.Name ?? "item"
                            })
                        </td>
                    </tr>
                }
            }
            else
            {
                <tr>
                    <td colspan="@(((IEnumerable<object>)Model.Columns).Count() + 1)" class="empty-state">
                        <div class="empty-message">
                            <span class="empty-icon">📭</span>
                            <p>No @(Model.EntityName ?? "items") found</p>
                        </div>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>

<style>
    .admin-table-container {
        overflow-x: auto;
        background: var(--color-white);
        border: 1px solid var(--color-border);
    }

    .admin-table {
        width: 100%;
        border-collapse: collapse;
    }

    .admin-table th,
    .admin-table td {
        padding: var(--spacing-md) var(--spacing-lg);
        text-align: left;
        border-bottom: 1px solid var(--color-border);
    }

    .admin-table th {
        background: var(--color-bg);
        font-weight: 500;
        font-size: 0.75rem;
        text-transform: uppercase;
        letter-spacing: 0.05em;
        color: var(--color-text-secondary);
    }

    .admin-table th.sortable {
        cursor: pointer;
        user-select: none;
    }

    .admin-table th.sortable:hover {
        background: var(--color-border);
    }

    .sort-icon {
        margin-left: var(--spacing-xs);
        opacity: 0.5;
    }

    .admin-table tbody tr:hover {
        background: var(--color-bg);
    }

    .admin-table td {
        font-size: 0.875rem;
        color: var(--color-text);
    }

    .actions-column {
        width: 150px;
        text-align: center;
    }

    .actions-cell {
        text-align: center;
    }

    .empty-state {
        padding: var(--spacing-2xl) !important;
        text-align: center;
    }

    .empty-message {
        color: var(--color-text-secondary);
    }

    .empty-icon {
        font-size: 2rem;
        display: block;
        margin-bottom: var(--spacing-sm);
    }
</style>
