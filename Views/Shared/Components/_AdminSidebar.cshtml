@{
    // These are optional — sidebar badges will just be hidden if not provided.
    int totalPerfumes    = ViewData.ContainsKey("TotalPerfumes")    ? (int)ViewData["TotalPerfumes"]!    : 0;
    int totalBrands      = ViewData.ContainsKey("TotalBrands")      ? (int)ViewData["TotalBrands"]!      : 0;
    int totalFamilies    = ViewData.ContainsKey("TotalFamilies")    ? (int)ViewData["TotalFamilies"]!    : 0;
    int totalNotes       = ViewData.ContainsKey("TotalNotes")       ? (int)ViewData["TotalNotes"]!       : 0;
    int totalAccords     = ViewData.ContainsKey("TotalAccords")     ? (int)ViewData["TotalAccords"]!     : 0;
    int totalTags        = ViewData.ContainsKey("TotalTags")        ? (int)ViewData["TotalTags"]!        : 0;
    int totalSeasons     = ViewData.ContainsKey("TotalSeasons")     ? (int)ViewData["TotalSeasons"]!     : 0;
    int totalOccasions   = ViewData.ContainsKey("TotalOccasions")   ? (int)ViewData["TotalOccasions"]!   : 0;

    // Each page sets this so the correct nav-link gets the "active" class.
    string activeNav = ViewData.ContainsKey("ActiveNav") ? (string)ViewData["ActiveNav"]! : "";
}

<!-- Sidebar -->
<aside class="sidebar" id="sidebar">
    <div class="sidebar-brand">
        <h2><i class="bi bi-droplet-fill"></i> ALOud</h2>
        <span>Perfume Admin Panel</span>
    </div>

    <nav>
        <!-- Overview -->
        <div class="nav-section">
            <div class="nav-section-title">Overview</div>
            <a href="@Url.Action("Index", "Admin")" class="nav-link @(activeNav == "Dashboard" ? "active" : "")">
                <i class="bi bi-grid-1x2-fill"></i>
                Dashboard
            </a>
        </div>

        <!-- Catalog -->
        <div class="nav-section">
            <div class="nav-section-title">Catalog</div>
            <a href="@Url.Action("Perfumes", "PerfumeAdmin")" class="nav-link @(activeNav == "Perfumes" ? "active" : "")">
                <i class="bi bi-droplet"></i>
                Perfumes
                @if (totalPerfumes > 0) { <span class="badge">@totalPerfumes</span> }
            </a>
            <a href="@Url.Action("Brands", "PerfumeAdmin")" class="nav-link @(activeNav == "Brands" ? "active" : "")">
                <i class="bi bi-building"></i>
                Brands
                @if (totalBrands > 0) { <span class="badge">@totalBrands</span> }
            </a>
        </div>

        <!-- Classifications -->
        <div class="nav-section">
            <div class="nav-section-title">Classifications</div>
            <a href="@Url.Action("Families", "PerfumeAdmin")" class="nav-link @(activeNav == "Families" ? "active" : "")">
                <i class="bi bi-diagram-3"></i>
                Families
                @if (totalFamilies > 0) { <span class="badge">@totalFamilies</span> }
            </a>
            <a href="@Url.Action("Notes", "PerfumeAdmin")" class="nav-link @(activeNav == "Notes" ? "active" : "")">
                <i class="bi bi-music-note-beamed"></i>
                Notes
                @if (totalNotes > 0) { <span class="badge">@totalNotes</span> }
            </a>
            <a href="@Url.Action("Accords", "PerfumeAdmin")" class="nav-link @(activeNav == "Accords" ? "active" : "")">
                <i class="bi bi-palette"></i>
                Accords
                @if (totalAccords > 0) { <span class="badge">@totalAccords</span> }
            </a>
        </div>

        <!-- Attributes -->
        <div class="nav-section">
            <div class="nav-section-title">Attributes</div>
            <a href="@Url.Action("Tags", "PerfumeAdmin")" class="nav-link @(activeNav == "Tags" ? "active" : "")">
                <i class="bi bi-tags"></i>
                Tags
                @if (totalTags > 0) { <span class="badge">@totalTags</span> }
            </a>
            <a href="@Url.Action("Seasons", "PerfumeAdmin")" class="nav-link @(activeNav == "Seasons" ? "active" : "")">
                <i class="bi bi-sun"></i>
                Seasons
                @if (totalSeasons > 0) { <span class="badge">@totalSeasons</span> }
            </a>
            <a href="@Url.Action("Occasions", "PerfumeAdmin")" class="nav-link @(activeNav == "Occasions" ? "active" : "")">
                <i class="bi bi-calendar-event"></i>
                Occasions
                @if (totalOccasions > 0) { <span class="badge">@totalOccasions</span> }
            </a>
        </div>

        <!-- Settings -->
        <div class="nav-section">
            <div class="nav-section-title">Settings</div>
            <a href="@Url.Action("LLMConfig", "Admin")" class="nav-link @(activeNav == "LLMConfig" ? "active" : "")">
                <i class="bi bi-robot"></i>
                LLM Configuration
            </a>
            <a href="@Url.Action("Index", "Home")" class="nav-link">
                <i class="bi bi-box-arrow-left"></i>
                Back to Store
            </a>
        </div>
    </nav>
</aside>