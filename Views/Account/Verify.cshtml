@{
    ViewData["Title"] = "Verify Email";
}

<div class="container mt-4" style="max-width:600px;">
    <h2>Verify your email</h2>

    <p>Please enter the verification code we sent to <strong>@ViewData["Email"]</strong>.</p>

    <form asp-route="MvcAccountVerifyPost" method="post">
        <input type="hidden" name="email" value="@ViewData["Email"]" />
        <div class="mb-3">
            <label class="form-label">Code</label>
            <input name="code" class="form-control" />
        </div>

        <button class="btn btn-primary">Verify</button>
    </form>

    <div class="mt-3">
        <a asp-route="MvcAccountLoginGet">Back to login</a>
    </div>

</div>