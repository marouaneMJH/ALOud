@model ALOud.Models.User
@{
    ViewData["Title"] = "Account Settings";
}

<section class="py-5">
    <div class="container">
        <div class="mb-5">
            <h1 class="display-3 mb-2">My Account</h1>
            <p class="lead text-muted">Manage your profile, orders, and addresses.</p>
        </div>

        <div class="row">
            <!-- Sidebar: Account Info -->
            <div class="col-lg-4 mb-4">
                <div class="card border-0 shadow-sm" style="background: var(--color-background); border-radius: 12px; overflow: hidden;">
                    <div class="card-body p-4">
                        <div class="d-flex align-items-center mb-4">
                            <div class="member-avatar me-3" style="width: 64px; height: 64px; background: var(--color-primary); color: white; border-radius: 50%; display: flex; align-items: center; justify-content: center; font-size: 1.5rem; font-weight: bold;">
                                @Model.FirstName[0]@Model.LastName[0]
                            </div>
                            <div>
                                <h4 class="mb-1">@Model.FirstName @Model.LastName</h4>
                                <p class="small text-muted mb-0">Member since @Model.CreatedAt.ToString("MMMM yyyy")</p>
                            </div>
                        </div>

                        <div class="account-details mb-4">
                            <div class="mb-3">
                                <label class="small text-muted fw-bold text-uppercase d-block mb-1">Email Address</label>
                                <div class="fw-semibold">@Model.Email</div>
                            </div>
                            <div class="mb-3">
                                <label class="small text-muted fw-bold text-uppercase d-block mb-1">Default Note</label>
                                <div class="small">@Model.Address</div>
                            </div>
                        </div>

                        <div class="d-grid gap-2">
                             <form asp-route="MvcAccountLogoutPost" method="post">
                                @Html.AntiForgeryToken()
                                <button type="submit" class="btn btn-outline-danger w-100">Sign Out</button>
                            </form>
                            <a class="btn btn-outline-secondary" asp-controller="Perfume" asp-action="Index">Back to Collection</a>
                        </div>
                    </div>
                </div>

                <!-- Navigation Sidebar (Quick Links) -->
                <div class="card border-0 shadow-sm mt-4" style="border-radius: 12px;">
                    <div class="list-group list-group-flush" id="accountTabs">
                        <a href="#orders" class="list-group-item list-group-item-action py-3 active" data-bs-toggle="list">
                            <div class="d-flex align-items-center">
                                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" class="me-3">
                                    <path d="M19 4H5c-1.1 0-2 .9-2 2v12c0 1.1.9 2 2 2h14c1.1 0 2-.9 2-2V6c0-1.1-.9-2-2-2zm0 14H5V8h14v10z" fill="currentColor"/>
                                </svg>
                                <span>Recent Orders</span>
                            </div>
                        </a>
                        <a href="#addresses" class="list-group-item list-group-item-action py-3" data-bs-toggle="list" onclick="loadAddresses()">
                            <div class="d-flex align-items-center">
                                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" class="me-3">
                                    <path d="M12 2C8.13 2 5 5.13 5 9c0 5.25 7 13 7 13s7-7.75 7-13c0-3.87-3.13-7-7-7zm0 9.5c-1.38 0-2.5-1.12-2.5-2.5s1.12-2.5 2.5-2.5 2.5 1.12 2.5 2.5-1.12 2.5-2.5 2.5z" fill="currentColor"/>
                                </svg>
                                <span>Saved Addresses</span>
                            </div>
                        </a>
                        <a href="#security" class="list-group-item list-group-item-action py-3" data-bs-toggle="list">
                            <div class="d-flex align-items-center">
                                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" class="me-3">
                                    <path d="M12 2L4 5v6.09c0 5.05 3.41 9.76 8 10.91 4.59-1.15 8-5.86 8-10.91V5l-8-3z" fill="currentColor"/>
                                </svg>
                                <span>Security Settings</span>
                            </div>
                        </a>
                    </div>
                </div>
            </div>

            <!-- Content Area -->
            <div class="col-lg-8">
                <div class="tab-content">
                    <!-- Orders Section -->
                    <div class="tab-pane fade show active" id="orders">
                        <div class="card border-0 shadow-sm p-4" style="border-radius: 12px;">
                            <div class="d-flex justify-content-between align-items-center mb-4">
                                <h3 class="mb-0">Recent Orders</h3>
                                <a asp-controller="Order" asp-action="Index" class="btn btn-sm btn-link text-decoration-none">View All</a>
                            </div>
                            
                            <div id="orderSummaryContainer">
                                <p class="text-muted">Manage your orders, tracking, and cancellations from here.</p>
                                <a asp-controller="Order" asp-action="Index" class="btn btn-primary">Go to My Orders</a>
                            </div>
                        </div>
                    </div>

                    <!-- Addresses Section -->
                    <div class="tab-pane fade" id="addresses">
                        <div class="card border-0 shadow-sm p-4" style="border-radius: 12px;">
                            <div class="d-flex justify-content-between align-items-center mb-4">
                                <h3 class="mb-0">Shipping Addresses</h3>
                                <button class="btn btn-sm btn-primary" onclick="loadAddressForm()">Add New</button>
                            </div>

                            <div id="addressFormContainer" class="mb-4" style="display:none; background: var(--color-background); padding: 1.5rem; border-radius: 8px;">
                                <!-- Address form loaded here -->
                            </div>

                            <div id="addressListContainer">
                                <div class="text-center py-5">
                                    <div class="spinner-border text-primary" role="status">
                                        <span class="visually-hidden">Loading...</span>
                                    </div>
                                </div>
                                <!-- Address cards loaded here -->
                            </div>
                        </div>
                    </div>

                    <!-- Security Section -->
                    <div class="tab-pane fade" id="security">
                        <div class="card border-0 shadow-sm p-4" style="border-radius: 12px;">
                            <h3 class="mb-4">Security</h3>
                            <div class="alert alert-light border">
                                <div class="d-flex">
                                    <div class="me-3">
                                        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" class="text-primary">
                                            <path d="M12 17a2 2 0 1 0 0-4 2 2 0 0 0 0 4z" fill="currentColor"/>
                                            <path d="M18 8h-1V6c0-2.76-2.24-5-5-5S7 3.24 7 6v2H6c-1.1 0-2 .9-2 2v10c0 1.1.9 2 2 2h12c1.1 0 2-.9 2-2V10c0-1.1-.9-2-2-2zM9 6c0-1.66 1.34-3 3-3s3 1.34 3 3v2H9V6z" fill="currentColor"/>
                                        </svg>
                                    </div>
                                    <div>
                                        <h6>Password Management</h6>
                                        <p class="small text-muted mb-2">Changing your password frequently increases account security.</p>
                                        <button class="btn btn-sm btn-outline-primary" disabled>Change Password (Coming Soon)</button>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function() {
            // Check if we should activate the addresses tab
            if (window.location.hash === '#addresses') {
                const triggerEl = document.querySelector('#accountTabs a[href="#addresses"]');
                if (triggerEl) {
                    bootstrap.Tab.getOrCreateInstance(triggerEl).show();
                    loadAddresses();
                }
            }
        });

        function loadAddresses() {
            fetch('@Url.Action("List", "Address")')
                .then(response => response.text())
                .then(html => {
                    document.getElementById('addressListContainer').innerHTML = html;
                })
                .catch(err => console.error('Error loading addresses:', err));
        }

        function loadAddressForm(id = null) {
            const url = id 
                ? '@Url.Action("Edit", "Address")/' + id 
                : '@Url.Action("Create", "Address")';

            fetch(url)
                .then(response => response.text())
                .then(html => {
                    const container = document.getElementById('addressFormContainer');
                    container.innerHTML = html;
                    container.style.display = 'block';
                    container.scrollIntoView({ behavior: 'smooth' });
                });
        }

        function hideAddressForm() {
            document.getElementById('addressFormContainer').style.display = 'none';
        }

        function submitAddressForm(event) {
            event.preventDefault();
            const form = event.target;
            const formData = new FormData(form);

            fetch(form.action || window.location.href, {
                method: 'POST',
                body: formData,
                headers: {
                    'RequestVerificationToken': document.querySelector('input[name="__RequestVerificationToken"]').value
                }
            })
            .then(response => {
                if (response.ok && response.headers.get('Content-Type')?.includes('application/json')) {
                    return response.json();
                }
                return response.text().then(html => ({ isHtml: true, html }));
            })
            .then(result => {
                if (result.isHtml) {
                    // Validation errors, reload form with errors
                    document.getElementById('addressFormContainer').innerHTML = result.html;
                } else if (result.success) {
                    // Success, hide form and reload list
                    hideAddressForm();
                    loadAddresses();
                } else {
                    alert(result.message || 'An error occurred');
                }
            })
            .catch(err => console.error('Error submitting form:', err));
        }

        function setDefaultAddress(id) {
            const formData = new FormData();
            formData.append('id', id);

            fetch('@Url.Action("SetDefault", "Address")', {
                method: 'POST',
                body: formData,
                headers: {
                    'RequestVerificationToken': document.querySelector('input[name="__RequestVerificationToken"]').value
                }
            })
            .then(response => response.json())
            .then(result => {
                if (result.success) loadAddresses();
            });
        }

        function deleteAddress(id) {
            if (!confirm('Are you sure you want to delete this address?')) return;

            const formData = new FormData();
            formData.append('id', id);

            fetch('@Url.Action("Delete", "Address")', {
                method: 'POST',
                body: formData,
                headers: {
                    'RequestVerificationToken': document.querySelector('input[name="__RequestVerificationToken"]').value
                }
            })
            .then(response => response.json())
            .then(result => {
                if (result.success) loadAddresses();
            });
        }
    </script>
}