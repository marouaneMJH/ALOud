@model ALOud.DTOs.CreateUserDto
@{
    ViewData["Title"] = "Créer un compte";
}

<!-- Auth Container -->
<section class="py-6">
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-md-8 col-lg-6">
                <!-- Header -->
                <div class="text-center mb-5">
                    <h1 class="mb-3">Créer un compte</h1>
                    <p class="text-muted">Rejoignez la communauté ALOud et découvrez nos fragrances exclusives</p>
                </div>

                <!-- Register Form -->
                <div class="auth-card">
                    <form asp-action="Register" method="post" novalidate>
                        @Html.AntiForgeryToken()
                        <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>

                        <!-- Name Fields Row -->
                        <div class="row">
                            <!-- First Name -->
                            <div class="col-md-6 mb-4">
                                <label asp-for="FirstName" class="form-label small text-uppercase" 
                                       style="color: var(--color-text-secondary); font-weight: 600; letter-spacing: 0.05em;">Prénom *</label>
                                <input asp-for="FirstName" 
                                       type="text" 
                                       class="form-control" 
                                       placeholder="Votre prénom" 
                                       autocomplete="given-name" />
                                <span asp-validation-for="FirstName" class="text-danger small"></span>
                            </div>

                            <!-- Last Name -->
                            <div class="col-md-6 mb-4">
                                <label asp-for="LastName" class="form-label small text-uppercase" 
                                       style="color: var(--color-text-secondary); font-weight: 600; letter-spacing: 0.05em;">Nom *</label>
                                <input asp-for="LastName" 
                                       type="text" 
                                       class="form-control" 
                                       placeholder="Votre nom de famille" 
                                       autocomplete="family-name" />
                                <span asp-validation-for="LastName" class="text-danger small"></span>
                            </div>
                        </div>

                        <!-- Email Field -->
                        <div class="mb-4">
                            <label asp-for="Email" class="form-label small text-uppercase" 
                                   style="color: var(--color-text-secondary); font-weight: 600; letter-spacing: 0.05em;">Email *</label>
                            <input asp-for="Email" 
                                   type="email" 
                                   class="form-control" 
                                   placeholder="votre@email.com" 
                                   autocomplete="email" />
                            <span asp-validation-for="Email" class="text-danger small"></span>
                        </div>

                        <!-- Address Field -->
                        <div class="mb-4">
                            <label asp-for="Address" class="form-label small text-uppercase" 
                                   style="color: var(--color-text-secondary); font-weight: 600; letter-spacing: 0.05em;">Adresse *</label>
                            <input asp-for="Address" 
                                   type="text" 
                                   class="form-control" 
                                   placeholder="Votre adresse complète" 
                                   autocomplete="street-address" />
                            <span asp-validation-for="Address" class="text-danger small"></span>
                        </div>

                        <!-- Password Field -->
                        <div class="mb-4">
                            <label asp-for="Password" class="form-label small text-uppercase" 
                                   style="color: var(--color-text-secondary); font-weight: 600; letter-spacing: 0.05em;">Mot de passe *</label>
                            <input asp-for="Password" 
                                   type="password" 
                                   class="form-control" 
                                   placeholder="Minimum 8 caractères" 
                                   autocomplete="new-password" />
                            <span asp-validation-for="Password" class="text-danger small"></span>
                            <div class="form-text text-muted small mt-1">
                                Votre mot de passe doit contenir au minimum 8 caractères
                            </div>
                        </div>

                        <!-- Terms & Conditions -->
                        <div class="mb-4">
                            <div class="form-check">
                                <input class="form-check-input" type="checkbox" id="termsAccepted" required>
                                <label class="form-check-label text-muted small" for="termsAccepted">
                                    J'accepte les <a href="#" class="text-decoration-none" style="color: var(--color-accent);">conditions générales</a> 
                                    et la <a asp-page="/Privacy" class="text-decoration-none" style="color: var(--color-accent);">politique de confidentialité</a>
                                </label>
                            </div>
                        </div>

                        <!-- Submit Button -->
                        <div class="mb-4">
                            <button type="submit" class="btn btn-primary w-100">
                                Créer mon compte
                            </button>
                        </div>

                        <!-- Login Link -->
                        <div class="text-center">
                            <p class="mb-0 text-muted">
                                Déjà un compte ? 
                                <a asp-action="Login" class="text-decoration-none" style="color: var(--color-accent);">Se connecter</a>
                            </p>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        // Show validation summary if there are model errors
        document.addEventListener('DOMContentLoaded', function() {
            const validationSummary = document.querySelector('[data-valmsg-summary="true"]');
            if (validationSummary && validationSummary.innerText.trim() !== '') {
                validationSummary.style.display = 'block';
            }
        });
    </script>
}
