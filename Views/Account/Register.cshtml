@model ALOud.DTOs.CreateUserDto
@{
    ViewData["Title"] = "Create an account";
    Layout = "_AuthLayout";
    ViewData["WideLayout"] = "true";
}

<!-- Auth Card -->
<div class="auth-card">
    <!-- Logo -->
    <div class="auth-logo">
        <h1>ALOud</h1>
        <p class="text-muted mb-0">Create an account</p>
    </div>
    
    <!-- Register Form -->
    <div>
                    <form asp-route="MvcAccountRegisterPost" method="post" novalidate>
                        @Html.AntiForgeryToken()
                        <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>

                        <!-- Name Fields Row -->
                        <div class="row">
                            <!-- First Name -->
                            <div class="col-md-6 mb-4">
                                <label asp-for="FirstName" class="form-label small text-uppercase" 
                                       style="color: var(--color-text-secondary); font-weight: 600; letter-spacing: 0.05em;">First Name *</label>
                                <input asp-for="FirstName" 
                                       type="text" 
                                       class="form-control" 
                                       placeholder="Your first name" 
                                       autocomplete="given-name" />
                                <span asp-validation-for="FirstName" class="text-danger small"></span>
                            </div>

                            <!-- Last Name -->
                            <div class="col-md-6 mb-4">
                                <label asp-for="LastName" class="form-label small text-uppercase" 
                                       style="color: var(--color-text-secondary); font-weight: 600; letter-spacing: 0.05em;">Last Name *</label>
                                <input asp-for="LastName" 
                                       type="text" 
                                       class="form-control" 
                                       placeholder="Your last name" 
                                       autocomplete="family-name" />
                                <span asp-validation-for="LastName" class="text-danger small"></span>
                            </div>
                        </div>

                        <!-- Email Field -->
                        <div class="mb-4">
                            <label asp-for="Email" class="form-label small text-uppercase" 
                                   style="color: var(--color-text-secondary); font-weight: 600; letter-spacing: 0.05em;">Email *</label>
                            <input asp-for="Email" 
                                   type="email" 
                                   class="form-control" 
                                   placeholder="your@email.com" 
                                   autocomplete="email" />
                            <span asp-validation-for="Email" class="text-danger small"></span>
                        </div>

                        <!-- Address Field -->
                        <div class="mb-4">
                            <label asp-for="Address" class="form-label small text-uppercase" 
                                   style="color: var(--color-text-secondary); font-weight: 600; letter-spacing: 0.05em;">Address *</label>
                            <input asp-for="Address" 
                                   type="text" 
                                   class="form-control" 
                                   placeholder="Your complete address" 
                                   autocomplete="street-address" />
                            <span asp-validation-for="Address" class="text-danger small"></span>
                        </div>

                        <!-- Password Field -->
                        <div class="mb-4">
                            <label asp-for="Password" class="form-label small text-uppercase" 
                                   style="color: var(--color-text-secondary); font-weight: 600; letter-spacing: 0.05em;">Password *</label>
                            <input asp-for="Password" 
                                   type="password" 
                                   class="form-control" 
                                   placeholder="Minimum 8 characters" 
                                   autocomplete="new-password" />
                            <span asp-validation-for="Password" class="text-danger small"></span>
                            <div class="form-text text-muted small mt-1">
                                Your password must contain:
                                <ul class="mb-0 mt-1" style="font-size: 0.875rem;">
                                    <li>At least 8 characters</li>
                                    <li>One uppercase letter (A-Z)</li>
                                    <li>One lowercase letter (a-z)</li>
                                    <li>One digit (0-9)</li>
                                    <li>One special character (@@$!%*?&)</li>
                                </ul>
                            </div>
                        </div>

                        <!-- Confirm Password Field -->
                        <div class="mb-4">
                            <label asp-for="ConfirmPassword" class="form-label small text-uppercase" 
                                   style="color: var(--color-text-secondary); font-weight: 600; letter-spacing: 0.05em;">Confirm Password *</label>
                            <input asp-for="ConfirmPassword" 
                                   type="password" 
                                   class="form-control" 
                                   placeholder="Re-enter your password" 
                                   autocomplete="new-password" />
                            <span asp-validation-for="ConfirmPassword" class="text-danger small"></span>
                        </div>

                        <!-- Terms & Conditions -->
                        <div class="mb-4">
                            <div class="form-check">
                                <input asp-for="AcceptedTerms" 
                                       class="form-check-input" 
                                       type="checkbox" 
                                       id="acceptedTerms" />
                                <label class="form-check-label text-muted small" for="acceptedTerms">
                                    I accept the <a href="#" class="text-decoration-none" style="color: var(--color-accent);">terms and conditions</a> 
                                    and the <a asp-controller="Home" asp-action="Privacy" class="text-decoration-none" style="color: var(--color-accent);">privacy policy</a> *
                                </label>
                                <span asp-validation-for="AcceptedTerms" class="text-danger small d-block mt-1"></span>
                            </div>
                            <div class="form-text text-muted small mt-2">
                                <strong>Important:</strong> You must accept the terms and conditions to create an account.
                            </div>
                        </div>

                        <!-- Submit Button -->
                        <div class="mb-4">
                            <button type="submit" class="btn btn-primary w-100">
                                Create my account
                            </button>
                        </div>

                        <!-- Login Link -->
                        <div class="text-center">
                            <p class="mb-0 text-muted">
                                Already have an account? 
                                <a asp-route="MvcAccountLoginGet" class="text-decoration-none" style="color: var(--color-accent);">Sign in</a>
                            </p>
                        </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        // Show validation summary if there are model errors
        document.addEventListener('DOMContentLoaded', function() {
            const validationSummary = document.querySelector('[data-valmsg-summary="true"]');
            if (validationSummary && validationSummary.innerText.trim() !== '') {
                validationSummary.style.display = 'block';
            }
        });
    </script>
}
