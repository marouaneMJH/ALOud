@model ALOud.DTOs.LoginDto
@{
    ViewData["Title"] = "Login";
}

<!-- Auth Container -->
<section class="py-6">
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-md-6 col-lg-5">
                <!-- Header -->
                <div class="text-center mb-5">
                    <h1 class="mb-3">Login</h1>
                    <p class="text-muted">Access your personal ALOud space</p>
                </div>

                <!-- Login Form -->
                <div class="auth-card">
                    <form asp-route="MvcAccountLoginPost" method="post" novalidate>
                        @Html.AntiForgeryToken()
                        <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>

                        <!-- Email Field -->
                        <div class="mb-4">
                            <label asp-for="Email" class="form-label small text-uppercase" 
                                   style="color: var(--color-text-secondary); font-weight: 600; letter-spacing: 0.05em;">Email</label>
                            <input asp-for="Email" 
                                   type="email" 
                                   class="form-control" 
                                   placeholder="your@email.com" 
                                   autocomplete="email" />
                            <span asp-validation-for="Email" class="text-danger small"></span>
                        </div>

                        <!-- Password Field -->
                        <div class="mb-4">
                            <label asp-for="Password" class="form-label small text-uppercase" 
                                   style="color: var(--color-text-secondary); font-weight: 600; letter-spacing: 0.05em;">Password</label>
                            <input asp-for="Password" 
                                   type="password" 
                                   class="form-control" 
                                   placeholder="Your password" 
                                   autocomplete="current-password" />
                            <span asp-validation-for="Password" class="text-danger small"></span>
                        </div>

                        <!-- Submit Button -->
                        <div class="mb-4">
                            <button type="submit" class="btn btn-primary w-100">
                                Sign in
                            </button>
                        </div>

                        <!-- Register Link -->
                        <div class="text-center">
                            <p class="mb-0 text-muted">
                                Don't have an account? 
                                <a asp-route="MvcAccountRegisterGet" class="text-decoration-none" style="color: var(--color-accent);cursor:pointer;">Create an account</a>
                            </p>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        // Show validation summary if there are model errors
        document.addEventListener('DOMContentLoaded', function() {
            const validationSummary = document.querySelector('[data-valmsg-summary="true"]');
            if (validationSummary && validationSummary.innerHTML.trim() !== '') {
                validationSummary.style.display = 'block';
            }
        });
    </script>
}
