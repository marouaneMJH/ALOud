@model List<ALOud.DTOs.AddressDto>

<div class="row row-cols-1 row-cols-md-2 g-4">
    @if (!Model.Any())
    {
        <div class="col-12 text-center py-4">
            <p class="text-muted">You haven't saved any addresses yet.</p>
        </div>
    }
    else
    {
        @foreach (var address in Model.OrderByDescending(a => a.IsDefault))
        {
            <div class="col">
                <div class="card h-100 @(address.IsDefault ? "border-primary shadow-sm" : "")" style="border: 1px solid var(--color-border);">
                    <div class="card-body">
                        <div class="d-flex justify-content-between align-items-start mb-2">
                            <div>
                                <span class="badge bg-light text-dark mb-2">@address.AddressType</span>
                                @if (address.IsDefault)
                                {
                                    <span class="badge bg-primary ms-1">Default</span>
                                }
                            </div>
                        </div>
                        
                        <h6 class="card-title fw-bold mb-1">@address.FirstName @address.LastName</h6>
                        <p class="card-text small text-muted mb-0">@address.AddressLine1</p>
                        @if (!string.IsNullOrEmpty(address.AddressLine2))
                        {
                            <p class="card-text small text-muted mb-0">@address.AddressLine2</p>
                        }
                        <p class="card-text small text-muted mb-3">@address.City, @address.State @address.PostalCode, @address.Country</p>
                        
                        @if (!string.IsNullOrEmpty(address.PhoneNumber))
                        {
                            <p class="card-text small mb-3">
                                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="me-1">
                                    <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/>
                                </svg>
                                @address.PhoneNumber
                            </p>
                        }
                    </div>
                    <div class="card-footer bg-transparent border-0 d-flex justify-content-end gap-2 pb-3">
                        @if (!address.IsDefault)
                        {
                            <button type="button" class="btn btn-sm btn-outline-primary" onclick="setDefaultAddress('@address.Id')">Set Default</button>
                        }
                        <button type="button" class="btn btn-sm btn-outline-secondary" onclick="loadAddressForm('@address.Id')">Edit</button>
                        <button type="button" class="btn btn-sm btn-outline-danger" onclick="deleteAddress('@address.Id')">Delete</button>
                    </div>
                </div>
            </div>
        }
    }
</div>
