@model List<ALOud.DTOs.AddressDto>
@{
    ViewData["Title"] = "My Addresses";
}

<div class="container py-5">
    <div class="address-page-header">
        <div>
            <h1 class="address-title">My Addresses</h1>
            <p class="address-subtitle">Manage your shipping and billing addresses</p>
        </div>
        <button class="btn-add-address" onclick="showAddForm()">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                <line x1="12" y1="5" x2="12" y2="19"></line>
                <line x1="5" y1="12" x2="19" y2="12"></line>
            </svg>
            Add Address
        </button>
    </div>

    <!-- Address Cards -->
    <div id="addressList" class="address-grid">
        @if (Model != null && Model.Any())
        {
            @foreach (var addr in Model)
            {
                <div class="address-card @(addr.IsDefault ? "default" : "")" data-id="@addr.Id">
                    @if (addr.IsDefault)
                    {
                        <span class="default-badge">Default</span>
                    }
                    <div class="address-type-badge">@(addr.AddressType ?? "Shipping")</div>
                    <h3 class="address-name">@addr.FirstName @addr.LastName</h3>
                    <p class="address-line">@addr.AddressLine1</p>
                    @if (!string.IsNullOrEmpty(addr.AddressLine2))
                    {
                        <p class="address-line">@addr.AddressLine2</p>
                    }
                    <p class="address-line">@addr.City, @addr.State @addr.PostalCode</p>
                    <p class="address-line">@addr.Country</p>
                    @if (!string.IsNullOrEmpty(addr.PhoneNumber))
                    {
                        <p class="address-phone">
                            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.127.96.361 1.903.7 2.81a2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.907.339 1.85.573 2.81.7A2 2 0 0 1 22 16.92z"></path>
                            </svg>
                            @addr.PhoneNumber
                        </p>
                    }
                    <div class="address-actions">
                        @if (!addr.IsDefault)
                        {
                            <button class="btn-address-action btn-set-default" onclick="setDefault('@addr.Id')">Set Default</button>
                        }
                        <button class="btn-address-action btn-edit" onclick="editAddress('@addr.Id')">Edit</button>
                        <button class="btn-address-action btn-delete" onclick="deleteAddress('@addr.Id')">Delete</button>
                    </div>
                </div>
            }
        }
        else
        {
            <div class="empty-state">
                <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" class="empty-icon">
                    <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"></path>
                    <circle cx="12" cy="10" r="3"></circle>
                </svg>
                <h3>No addresses yet</h3>
                <p>Add your first address to get started with ordering.</p>
                <button class="btn-add-address" onclick="showAddForm()">Add Your First Address</button>
            </div>
        }
    </div>

    <!-- Add/Edit Modal -->
    <div id="addressModal" class="modal-overlay" style="display:none">
        <div class="modal-content">
            <div class="modal-header">
                <h2 id="modalTitle">Add Address</h2>
                <button class="modal-close" onclick="closeModal()">×</button>
            </div>
            <div id="modalBody">
                <!-- Loaded via AJAX from Address/Create or Address/Edit -->
            </div>
        </div>
    </div>
</div>

@section Scripts {
<script>
    const token = document.querySelector('input[name="__RequestVerificationToken"]')?.value || '';

    function showAddForm() {
        document.getElementById('modalTitle').textContent = 'Add Address';
        fetch('/Address/Create')
            .then(r => r.text())
            .then(html => {
                document.getElementById('modalBody').innerHTML = html;
                document.getElementById('addressModal').style.display = 'flex';
            });
    }

    function editAddress(id) {
        document.getElementById('modalTitle').textContent = 'Edit Address';
        fetch('/Address/Edit/' + id)
            .then(r => r.text())
            .then(html => {
                document.getElementById('modalBody').innerHTML = html;
                document.getElementById('addressModal').style.display = 'flex';
            });
    }

    function closeModal() {
        document.getElementById('addressModal').style.display = 'none';
    }

    // Close modal on overlay click
    document.getElementById('addressModal')?.addEventListener('click', function(e) {
        if (e.target === this) closeModal();
    });

    async function setDefault(id) {
        const res = await fetch('/Address/SetDefault', {
            method: 'POST',
            headers: {
                'Content-Type': 'application/x-www-form-urlencoded',
                'RequestVerificationToken': token
            },
            body: 'id=' + id
        });
        const data = await res.json();
        if (data.success) location.reload();
        else alert('Failed to set default address');
    }

    async function deleteAddress(id) {
        if (!confirm('Are you sure you want to delete this address?')) return;
        const res = await fetch('/Address/Delete', {
            method: 'POST',
            headers: {
                'Content-Type': 'application/x-www-form-urlencoded',
                'RequestVerificationToken': token
            },
            body: 'id=' + id
        });
        const data = await res.json();
        if (data.success) location.reload();
        else alert('Failed to delete address');
    }

    // Handle form submission from modal (uses event delegation)
    document.addEventListener('submit', async function(e) {
        const form = e.target;
        if (!form.closest('#modalBody')) return;
        e.preventDefault();

        const formData = new FormData(form);
        const res = await fetch(form.action, {
            method: 'POST',
            body: formData
        });

        const contentType = res.headers.get('content-type') || '';
        if (contentType.includes('application/json')) {
            const data = await res.json();
            if (data.success) {
                closeModal();
                location.reload();
            } else {
                alert(data.message || 'Operation failed');
            }
        } else {
            // Returned a partial view (validation errors)
            const html = await res.text();
            document.getElementById('modalBody').innerHTML = html;
        }
    });
</script>
}

<style>
    .address-page-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 2rem;
        flex-wrap: wrap;
        gap: 1rem;
    }

    .address-title {
        font-size: 2rem;
        font-weight: 700;
        font-family: var(--font-heading, 'Playfair Display', serif);
        color: var(--color-primary, #0b0b0b);
        margin-bottom: 0.25rem;
    }

    .address-subtitle {
        color: var(--text-muted, #6b7280);
        font-size: 0.95rem;
        margin: 0;
    }

    .btn-add-address {
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
        background: var(--color-primary, #0b0b0b);
        color: white;
        border: none;
        padding: 0.75rem 1.5rem;
        border-radius: 8px;
        font-weight: 600;
        font-size: 0.9rem;
        cursor: pointer;
        transition: all 0.25s ease;
    }

    .btn-add-address:hover {
        background: var(--color-accent, #c9a24d);
        color: var(--color-primary, #0b0b0b);
        transform: translateY(-2px);
        box-shadow: 0 4px 14px rgba(201, 162, 77, 0.35);
    }

    .address-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(320px, 1fr));
        gap: 1.5rem;
    }

    .address-card {
        background: white;
        border: 2px solid rgba(11, 11, 11, 0.08);
        border-radius: 14px;
        padding: 1.5rem;
        position: relative;
        transition: all 0.25s ease;
    }

    .address-card:hover {
        border-color: rgba(201, 162, 77, 0.3);
        box-shadow: 0 6px 20px rgba(0, 0, 0, 0.06);
        transform: translateY(-2px);
    }

    .address-card.default {
        border-color: var(--color-accent, #c9a24d);
        background: linear-gradient(135deg, rgba(201, 162, 77, 0.03), transparent);
    }

    .default-badge {
        position: absolute;
        top: 1rem;
        right: 1rem;
        background: var(--color-accent, #c9a24d);
        color: var(--color-primary, #0b0b0b);
        font-size: 0.72rem;
        font-weight: 700;
        padding: 0.2rem 0.6rem;
        border-radius: 20px;
        text-transform: uppercase;
        letter-spacing: 0.04em;
    }

    .address-type-badge {
        font-size: 0.72rem;
        font-weight: 600;
        color: var(--text-muted, #6b7280);
        text-transform: uppercase;
        letter-spacing: 0.05em;
        margin-bottom: 0.5rem;
    }

    .address-name {
        font-size: 1.1rem;
        font-weight: 700;
        color: var(--color-primary, #0b0b0b);
        margin: 0 0 0.75rem;
    }

    .address-line {
        margin: 0 0 0.2rem;
        color: var(--color-primary, #0b0b0b);
        font-size: 0.9rem;
        line-height: 1.5;
    }

    .address-phone {
        display: flex;
        align-items: center;
        gap: 0.4rem;
        margin-top: 0.5rem;
        color: var(--text-muted, #6b7280);
        font-size: 0.85rem;
    }

    .address-actions {
        display: flex;
        gap: 0.5rem;
        margin-top: 1.25rem;
        padding-top: 1rem;
        border-top: 1px solid rgba(11, 11, 11, 0.07);
    }

    .btn-address-action {
        padding: 0.4rem 0.85rem;
        border-radius: 6px;
        font-size: 0.8rem;
        font-weight: 600;
        cursor: pointer;
        transition: all 0.2s ease;
        border: 1px solid;
    }

    .btn-set-default {
        background: transparent;
        color: var(--color-accent, #c9a24d);
        border-color: rgba(201, 162, 77, 0.4);
    }
    .btn-set-default:hover {
        background: rgba(201, 162, 77, 0.08);
        border-color: var(--color-accent, #c9a24d);
    }

    .btn-edit {
        background: transparent;
        color: var(--color-primary, #0b0b0b);
        border-color: rgba(11, 11, 11, 0.2);
    }
    .btn-edit:hover {
        background: rgba(11, 11, 11, 0.04);
        border-color: var(--color-primary, #0b0b0b);
    }

    .btn-delete {
        background: transparent;
        color: #dc2626;
        border-color: rgba(239, 68, 68, 0.3);
    }
    .btn-delete:hover {
        background: rgba(239, 68, 68, 0.06);
        border-color: #dc2626;
    }

    .empty-state {
        grid-column: 1 / -1;
        text-align: center;
        padding: 4rem 2rem;
    }

    .empty-icon {
        color: var(--color-accent, #c9a24d);
        opacity: 0.6;
        margin-bottom: 1rem;
    }

    .empty-state h3 {
        font-size: 1.25rem;
        font-weight: 700;
        color: var(--color-primary, #0b0b0b);
        margin-bottom: 0.5rem;
    }

    .empty-state p {
        color: var(--text-muted, #6b7280);
        margin-bottom: 1.5rem;
    }

    /* Modal */
    .modal-overlay {
        position: fixed;
        inset: 0;
        background: rgba(0, 0, 0, 0.5);
        backdrop-filter: blur(4px);
        display: flex;
        align-items: center;
        justify-content: center;
        z-index: 1000;
        animation: fadeIn 0.2s ease-out;
    }

    @@keyframes fadeIn {
        from { opacity: 0; }
        to { opacity: 1; }
    }

    .modal-content {
        background: white;
        border-radius: 16px;
        width: 90%;
        max-width: 560px;
        max-height: 85vh;
        overflow-y: auto;
        box-shadow: 0 20px 60px rgba(0, 0, 0, 0.2);
        animation: slideUp 0.25s ease-out;
    }

    @@keyframes slideUp {
        from { transform: translateY(20px); opacity: 0; }
        to { transform: translateY(0); opacity: 1; }
    }

    .modal-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: 1.25rem 1.5rem;
        border-bottom: 1px solid rgba(11, 11, 11, 0.08);
    }

    .modal-header h2 {
        font-size: 1.15rem;
        font-weight: 700;
        margin: 0;
        font-family: var(--font-heading, 'Playfair Display', serif);
    }

    .modal-close {
        width: 32px;
        height: 32px;
        border-radius: 50%;
        border: none;
        background: rgba(11, 11, 11, 0.06);
        font-size: 1.25rem;
        cursor: pointer;
        display: flex;
        align-items: center;
        justify-content: center;
        transition: all 0.2s ease;
    }

    .modal-close:hover {
        background: rgba(11, 11, 11, 0.12);
    }

    #modalBody {
        padding: 1.5rem;
    }

    @@media (max-width: 768px) {
        .address-grid {
            grid-template-columns: 1fr;
        }
        .address-title { font-size: 1.5rem; }
    }
</style>
