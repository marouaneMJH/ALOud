@{
    ViewData["Title"] = "Privacy Policy";
}

<section class="py-6">
    <div class="container">
        <!-- Header -->
        <div class="text-center mb-6">
            <h1 class="display-2 mb-3">Privacy Policy</h1>
            <p class="lead" style="color: var(--color-text-secondary); max-width: 600px; margin: 0 auto;">
                Your trust is precious. Discover how we protect your personal information.
            </p>
        </div>
        
        <!-- Content -->
        <div class="row justify-content-center">
            <div class="col-lg-8">
                <div class="p-5" style="background: var(--color-white); border: 1px solid var(--color-border);">
                    
                    <h2 class="h4 mb-4">Our Commitment</h2>
                    <p class="mb-5" style="color: var(--color-text-secondary); line-height: 1.7;">
                        At <strong>ALOud</strong>, we are committed to protecting your privacy and handling your personal data 
                        with the utmost care. This policy explains how we collect, use, and protect your information.
                    </p>
                    
                    <h3 class="h5 mb-3">Data Collection</h3>
                    <p class="mb-4" style="color: var(--color-text-secondary); line-height: 1.7;">
                        We only collect the information necessary to provide you with an exceptional shopping experience 
                        and to process your orders securely.
                    </p>
                    
                    <h3 class="h5 mb-3">Data Protection</h3>
                    <p class="mb-4" style="color: var(--color-text-secondary); line-height: 1.7;">
                        Your data is stored securely and is never shared with third parties without your explicit consent. 
                        We use state-of-the-art technologies to ensure the security of your information.
                    </p>
                    
                    <h3 class="h5 mb-3">Your Rights</h3>
                    <p class="mb-5" style="color: var(--color-text-secondary); line-height: 1.7;">
                        You have the right to access, modify, or delete your personal data at any time. 
                        Contact us to exercise these rights.
                    </p>
                    
                    <div class="p-4" style="background: var(--color-background); border-left: 4px solid var(--color-accent);">
                        <p class="mb-0" style="color: var(--color-text-secondary); font-style: italic;">
                            "Authenticity and transparency are at the heart of our values. Your trust guides each of our actions."
                        </p>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>
