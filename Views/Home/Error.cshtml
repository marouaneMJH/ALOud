@model ViewModels.ErrorViewModel
@{
    ViewData["Title"] = "Error";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container py-5">
    <div class="error-page">
        <div class="error-icon">
            <svg width="80" height="80" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
                <circle cx="12" cy="12" r="10"></circle>
                <line x1="12" y1="8" x2="12" y2="12"></line>
                <line x1="12" y1="16" x2="12.01" y2="16"></line>
            </svg>
        </div>

        <h1 class="error-title">Something went wrong</h1>
        <p class="error-subtitle">
            An unexpected error occurred while processing your request. Our team has been notified.
        </p>

        @if (Model?.ShowRequestId == true)
        {
            <div class="error-trace">
                <span class="trace-label">Request ID:</span>
                <code class="trace-id">@Model.RequestId</code>
            </div>
        }

        <div class="error-actions">
            <a href="@Url.Action("Index", "Perfume")" class="btn-primary-action">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"></path>
                    <polyline points="9 22 9 12 15 12 15 22"></polyline>
                </svg>
                Go to Catalog
            </a>
            <a href="javascript:history.back()" class="btn-secondary-action">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <polyline points="15 18 9 12 15 6"></polyline>
                </svg>
                Go Back
            </a>
        </div>
    </div>
</div>

<style>
    .error-page {
        max-width: 560px;
        margin: 0 auto;
        text-align: center;
        padding: 3rem 2rem;
    }

    .error-icon {
        width: 100px;
        height: 100px;
        border-radius: 50%;
        background: linear-gradient(135deg, rgba(201, 162, 77, 0.15), rgba(201, 162, 77, 0.05));
        border: 2px solid rgba(201, 162, 77, 0.3);
        display: flex;
        align-items: center;
        justify-content: center;
        margin: 0 auto 2rem;
        color: var(--color-accent, #c9a24d);
        animation: pulse-error 2s ease-in-out infinite;
    }

    @@keyframes pulse-error {
        0%, 100% { box-shadow: 0 0 0 0 rgba(201, 162, 77, 0.2); }
        50%       { box-shadow: 0 0 0 12px rgba(201, 162, 77, 0); }
    }

    .error-title {
        font-size: 2rem;
        font-weight: 700;
        font-family: var(--font-heading, 'Playfair Display', serif);
        color: var(--color-primary, #0b0b0b);
        margin-bottom: 0.75rem;
        letter-spacing: -0.02em;
    }

    .error-subtitle {
        font-size: 1rem;
        color: var(--text-muted, #6b7280);
        line-height: 1.7;
        margin-bottom: 2rem;
    }

    .error-trace {
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
        background: rgba(11, 11, 11, 0.04);
        border: 1px solid rgba(11, 11, 11, 0.08);
        border-radius: 8px;
        padding: 0.6rem 1rem;
        margin-bottom: 2.5rem;
        font-size: 0.85rem;
    }

    .trace-label {
        color: var(--text-muted, #6b7280);
        font-weight: 500;
    }

    .trace-id {
        font-family: 'SFMono-Regular', Consolas, monospace;
        color: var(--color-primary, #0b0b0b);
        font-size: 0.8rem;
        background: none;
        padding: 0;
    }

    .error-actions {
        display: flex;
        gap: 1rem;
        justify-content: center;
        flex-wrap: wrap;
    }

    .btn-primary-action {
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
        background: var(--color-primary, #0b0b0b);
        color: white;
        padding: 0.875rem 1.75rem;
        border-radius: 8px;
        text-decoration: none;
        font-weight: 600;
        font-size: 0.9rem;
        transition: all 0.25s ease;
    }

    .btn-primary-action:hover {
        background: var(--color-accent, #c9a24d);
        color: var(--color-primary, #0b0b0b);
        transform: translateY(-2px);
        box-shadow: 0 6px 20px rgba(201, 162, 77, 0.35);
        text-decoration: none;
    }

    .btn-secondary-action {
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
        background: transparent;
        color: var(--color-primary, #0b0b0b);
        padding: 0.875rem 1.75rem;
        border-radius: 8px;
        text-decoration: none;
        font-weight: 600;
        font-size: 0.9rem;
        border: 2px solid rgba(11, 11, 11, 0.15);
        transition: all 0.25s ease;
    }

    .btn-secondary-action:hover {
        border-color: var(--color-primary, #0b0b0b);
        background: rgba(11, 11, 11, 0.04);
        transform: translateY(-2px);
        text-decoration: none;
        color: var(--color-primary, #0b0b0b);
    }
</style>
