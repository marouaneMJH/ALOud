@model ViewModels.ErrorViewModel
@inject Microsoft.Extensions.Configuration.IConfiguration Configuration
@{
    ViewData["Title"] = "My Orders - Error";
    var fallback = Configuration["Images:FallbackUrl"] ?? "/images/placeholder.jpg";
}

<section class="py-5">
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-lg-8">
                <div class="card border-0 shadow-sm" style="background: var(--color-white); border: 1px solid var(--color-border) !important; border-radius: 12px;">
                    <div class="card-body p-5 text-center">
                        <h1 class="display-5 mb-3">We couldn’t load your orders</h1>
                        <p class="lead mb-4" style="color: var(--color-text-secondary);">
                            Something went wrong while loading the Order page. Please try again in a moment.
                        </p>

                        @if (Model?.ShowRequestId == true)
                        {
                            <p class="small text-muted mb-4">
                                Request ID: <strong>@Model.RequestId</strong>
                            </p>
                        }

                        <div class="d-flex justify-content-center gap-2 flex-wrap">
                            <a asp-action="Index" asp-controller="Order" class="btn btn-primary">
                                Retry Orders
                            </a>
                            <a asp-action="Index" asp-controller="Perfume" class="btn btn-outline-primary">
                                Continue Shopping
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>