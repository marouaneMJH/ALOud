@model List<ALOud.DTOs.OrderDto>
@inject Microsoft.Extensions.Configuration.IConfiguration Configuration
@{
    ViewData["Title"] = "My Orders -- Error";
    var fallback = Configuration["Images:FallbackUrl"] ?? "/images/placeholder.jpg";
}

<section class="py-5">
    <div class="container">
        <!-- Header -->
        <div class="mb-5">
            <div class="d-flex justify-content-between align-items-center">
                <div>
                    <h1 class="display-2 mb-2">My Orders</h1>
                    <p style="color: var(--color-text-secondary);">
                        Error
                    </p>
                </div>
                <div>
                    <a asp-action="Index" asp-controller="Perfume" class="btn btn-primary">
                        Continue Shopping
                    </a>
                </div>
            </div>
        </div>
    </div>
</section>